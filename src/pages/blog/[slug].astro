---
// src/pages/blog/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { blogPosts, type BlogPost } from '../../data/blogPosts';

export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const publishDate = (post as any).publishedAt || (post as any).publishDate || "2026-10-21";
const contentHtml = (post as any).content || (post as any).contentHtml || "";
const toolLabel = (post as any).primaryToolLabel || (post as any).primaryToolName || "Open Tool";
const relatedArticles = blogPosts.filter(p => ((post as any).relatedSlugs || []).includes(p.slug));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.description,
  "datePublished": publishDate,
  "dateModified": (post as any).updatedAt || publishDate,
  "author": {
    "@type": "Organization",
    "name": "PdfAndImg Editorial Team",
    "url": "https://pdfandimg.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PdfAndImg",
    "logo": {
      "@type": "ImageObject",
      "url": "https://pdfandimg.com/favicon.svg"
    }
  },
  "mainEntityOfPage": `https://pdfandimg.com/blog/${post.slug}/`
};

const faqSchema = post.faqs && post.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
} : null;
---

<Layout title={post.title} description={post.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article style="max-width: 820px; margin: 0 auto; padding: 0 24px;">
    <!-- Breadcrumb Navigation -->
    <nav style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3); margin-bottom: 24px;">
      <a href="/" style="color: var(--color-ink-2); text-decoration: none;">Home</a>
      <span> / </span>
      <a href="/blog/" style="color: var(--color-ink-2); text-decoration: none;">Blog</a>
      <span> / </span>
      <span style="color: var(--color-lime);">{post.category}</span>
    </nav>

    <header style="margin-bottom: 36px;">
      <h1 style="font-size: clamp(1.85rem, 4.5vw, 2.75rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; color: var(--color-ink); margin: 0 0 16px;">
        {post.title}
      </h1>
      <div style="display: flex; flex-wrap: wrap; gap: 16px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3);">
        <span>Published: {publishDate}</span>
        <span>·</span>
        <span>{post.readTime}</span>
        <span>·</span>
        <span>100% Client-Side Verified</span>
      </div>
    </header>

    <!-- Primary Tool Callout Banner -->
    <div
      class="panel"
      style="padding: 20px 24px; margin-bottom: 36px; border: 1px solid rgba(200,241,53,0.35); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;"
    >
      <div>
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-lime); text-transform: uppercase; font-weight: 700;">
          Instant Browser Utility
        </span>
        <p style="margin: 4px 0 0; font-size: 0.95rem; color: var(--color-ink); font-weight: 600;">
          Need to process your file right now? Use {toolLabel} (Zero Server Upload).
        </p>
      </div>
      <a href={post.primaryToolHref} class="btn-primary" style="padding: 10px 20px; font-size: 0.875rem; text-decoration: none;">
        Launch {toolLabel} →
      </a>
    </div>

    <!-- Article Body -->
    <div class="blog-prose" set:html={contentHtml} />

    <!-- FAQ Section -->
    {post.faqs && post.faqs.length > 0 && (
      <section style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--color-border);">
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-ink); margin: 0 0 24px;">
          Frequently Asked Questions
        </h2>
        <div style="display: flex; flex-direction: column; gap: 20px;">
          {post.faqs.map(faq => (
            <div class="panel" style="padding: 20px;">
              <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--color-ink); margin: 0 0 8px;">
                {faq.q}
              </h3>
              <p style="font-size: 0.925rem; color: var(--color-ink-2); line-height: 1.65; margin: 0;">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Interlinked Related Blog Posts -->
    {relatedArticles.length > 0 && (
      <section style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--color-border);">
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--color-ink); margin: 0 0 16px;">
          Related Technical Guides
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;">
          {relatedArticles.map(rel => (
            <a
              href={`/blog/${rel.slug}/`}
              class="panel"
              style="padding: 18px; text-decoration: none; display: block;"
            >
              <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-lime);">
                {rel.category}
              </span>
              <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--color-ink); margin: 6px 0 0;">
                {rel.title}
              </h3>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style is:global>
  .blog-prose {
    color: var(--color-ink-2);
    font-size: 1.025rem;
    line-height: 1.8;
  }
  .blog-prose h2 {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    margin: 36px 0 16px;
    letter-spacing: -0.02em;
  }
  .blog-prose h3 {
    color: var(--color-ink);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 28px 0 12px;
  }
  .blog-prose p {
    margin: 0 0 20px;
  }
  .blog-prose ul, .blog-prose ol {
    margin: 0 0 24px;
    padding-left: 24px;
  }
  .blog-prose li {
    margin-bottom: 10px;
  }
  .blog-prose a {
    color: var(--color-lime);
    text-decoration: underline;
  }
  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .blog-prose th, .blog-prose td {
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .blog-prose th {
    background: var(--color-surface-2);
    color: var(--color-lime);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
</style>
