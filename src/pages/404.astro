---
import Layout from '../layouts/Layout.astro';

const SEO_TITLE = "404 - Page Not Found | PDFandIMG";
---

<Layout title={SEO_TITLE}>
  <section 
    class="relative z-20 pt-20 container-stripe" 
    style="
      text-align: center; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center;
    "
  >
    <!-- Cool Visual Asset -->
    <div 
      style="
        width: 120px;
        height: 120px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border-mid);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 40px;
        position: relative;
        animation: float 6s ease-in-out infinite;
      "
    >
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <div 
        style="
          position: absolute;
          inset: -10px;
          border: 1px solid var(--color-lime);
          border-radius: 28px;
          opacity: 0.2;
          animation: pulse-ring 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        "
      ></div>
    </div>

    <h1 style="font-size: 5rem; line-height: 1; margin: 0 0 12px; color: var(--color-lime);">404</h1>
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 24px;">Page Converted into Thin Air.</h2>
    
    <p 
      style="
        color: var(--color-ink-2);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        max-width: 400px;
        margin-bottom: 48px;
        line-height: 1.6;
      "
    >
      We checked every pixel, byte, and PDF page, but couldn't find this link. It might have been converted, cropped, or compressed into non-existence.
    </p>

    <a href="/" class="btn-primary" style="padding: 16px 40px; font-size: 1rem;">
      Back to HQ
    </a>
  </section>

  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.2; }
      50% { transform: scale(1.05); opacity: 0.1; }
      100% { transform: scale(0.95); opacity: 0.2; }
    }
  </style>
</Layout>
