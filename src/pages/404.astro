---
import Layout from '../layouts/Layout.astro';

const SEO_TITLE = "404 - Page Over-Compressed | ImgShrink";
---

<Layout title={SEO_TITLE}>
  <section 
    class="relative z-20 pt-20 container-stripe" 
    style="
      text-align: center; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center;
    "
  >
    <!-- Cool Visual Asset -->
    <div 
      style="
        width: 120px;
        height: 120px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border-mid);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 40px;
        position: relative;
        animation: float 6s ease-in-out infinite;
      "
    >
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>
        <polyline points="7.5 19.79 7.5 14.6 3 12"></polyline>
        <polyline points="21 12 16.5 14.6 16.5 19.79"></polyline>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
      <div 
        style="
          position: absolute;
          inset: -10px;
          border: 1px solid var(--color-lime);
          border-radius: 28px;
          opacity: 0.2;
          animation: pulse-ring 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        "
      ></div>
    </div>

    <h1 style="font-size: 5rem; line-height: 1; margin: 0 0 12px; color: var(--color-lime);">404</h1>
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 24px;">Page Over-Compressed.</h2>
    
    <p 
      style="
        color: var(--color-ink-2);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        max-width: 400px;
        margin-bottom: 48px;
        line-height: 1.6;
      "
    >
      Our algorithm looked through every byte but couldn't find this page. It might have been reduced to 0KB or moved elsewhere.
    </p>

    <a href="/" class="btn-primary" style="padding: 16px 40px; font-size: 1rem;">
      Back to HQ
    </a>
  </section>

  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.2; }
      50% { transform: scale(1.05); opacity: 0.1; }
      100% { transform: scale(0.95); opacity: 0.2; }
    }
  </style>
</Layout>
