---
import Layout from '../layouts/Layout.astro';
import Resizer from '../components/Resizer.astro';
import SEOContentResize from '../components/SEOContentResize.astro';

const SEO_TITLE = "Create Passport Size Photo Online — Instant Cropper";
const SEO_DESC = "Convert your photos to exact passport size dimensions instantly. Perfect for US passport (600x600 px) or visa applications. 100% private.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <style is:global>
    :root {
      /* Warm Orange Theme */
      --color-lime: #ff7e33;
    }
  </style>

  <section class="relative z-20 pt-20 container-stripe">
    <div style="text-align: center; margin-bottom: 48px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 126, 51, 0.08); border: 1px solid rgba(255, 126, 51, 0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 24px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">Feature: Passport Cropper</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Passport Size <br/>
        <span style="color: var(--color-lime);">Photo Maker.</span>
      </h1>
      <p style="color: var(--color-ink-2); font-size: 1.125rem; margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        Instantly resize and crop your photos to meet official passport and visa requirements. Pre-set to US Standard 600x600 pixels.
      </p>
    </div>

    <Resizer allowMultiple={false} defaultWidth={600} defaultHeight={600} />
  </section>

  <SEOContentResize isPassport={true} />
</Layout>
