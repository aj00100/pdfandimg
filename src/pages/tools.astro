---
import Layout from '../layouts/Layout.astro';

const SEO_TITLE = "All Image Compression Tools — Precision KB Optimizers";
const SEO_DESC = "Access our complete suite of precision image compression tools. From 10KB to 1MB, our Target-Lock engine ensures perfect compliance and clarity.";

const featuredTools = [
  { name: 'Crop Image Online', short: 'Crop Image', href: '/crop-image-online', desc: 'Crop photos and signatures to exact dimensions and ratios.', accent: 'var(--color-lime)' },
  { name: 'Crop Image to Passport Size', short: 'Passport Crop', href: '/crop-image-to-passport-size', desc: 'Auto-configured tool to crop image to passport size for official portals.', accent: '#ff7e33' },
  { name: 'Reduce Image Size in KB', short: 'Reduce KB', href: '/reduce-image-size-in-kb', desc: 'General purpose KB reducer for any specific target.', accent: 'var(--color-lime)' },
  { name: 'Increase Image Size in KB', short: 'Increase KB', href: '/increase-image-size-in-kb', desc: 'Upscale images to meet minimum KB requirements.', accent: 'var(--color-lime)' },
  { name: 'Convert PNG to JPG', short: 'PNG to JPG', href: '/png-to-jpg', desc: 'Instantly convert PNG images to JPEG format with zero privacy risk.', accent: '#0088ff' },
  { name: 'Convert JPEG to PNG', short: 'JPEG to PNG', href: '/jpeg-to-png', desc: 'Convert JPG files to PNG locally without server uploads.', accent: '#0088ff' },
  { name: 'Convert HEIC to JPG', short: 'HEIC to JPG', href: '/convert-heic-to-jpg', desc: 'Convert iPhone photos to universally compatible JPG files.', accent: '#0088ff' },
  { name: 'Convert HEIC to PNG', short: 'HEIC to PNG', href: '/convert-heic-to-png', desc: 'Convert iPhone HEIC photos to lossless PNG format.', accent: '#0088ff' },
  { name: 'Convert JPG to PDF', short: 'JPG to PDF', href: '/jpg-to-pdf', desc: 'Convert your JPG images to PDF documents instantly.', accent: '#0088ff' },
  { name: 'Convert PNG to PDF', short: 'PNG to PDF', href: '/png-to-pdf', desc: 'Convert your PNG images to PDF documents instantly.', accent: '#0088ff' },
  { name: 'Convert WEBP to PDF', short: 'WEBP to PDF', href: '/webp-to-pdf', desc: 'Convert your WEBP images to PDF documents instantly.', accent: '#0088ff' },
  { name: 'Resize Image in Pixels', short: 'Pixel Resizer', href: '/resize-image-in-pixels', desc: 'Change image dimensions (width & height) to exact pixels.', accent: '#a32cf5' },
  { name: 'Resize Image Dimensions', short: 'Dimensions', href: '/resize-image-dimensions', desc: 'Resize image dimensions precisely for specific upload requirements.', accent: '#a32cf5' },
  { name: 'Passport Size Photo', short: 'Passport Maker', href: '/passport-size-photo', desc: 'Instantly crop and resize photos for official document requirements.', accent: '#ff7e33' },
];

const compressionTools = [
  { name: 'Compress to 10KB', short: '10 KB', href: '/compress-image-to-10kb', desc: 'Optimized for tiny government portal signatures.', accent: 'var(--color-ink)' },
  { name: 'Compress to 15KB', short: '15 KB', href: '/compress-image-to-15kb', desc: 'Precise lock for ultra-small avatar requirements.', accent: 'var(--color-ink)' },
  { name: 'Compress to 20KB', short: '20 KB', href: '/compress-image-to-20kb', desc: 'The standard for signature and thumbnail compliance.', accent: 'var(--color-lime)' },
  { name: 'Compress to 30KB', short: '30 KB', href: '/compress-image-to-30kb', desc: 'High-clarity lock for digital exam applications.', accent: 'var(--color-ink)' },
  { name: 'Compress to 40KB', short: '40 KB', href: '/compress-image-to-40kb', desc: 'Optimized for state-level ID and portal uploads.', accent: 'var(--color-ink)' },
  { name: 'Compress to 50KB', short: '50 KB', href: '/compress-image-to-50kb', desc: 'Perfect balance for passport and candidate photos.', accent: 'var(--color-lime)' },
  { name: 'Compress to 100KB', short: '100 KB', href: '/compress-image-to-100kb', desc: 'Web industry standard for professional profiles.', accent: 'var(--color-cyan)' },
  { name: 'Compress to 200KB', short: '200 KB', href: '/compress-image-to-200kb', desc: 'High-res transmission for academic certificates.', accent: 'var(--color-orange)' },
  { name: 'Compress to 500KB', short: '500 KB', href: '/compress-image-to-500kb', desc: 'Preserve extreme detail for archive integrity.', accent: 'var(--color-cyan)' },
  { name: 'Compress to 1MB', short: '1 MB', href: '/compress-image-to-1mb', desc: 'Professional document and photograph optimization.', accent: 'var(--color-cyan)' },
];

const pdfTools = [
  { name: 'Compress PDF to 50KB', short: 'PDF 50KB', href: '/compress-pdf-to-50kb', desc: 'Reduce PDF strictly to 50KB for strict limits.', accent: '#f43f5e' },
  { name: 'Compress PDF to 100KB', short: 'PDF 100KB', href: '/compress-pdf-to-100kb', desc: 'Reduce PDF strictly to 100KB for portals.', accent: '#f43f5e' },
  { name: 'Compress PDF to 200KB', short: 'PDF 200KB', href: '/compress-pdf-to-200kb', desc: 'Reduce PDF strictly to 200KB offline.', accent: '#f43f5e' },
  { name: 'Convert JPG to PDF 100KB', short: 'JPG PDF 100KB', href: '/convert-jpg-to-pdf-100kb', desc: 'Image to PDF locked at exactly 100KB.', accent: '#f43f5e' },
  { name: 'Convert JPG to PDF 200KB', short: 'JPG PDF 200KB', href: '/convert-jpg-to-pdf-200kb', desc: 'Image to PDF locked at exactly 200KB.', accent: '#f43f5e' },
  { name: 'Convert HEIC to PDF', short: 'HEIC to PDF', href: '/convert-heic-to-pdf', desc: 'Instantly convert iPhone HEIC photos into a PDF document.', accent: '#f43f5e' },
  { name: 'Add Images to PDF', short: 'Images to PDF', href: '/add-images-to-pdf', desc: 'Convert and merge JPG/PNG into a single PDF.', accent: '#f43f5e' },
  { name: 'Unlock PDF', short: 'Unlock PDF', href: '/unlock-pdf', desc: 'Unlock PDF files and remove restrictions entirely locally.', accent: '#f43f5e' },
  { name: 'Separate PDF Pages', short: 'Split PDF', href: '/separate-pdf-pages', desc: 'Extract specific pages from a PDF offline.', accent: '#f43f5e' },
  { name: 'Merge Multiple PDFs', short: 'Merge PDFs', href: '/merge-multiple-pdf-into-one', desc: 'Combine multiple PDF files into one instantly.', accent: '#f43f5e' },
  { name: 'Extract PDF Images', short: 'PDF to JPG', href: '/extract-images-from-pdf', desc: 'Convert PDF pages into high-res images.', accent: '#f43f5e' },
  { name: 'PDF Page Remover', short: 'Remove Pages', href: '/remove-pdf-pages', desc: 'Use our PDF Page Remover to delete specific pages securely.', accent: '#f43f5e' },
];
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Precision Tool Suite</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1.05; margin: 0 0 24px; letter-spacing: -0.04em;">
        All <span style="color: var(--color-lime);">Optimizers.</span>
      </h1>
      <p style="font-size: 1.25rem; color: var(--color-ink-2); line-height: 1.6; max-width: 600px; margin: 0 auto;">
        Our full collection of surgically calibrated image tools, powered by the Target-Lock engine.
      </p>
    </div>

    <!-- Featured Tools Grid -->
    <div style="max-width: 1000px; margin: 0 auto 64px;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--color-ink); margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border); letter-spacing: -0.02em;">Featured Tools</h2>
      <div class="tools-grid" style="margin: 0;">
        {featuredTools.map(tool => (
          <a 
            href={tool.href}
            class="panel tool-card"
            style={`--tool-accent: ${tool.accent};`}
          >
            <div class="tool-card-header">
               <h3 class="tool-card-title">
                 <span class="hide-mobile">{tool.name}</span>
                 <span class="show-mobile-only">{tool.short}</span>
               </h3>
               <svg class="tool-card-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <p class="tool-card-desc">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Compression Grid -->
    <div style="max-width: 1000px; margin: 0 auto;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--color-ink); margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border); letter-spacing: -0.02em;">Target-Lock Compressors</h2>
      <div class="tools-grid" style="margin: 0;">
        {compressionTools.map(tool => (
          <a 
            href={tool.href}
            class="panel tool-card"
            style={`--tool-accent: ${tool.accent};`}
          >
            <div class="tool-card-header">
               <h3 class="tool-card-title">
                 <span class="hide-mobile">{tool.name}</span>
                 <span class="show-mobile-only">{tool.short}</span>
               </h3>
               <svg class="tool-card-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <p class="tool-card-desc">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- PDF Tools Grid -->
    <div style="max-width: 1000px; margin: 64px auto 0;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--color-ink); margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border); letter-spacing: -0.02em;">Zero-Server PDF Suite</h2>
      <div class="tools-grid" style="margin: 0;">
        {pdfTools.map(tool => (
          <a 
            href={tool.href}
            class="panel tool-card"
            style={`--tool-accent: ${tool.accent};`}
          >
            <div class="tool-card-header">
               <h3 class="tool-card-title">
                 <span class="hide-mobile">{tool.name}</span>
                 <span class="show-mobile-only">{tool.short}</span>
               </h3>
               <svg class="tool-card-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <p class="tool-card-desc">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Footer Note -->
    <div style="max-width: 1000px; margin: 80px auto 0; padding-top: 40px; border-top: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
      <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3);">IMGSHRINK HUB V1.0.8</p>
      <a href="/" class="nav-link">← Back to Dashboard</a>
    </div>
  </section>
</Layout>

<style>
  .tools-grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .tool-card {
    padding: 32px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--color-border);
  }

  .tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hi) !important;
    background: var(--color-surface-2);
    box-shadow: 0 20px 40px -20px rgba(0,0,0,0.5);
  }

  .tool-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tool-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--tool-accent);
    margin: 0;
  }

  .tool-card-icon {
    opacity: 0.4;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .tool-card:hover .tool-card-icon {
    opacity: 1;
    transform: translateX(4px);
    color: var(--color-lime);
  }

  .tool-card-desc {
    font-size: 0.875rem;
    color: var(--color-ink-2);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .tool-card {
      padding: 16px;
      border-radius: 16px;
    }

    .tool-card-title {
      font-size: 0.9375rem;
    }

    .tool-card-desc {
      font-size: 0.75rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .tool-card-icon {
      width: 14px;
      height: 14px;
    }
  }

  @media (max-width: 400px) {
    .tools-grid {
      gap: 8px;
    }
    .tool-card {
      padding: 12px;
    }
  }
</style>
