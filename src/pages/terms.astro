---
import Layout from '../layouts/Layout.astro';

const SEO_TITLE = "Terms of Engagement — PDFandIMG Service";
---

<Layout title={SEO_TITLE}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Protocol Header centered -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(255,107,53,0.08);
          border: 1px solid rgba(255,107,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-orange);
          "
        >Legal Framework</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4rem); line-height: 1.1; margin: 0 0 24px; letter-spacing: -0.04em;">
        Terms of <br/>
        <span style="color: var(--color-orange);">Engagement.</span>
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-ink-2); line-height: 1.6; max-width: 540px; margin: 0 auto;">
        Standard operating procedures for the PDFandIMG utility. By accessing the interface, you agree to these protocols.
      </p>
    </div>

    <div style="max-width: 800px; margin: 0 auto; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 20px; overflow: hidden;">
      
      <div style="padding: 40px; border-bottom: 1px solid var(--color-border);">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
          <span style="color: var(--color-orange); font-family: var(--font-mono); font-size: 0.875rem;">01</span>
          Acceptance of Protocol
        </h3>
        <p style="color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.7; padding-left: 0 md:padding-left: 32px;">
          Usage of this tool constitutes agreement to these terms. If you do not accept the protocol, terminate access immediately.
        </p>
      </div>

      <div style="padding: 40px; border-bottom: 1px solid var(--color-border);">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
          <span style="color: var(--color-orange); font-family: var(--font-mono); font-size: 0.875rem;">02</span>
          Service Disclaimer
        </h3>
        <p style="color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.7; padding-left: 0 md:padding-left: 32px;">
          PDFandIMG provides local image optimization "as is". We make no guarantees regarding the acceptance of processed files by specific third-party government portals or application systems.
        </p>
      </div>

      <div style="padding: 40px; border-bottom: 1px solid var(--color-border);">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
          <span style="color: var(--color-orange); font-family: var(--font-mono); font-size: 0.875rem;">03</span>
          User Responsibility
        </h3>
        <p style="color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.7; padding-left: 0 md:padding-left: 32px;">
          You retain full ownership and responsibility for all images processed. The system must not be used for any illegal or unauthorized activities.
        </p>
      </div>

      <div style="padding: 40px;">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
          <span style="color: var(--color-orange); font-family: var(--font-mono); font-size: 0.875rem;">04</span>
          Limitation of Liability
        </h3>
        <p style="color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.7; padding-left: 0 md:padding-left: 32px;">
          PDFandIMG and its developers shall not be liable for any damages resulting from the use or inability to use the service.
        </p>
      </div>

    </div>

    <div style="margin-top: 80px; padding-top: 40px; border-top: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; flex-direction: column; md-flex-direction: row; gap: 16px;">
      <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3);">SYSTEM STATUS: NOMINAL</p>
      <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3);">LAST REVISION: 06.2026</p>
    </div>
  </section>
</Layout>
