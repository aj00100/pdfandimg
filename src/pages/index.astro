---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Image KB Reducer - Free Image Compressor Tool";
const SEO_DESC = "Compress images to exact KB sizes with 100% accuracy. Private, fast, and free.";
---

<Layout title={SEO_TITLE} description={SEO_DESC} showMesh={true}>
  <section class="relative z-20 pt-10 container-stripe">
    <!-- The Bridge Banner -->
    <div style="text-align: center; margin-bottom: 40px;">
      <a href="/exam-photo-resizer" style="display: inline-block; padding: 16px 32px; background: rgba(200, 241, 53, 0.1); border: 2px solid var(--color-lime); border-radius: 12px; text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease;" class="hover:-translate-y-1 hover:shadow-lg">
        <span style="display: block; font-family: var(--font-head); font-weight: 700; color: var(--color-ink); font-size: 1.2rem; margin-bottom: 4px;">
          📝 Applying for a Govt Job or Exam?
        </span>
        <span style="color: var(--color-ink-2); font-size: 1rem;">
          Click here for our Auto-Resizer for UPSC, SSC, NEET & more &rarr;
        </span>
      </a>
    </div>

    <Compressor defaultKB={50} allowMultiple={true} />
  </section>

  <!-- New Features Section -->
  <section class="relative z-20 py-24 container-stripe">
    <div style="text-align: center; margin-bottom: 48px;">
      <h2 style="font-size: 2.5rem; margin-top: 16px;">Advanced <span style="color: var(--color-lime);">Image Control.</span></h2>
    </div>

    <div class="features-grid">
      
      <!-- Exam Resizer Card -->
      <a href="/exam-photo-resizer" class="feature-card group" style="--card-accent: var(--color-lime)">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><circle cx="10" cy="13" r="2"></circle><path d="m20 17-1.09-1.09a2 2 0 0 0-2.82 0L10 22"></path></svg>
        </div>
        <div class="feature-content">
          <h3>Exam Photo Resizer</h3>
          <p>Dedicated tool to automatically resize and compress photos for UPSC, SSC, and NEET.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>
      
      <!-- Enhance Card -->
      <a href="/increase-image-size-in-kb" class="feature-card group" style="--card-accent: var(--color-lime)">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>
        </div>
        <div class="feature-content">
          <h3>KB Enhancer</h3>
          <p>Need to meet a minimum size? Upscale pixels and safely increase KB.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>

      <!-- Crop Card -->
      <a href="/crop-image-online" class="feature-card group" style="--card-accent: var(--color-lime)">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
        </div>
        <div class="feature-content">
          <h3>Crop Image Online</h3>
          <p>Frame signatures and passport photos perfectly before optimization.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>

      <!-- PDF 100KB Card -->
      <a href="/compress-pdf-to-100kb" class="feature-card group" style="--card-accent: #f43f5e">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div class="feature-content">
          <h3>PDF to 100KB</h3>
          <p>Strictly compress your PDF to 100KB for government portals securely.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>

      <!-- HEIC to JPG Card -->
      <a href="/convert-heic-to-jpg" class="feature-card group" style="--card-accent: #0088ff">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
        <div class="feature-content">
          <h3>HEIC to JPG</h3>
          <p>Convert iPhone photos to universal JPG format with absolute privacy.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>



      <!-- HEIC to PDF Card -->
      <a href="/convert-heic-to-pdf" class="feature-card group" style="--card-accent: #f43f5e">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
        </div>
        <div class="feature-content">
          <h3>HEIC to PDF</h3>
          <p>Instantly transform iPhone photos into A4 PDF documents offline.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>

      <!-- Images to PDF Card -->
      <a href="/add-images-to-pdf" class="feature-card group" style="--card-accent: #f43f5e">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
        </div>
        <div class="feature-content">
          <h3>Merge Images to PDF</h3>
          <p>Combine multiple JPG or PNG images into a single perfect PDF file.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>

      <!-- Unlock PDF Card -->
      <a href="/unlock-pdf" class="feature-card group" style="--card-accent: #f43f5e">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <div class="feature-content">
          <h3>Unlock PDF</h3>
          <p>Securely remove passwords and print restrictions locally offline.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>

    </div>

    <!-- Popular Sizes Links for SEO -->
    <div style="text-align: center; margin-top: 80px; margin-bottom: 32px;">
      <h3 style="font-size: 1.5rem; color: var(--color-ink);">Popular Exact Sizes</h3>
      <p style="color: var(--color-ink-2); font-size: 0.9375rem; margin-top: 8px;">Quick links for common government exams and portal requirements</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 800px; margin: 0 auto;">
      <a href="/compress-image-to-10kb" class="size-tag">10KB</a>
      <a href="/compress-image-to-20kb" class="size-tag">20KB</a>
      <a href="/compress-image-to-50kb" class="size-tag">50KB</a>
      <a href="/compress-image-to-100kb" class="size-tag">100KB</a>
      <a href="/compress-image-to-200kb" class="size-tag">200KB</a>
    </div>

    <!-- Popular Exam Links for SEO -->
    <div style="text-align: center; margin-top: 60px; margin-bottom: 32px;">
      <h3 style="font-size: 1.5rem; color: var(--color-ink);">Auto-Resizers for Official Portals</h3>
      <p style="color: var(--color-ink-2); font-size: 0.9375rem; margin-top: 8px;">Pre-configured dimensions for government IDs and exams</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 900px; margin: 0 auto;">
      <a href="/pan-card-photo-resizer" class="size-tag" style="border-color: rgba(200, 241, 53, 0.5);">PAN Card</a>
      <a href="/resize-a-photo-to-passport-size" class="size-tag" style="border-color: rgba(200, 241, 53, 0.5);">Passport Size</a>
      <a href="/ssc-cgl-photo-resizer" class="size-tag">SSC CGL</a>
      <a href="/ssc-cgl-signature-resizer" class="size-tag">SSC Signature</a>
      <a href="/upsc-photo-resizer" class="size-tag">UPSC</a>
      <a href="/neet-photo-resizer" class="size-tag">NEET UG</a>
      <a href="/ibps-photo-resizer" class="size-tag">IBPS Banking</a>
      <a href="/gate-photo-resizer" class="size-tag">GATE Exam</a>
    </div>
  </section>

  <SEOContent 
    targetKB="Any" 
    customTitle="PdfAndImg: The Ultimate Free Image Compressor, Exam Resizer, and PDF Tool Suite"
    uniqueContent={`
      <p class="seo-p">
        Welcome to <strong>PdfAndImg</strong>, your comprehensive free online platform for managing digital documents and photos. 
        Whether you need to <strong>compress PDF to 100KB</strong> for a government portal, <strong>crop image online</strong> for a passport application, 
        or prep your <strong>NEET UG photo upload</strong>, our complete suite of tools delivers instant, reliable results directly in your browser.
      </p>
      <p class="seo-p">
        <strong>Government Exam Photo Resizer:</strong> We understand the frustration of getting your application rejected due to incorrect file sizes. Our specialized <a href="/exam-photo-resizer" style="color: var(--color-lime); text-decoration: underline;">Exam Photo Resizer</a> comes pre-loaded with the exact dimensions and KB limits for major Indian government portals like <a href="/pan-card-photo-resizer" style="color: var(--color-ink);">PAN Card</a>, <a href="/resize-a-photo-to-passport-size" style="color: var(--color-ink);">Passport</a>, <strong>UPSC, SSC CGL, IBPS, and NEET</strong>. Just select your document type, and we'll automatically adjust pixels and compress the file size simultaneously.
      </p>
      <p class="seo-p">
        Beyond exam photo compression, we offer a massive suite of PDF utilities and image manipulators. Need to increase file size? Use our <strong>KB Enhancer</strong> tool to securely <strong>increase image size in KB</strong> without losing quality. Looking to change dimensions? You can easily <strong>resize image in pixels</strong> perfectly for social media and official applications. For documents, you can seamlessly <strong>merge multiple PDF into one</strong>, <strong>separate PDF pages</strong>, or use our secure tool to <strong>remove PDF pages</strong>. 
      </p>
      <p class="seo-p">
        Privacy is our top priority. By leveraging <strong>Client-Side Processing</strong>, PdfAndImg ensures that your sensitive 
        IDs, signatures, and personal photos are processed entirely on your device. Your data is never uploaded to external servers, 
        making our platform the most secure, fast, and private choice for all your PDF and image manipulation needs in 2026.
      </p>
    `}
  />
</Layout>

<style>
  .badge-new {
    background: rgba(200, 241, 53, 0.1);
    color: var(--color-lime);
    border: 1px solid rgba(200, 241, 53, 0.3);
    padding: 4px 12px;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .feature-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .feature-card:hover {
    border-color: var(--color-border-hi);
    transform: translateY(-4px);
    background: var(--color-surface-2);
    box-shadow: 0 20px 40px -20px rgba(0,0,0,0.5);
  }

  .feature-icon-box {
    width: 56px;
    height: 56px;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-mid);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-icon-box {
    border-color: var(--card-accent, var(--color-lime));
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
  }
  .feature-icon-box svg {
    color: var(--card-accent, var(--color-lime));
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 4px;
    color: var(--color-ink);
  }

  .feature-card p {
    font-size: 0.875rem;
    color: var(--color-ink-2);
    line-height: 1.5;
    margin: 0;
  }

  .feature-arrow {
    position: absolute;
    right: 24px;
    bottom: 24px;
    font-size: 1.25rem;
    color: var(--color-lime);
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--card-accent, var(--color-lime));
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .feature-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 20px 12px;
      gap: 12px;
      border-radius: 16px;
    }

    .feature-icon-box {
      width: 44px;
      height: 44px;
      padding: 10px;
    }

    .feature-icon-box svg {
      width: 20px;
      height: 20px;
    }

    .feature-card h3 {
      font-size: 0.9375rem;
      margin-bottom: 4px;
    }

    .feature-card p {
      font-size: 0.75rem;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .feature-arrow {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .features-grid {
      gap: 8px;
    }
    .feature-card {
      padding: 16px 8px;
    }
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.6; }
    100% { opacity: 1; }
  }
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .size-tag {
    display: block;
    padding: 10px 20px;
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: 0.9375rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-ink-2);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .size-tag:hover {
    border-color: var(--color-lime);
    color: var(--color-lime);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(200, 241, 53, 0.1);
  }
</style>
