---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Image KB Reducer - Precision Compression Tool";
const SEO_DESC = "Compress images to exact KB sizes with 100% accuracy. Private, fast, and free.";
---

<Layout title={SEO_TITLE} description={SEO_DESC} showMesh={true}>
  <!-- Tool -->
  <section class="relative z-20 pt-20 container-stripe">
    <Compressor defaultKB={50} allowMultiple={true} />
  </section>

  <!-- New Features Section -->
  <section class="relative z-20 py-24 container-stripe">
    <div style="text-align: center; margin-bottom: 48px;">
      <h2 style="font-size: 2.5rem; margin-top: 16px;">Advanced <span style="color: var(--color-lime);">Image Control.</span></h2>
    </div>

    <div class="features-grid">
      
      <!-- Enhance Card -->
      <a href="/enhance-image-size" class="feature-card group">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>
        </div>
        <div class="feature-content">
          <h3>KB Enhancer</h3>
          <p>Need to meet a minimum size? Upscale pixels and safely increase KB.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>

      <!-- Crop Card -->
      <a href="/crop-image" class="feature-card group">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
        </div>
        <div class="feature-content">
          <h3>Precision Crop</h3>
          <p>Frame signatures and passport photos perfectly before optimization.</p>
        </div>
        <div class="feature-arrow">→</div>
      </a>



    </div>
  </section>

  <SEOContent 
    targetKB="Any" 
    customTitle="ImgShrink: The Industry Standard for Precision Image Optimization"
    uniqueContent={`
      <p class="seo-p">
        ImgShrink is a high-performance <strong>micro-SaaS platform</strong> engineered to solve the "Exact-Size" problem. 
        In a digital landscape where government portals, banking systems, and educational applications demand 
        perfect compliance, ImgShrink provides a professional, serverless solution that prioritizes 
        mathematical precision and user privacy.
      </p>
      <p class="seo-p">
        Our core technology, the <strong>Target-Lock V3 Engine</strong>, utilizes recursive optimization loops to identify the 
        highest possible visual quality within a specific KB threshold. Whether you are a student preparing 
        exam forms, a professional optimizing high-resolution proofs for web transmission, or a developer 
        managing asset performance, our suite of tools delivers instant, reliable results.
      </p>
      <p class="seo-p">
        By leveraging <strong>Client-Side Computation</strong>, ImgShrink eliminates the risks associated with 
        uploading sensitive personal documents to external servers. Your data stays on your device, 
        processed at the edge using modern browser APIs, making it the most secure choice for 
        passport photos, IDs, and official digital signatures in 2026.
      </p>
    `}
  />
</Layout>

<style>
  .badge-new {
    background: rgba(200, 241, 53, 0.1);
    color: var(--color-lime);
    border: 1px solid rgba(200, 241, 53, 0.3);
    padding: 4px 12px;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .feature-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .feature-card:hover {
    border-color: var(--color-border-hi);
    transform: translateY(-4px);
    background: var(--color-surface-2);
    box-shadow: 0 20px 40px -20px rgba(0,0,0,0.5);
  }

  .feature-icon-box {
    width: 56px;
    height: 56px;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-mid);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-icon-box {
    border-color: var(--color-lime);
    box-shadow: 0 0 20px rgba(200, 241, 53, 0.1);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 4px;
    color: var(--color-ink);
  }

  .feature-card p {
    font-size: 0.875rem;
    color: var(--color-ink-2);
    line-height: 1.5;
    margin: 0;
  }

  .feature-arrow {
    position: absolute;
    right: 24px;
    bottom: 24px;
    font-size: 1.25rem;
    color: var(--color-lime);
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .feature-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 20px 12px;
      gap: 12px;
      border-radius: 16px;
    }

    .feature-icon-box {
      width: 44px;
      height: 44px;
      padding: 10px;
    }

    .feature-icon-box svg {
      width: 20px;
      height: 20px;
    }

    .feature-card h3 {
      font-size: 0.9375rem;
      margin-bottom: 4px;
    }

    .feature-card p {
      font-size: 0.75rem;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .feature-arrow {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .features-grid {
      gap: 8px;
    }
    .feature-card {
      padding: 16px 8px;
    }
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.6; }
    100% { opacity: 1; }
  }
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
