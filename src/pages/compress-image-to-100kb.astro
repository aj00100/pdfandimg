---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';
import SmartRelatedTools from '../components/SmartRelatedTools.astro';
import AdSlot from '../components/AdSlot.astro';

const pageTitle = "Compress Image to 100KB Online — Marksheets, Certificates & KYC Tool";
const pageDescription = "Compress scanned marksheets, educational certificates, Aadhaar/PAN KYC documents, and high-res photos to exact 100KB online for free. 100% private in-browser processing.";

const uniqueContent = `
  <p class="seo-p">
    While 20KB and 50KB limits govern small biometric thumbnails, the <strong>100KB file size ceiling (typically 50KB to 100KB)</strong> is the statutory benchmark for <strong>full-page scanned documents, 10th/12th board marksheets, university degree certificates, category/caste certificates (OBC-NCL, EWS, SC/ST), and Aadhaar/PAN e-KYC proofs</strong>. When you scan an A4 certificate at 300 DPI or snap a photo of your marksheet with a smartphone, the resulting JPEG easily exceeds 3.5MB—35 times larger than what government scholarship, DigiLocker-linked recruitment, and banking KYC portals permit.
  </p>
  <p class="seo-p">
    Compressing a full-page document to <strong>100KB</strong> presents a unique engineering challenge: unlike a portrait where slight background softening goes unnoticed, a marksheet contains dense 8-point typography, roll numbers, QR codes, and embossed registrar seals. If an inferior compressor aggressively downscales the resolution, the verifying officer cannot read your subject grades or certificate serial number, leading to document verification (DV) rejection. PdfAndImg's 100KB Target-Lock engine balances dimensional scaling with high-luma JPEG quantization so every printed digit and official stamp remains crystal clear at <strong>95KB–99KB</strong>.
  </p>

  <div style="overflow-x: auto; margin: 28px 0; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface-1);">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-surface-2); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--color-lime);">
          <th style="padding: 12px 16px;">Document / Attachment Type</th>
          <th style="padding: 12px 16px;">Portal / Authority Examples</th>
          <th style="padding: 12px 16px;">Mandated Size Window</th>
          <th style="padding: 12px 16px;">Recommended Output Format</th>
        </tr>
      </thead>
      <tbody style="color: var(--color-ink-2); font-family: var(--font-mono); font-size: 0.8125rem;">
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">10th / 12th Marksheets & Passing Certs</td>
          <td style="padding: 12px 16px;">State Admission Portals, NSP Scholarships</td>
          <td style="padding: 12px 16px;">50KB – 100KB</td>
          <td style="padding: 12px 16px;">JPG or PDF (100KB)</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">Caste, EWS & Domicile Certificates</td>
          <td style="padding: 12px 16px;">e-District, State PSCs, Central Counseling</td>
          <td style="padding: 12px 16px;">30KB – 100KB</td>
          <td style="padding: 12px 16px;">JPG / JPEG</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">Identity & Address Proofs (Aadhaar / Voter ID)</td>
          <td style="padding: 12px 16px;">Bank Video KYC, Demat Account, Passport Seva</td>
          <td style="padding: 12px 16px;">Under 100KB</td>
          <td style="padding: 12px 16px;">JPG / PDF</td>
        </tr>
        <tr>
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">High-Clarity Postcard & Exam Photos</td>
          <td style="padding: 12px 16px;">NEET UG (Postcard 4×6"), UPSC Civil Services</td>
          <td style="padding: 12px 16px;">50KB – 100KB / 200KB</td>
          <td style="padding: 12px 16px;">JPG (High Luma)</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h3 class="seo-h3" style="margin-top: 32px;">Best Practices for Scanning Marksheets & Certificates for 100KB Upload</h3>
  <p class="seo-p">
    To maximize text sharpness when shrinking a 4MB smartphone scan down to 100KB, place your certificate on a flat surface under even daylight and crop out all surrounding table edges or bedsheets before compressing. Every square inch of wooden table or patterned cloth wastes kilobytes that should be allocated to your certificate's text. Furthermore, if your portal requires a <strong>100KB PDF</strong> instead of a JPG image, simply select <strong>PDF</strong> in the <em>Output Format</em> dropdown above—our engine will compress the scan and wrap it into a standards-compliant PDF container under 100KB in one click.
  </p>
`;

const customFaqs = [
  {
    q: "How can I compress a scanned 10th or 12th marksheet to 100KB while keeping small text readable?",
    a: "First, crop out any background borders around the marksheet paper. Then upload the scan above with the target set to 100KB. Our Smart Scaling engine preserves sufficient pixel resolution (~1200 to 1600px on the long edge) while optimizing JPEG chroma tables—since document text relies on luminance (black-and-white contrast) rather than color saturation, your grades, roll numbers, and barcodes stay crisp at ~96KB."
  },
  {
    q: "Can I compress my certificate image and save it directly as a 100KB PDF?",
    a: "Yes! Many government portals ask for photographs in JPG (50KB) but demand educational certificates or ID proofs in PDF format under 100KB. Just change the 'Output Format' dropdown from 'Keep Original' to 'PDF' before clicking Instant Optimize, or use our dedicated Convert JPG to PDF 100KB tool."
  },
  {
    q: "Is it safe to compress my Aadhaar card, PAN card, or degree certificate on PdfAndImg?",
    a: "Completely safe. Uploading identity documents and academic certificates to cloud-based compressors exposes you to server data breaches. PdfAndImg runs 100% client-side inside your web browser using HTML5 Canvas and WebAssembly—your sensitive KYC documents never leave your device."
  },
  {
    q: "Can I bulk-compress all my admission documents to 100KB at the same time?",
    a: "Yes. You can drag and drop up to 50 scanned certificates, marksheets, and ID proofs at once. Our browser engine will lock each individual file under the 100KB ceiling in parallel batches and package them into a single ZIP archive for instant download."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div style="padding-top: 40px; padding-bottom: 80px;">
    <div style="text-align: center; max-width: 760px; margin: 0 auto 40px; padding: 0 24px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">
          Target-Lock Engine: 100KB Exact
        </span>
      </div>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.25rem, 5.5vw, 3.75rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 16px; color: var(--color-ink);">
        Compress Image to <span style="color: var(--color-lime);">100KB</span> Online
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-ink-2); max-width: 560px; margin: 0 auto; line-height: 1.65;">
        Shrink scanned marksheets, degree certificates, caste/EWS proofs, and official KYC attachments to under 100KB with sharp text legibility and zero server uploads.
      </p>
    </div>

    <Compressor defaultKB={100} hideHeader={true} allowMultiple={true} />

    <AdSlot format="horizontal" />

    <SEOContent
      targetKB={100}
      customTitle="Compressing Scanned Certificates, Marksheets & KYC Documents to 100KB"
      uniqueContent={uniqueContent}
      customFaqs={customFaqs}
    />

    <SmartRelatedTools />
  </div>
</Layout>
