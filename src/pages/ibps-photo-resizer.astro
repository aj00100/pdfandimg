---
import Layout from '../layouts/Layout.astro';
import ExamResizer from '../components/ExamResizer.astro';
---

<Layout 
  title="IBPS Photo Resizer & Signature Size Converter | Free Tool"
  description="Resize your photo to 20-50KB and signature to 10-20KB for IBPS PO, Clerk, and RRB exams. Official IBPS dimensions auto-applied."
>
  <main class="container mx-auto px-4 py-12 md:py-24" style="max-width: 1000px;">
    
    <div style="text-align: center; margin-bottom: 48px;">
      <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--color-ink); margin-bottom: 16px; letter-spacing: -0.03em; line-height: 1.1;">
        IBPS Photo <span style="color: var(--color-lime);">&</span> Signature Resizer
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-ink-2); max-width: 600px; margin: 0 auto; line-height: 1.6;">
        Instantly compress your photograph (20KB - 50KB) and signature (10KB - 20KB) exactly to the strict Institute of Banking Personnel Selection guidelines.
      </p>
    </div>

    <!-- The Exam Resizer Component -->
    <ExamResizer defaultExam="ibps" defaultType="photo" />

    <!-- SEO Content Section -->
    <article style="margin-top: 80px; padding-top: 48px; border-top: 1px solid var(--color-border); font-family: var(--font-body); line-height: 1.7; color: var(--color-ink-2);">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: var(--color-ink); margin-bottom: 24px; letter-spacing: -0.02em;">IBPS Application Image Guidelines</h2>
      
      <p style="margin-bottom: 20px;">
        When applying for banking exams like <strong>IBPS PO, Clerk, RRB, or Specialist Officer</strong>, the online application portal has very rigid image size limits. Uploading an image that is even 1KB over the limit will result in an error.
      </p>

      <div style="background: var(--color-surface-2); padding: 24px; border-radius: 12px; margin-bottom: 32px;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-ink); margin-bottom: 16px;">Official IBPS Specifications</h3>
        
        <div style="display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
          <div>
            <strong style="color: var(--color-ink); display: block; margin-bottom: 8px;">Passport Size Photograph</strong>
            <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.95rem;">
              <li style="margin-bottom: 8px;">✓ <strong>File Size:</strong> 20 KB to 50 KB</li>
              <li style="margin-bottom: 8px;">✓ <strong>Dimensions:</strong> 200 x 230 pixels</li>
              <li style="margin-bottom: 8px;">✓ <strong>Background:</strong> Light colored or white</li>
              <li>✓ <strong>Format:</strong> JPEG/JPG only</li>
            </ul>
          </div>
          <div>
            <strong style="color: var(--color-ink); display: block; margin-bottom: 8px;">Candidate Signature</strong>
            <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.95rem;">
              <li style="margin-bottom: 8px;">✓ <strong>File Size:</strong> 10 KB to 20 KB</li>
              <li style="margin-bottom: 8px;">✓ <strong>Dimensions:</strong> 140 x 60 pixels</li>
              <li style="margin-bottom: 8px;">✓ <strong>Ink:</strong> Black ink pen on white paper</li>
              <li>✓ <strong>Format:</strong> JPEG/JPG only</li>
            </ul>
          </div>
        </div>
      </div>

      <h3 style="font-size: 1.5rem; font-weight: 700; color: var(--color-ink); margin-bottom: 16px;">Important Rules for IBPS Images</h3>
      <ul style="padding-left: 20px; margin-bottom: 32px;">
        <li style="margin-bottom: 12px;"><strong>No Capital Letters:</strong> Your signature MUST NOT be in capital letters. Signatures in block letters are strictly rejected by IBPS.</li>
        <li style="margin-bottom: 12px;"><strong>Left Thumb Impression:</strong> If required, the left thumb impression should be on white paper with black or blue ink, between 20 KB and 50 KB.</li>
        <li style="margin-bottom: 12px;"><strong>Handwritten Declaration:</strong> The declaration must be written in English clearly on white paper with black ink, between 50 KB and 100 KB.</li>
      </ul>

      <div style="padding: 16px; background: rgba(163, 230, 53, 0.1); border-left: 4px solid var(--color-lime); border-radius: 4px;">
        <strong style="color: var(--color-ink);">Fast & Secure:</strong> Use the IBPS Photo Resizer tool above to instantly compress your images to the exact KB requirements without losing quality. Everything is processed locally on your device.
      </div>
    </article>

  </main>
</Layout>
