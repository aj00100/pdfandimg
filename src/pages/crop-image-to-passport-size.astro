---
import Layout from '../layouts/Layout.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Crop Image to Passport Size — Make Official Passport Photos Online";
const SEO_DESC = "Crop image to passport size instantly in your browser. Perfect for US visas, Indian passports, SSC, and UPSC. Free, private, and exact match.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Precision Tool: Passport Cropper</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Crop Image to <br/>
        <span style="color: var(--color-lime);">Passport Size.</span>
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-ink-2); line-height: 1.6; max-width: 540px; margin: 0 auto;">
        Make an exact match passport photo locally in your browser. Auto-configured for standard passport and visa portals.
      </p>
    </div>

    <!-- Cropper Container -->
    <div class="panel p-6 md:p-8" style="max-width: 860px; margin: 0 auto; width: 100%;">
       <div id="crop-interface" style="min-height: 400px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; width: 100%;">
          <!-- Upload Stage -->
          <div id="upload-stage" style="width: 100%;">
             <div 
               style="
                 width: 100%; 
                 border: 2px dashed var(--color-border-mid); 
                 border-radius: 16px; 
                 padding: 48px 24px; 
                 text-align: center;
                 background: rgba(200,241,53,0.02);
                 cursor: pointer;
                 transition: all 0.2s ease;
               "
               onclick="document.getElementById('crop-input').click()"
               onmouseover="this.style.borderColor='var(--color-lime)'; this.style.background='rgba(200,241,53,0.04)';"
               onmouseout="this.style.borderColor='var(--color-border-mid)'; this.style.background='rgba(200,241,53,0.02)';"
             >
                <div style="width: 64px; height: 64px; background: var(--color-surface-3); border: 1px solid var(--color-border); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                   <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                </div>
                <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 8px;">Select image to crop to passport size</p>
                <p style="font-size: 0.875rem; color: var(--color-ink-3); margin: 0 0 20px;">JPEG · PNG · WEBP</p>
                <button class="btn-ghost" style="font-size: 0.75rem;">Browse files</button>
                <input type="file" id="crop-input" style="display:none" accept="image/*" />
             </div>
          </div>

          <!-- Cropping Area -->
          <div id="cropping-stage" class="hidden" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
             <div style="width: 100%; display: flex; justify-content: center; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
                <span id="crop-top" style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; color: var(--color-lime); background: var(--color-surface-3); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--color-border);">Top: 0%</span>
                <span id="crop-bottom" style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; color: var(--color-lime); background: var(--color-surface-3); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--color-border);">Bottom: 100%</span>
                <span id="crop-left" style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; color: var(--color-lime); background: var(--color-surface-3); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--color-border);">Left: 0%</span>
                <span id="crop-right" style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; color: var(--color-lime); background: var(--color-surface-3); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--color-border);">Right: 100%</span>
             </div>
             <div class="checkerboard-bg" style="width: 100%; height: 55vh; min-height: 300px; max-height: 500px; overflow: hidden; border-radius: 12px; border: 1px solid var(--color-border); display: block;">
                <img id="crop-target" style="display: block; max-width: 100%; max-height: 100%; margin: 0 auto;" />
             </div>
             <div class="crop-controls" style="padding: 16px 0; width: 100%;">
                <div class="preset-group" style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; width: 100%;">
                  <button class="btn-ghost preset-btn active-preset" style="flex: 1 1 auto; min-width: 100px; border-color: var(--color-lime); color: var(--color-lime);" data-ratio="0.778">Passport</button>
                  <button class="btn-ghost preset-btn" style="flex: 1 1 auto; min-width: 100px;" data-ratio="1">UPSC / 1:1</button>
                  <button class="btn-ghost preset-btn" style="flex: 1 1 auto; min-width: 100px;" data-ratio="2.33">SSC Signature</button>
                  <button class="btn-ghost preset-btn" style="flex: 1 1 auto; min-width: 100px;" data-ratio="NaN">Free Form</button>
                </div>
                <div style="position: relative; width: 100%; margin-top: 16px;">
                  <label for="rename-input" style="display: block; font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-ink-3); margin-bottom: 6px;">Rename File (Optional)</label>
                  <input 
                    type="text" 
                    id="rename-input" 
                    placeholder="Enter custom name..." 
                    style="width: 100%; height: 40px; font-size: 0.875rem; padding: 0 12px; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: 8px; color: var(--color-ink); outline: none;"
                  />
                </div>
                <button id="apply-crop" class="btn-primary save-btn" style="width: 100%; margin-top: 12px;">Save Passport Photo</button>
             </div>
          </div>
       </div>
    </div>

    <SEOContent 
      targetKB="Passport" 
      type="crop"
      customTitle="Comprehensive Guide: How to Crop Image to Passport Size Online"
      uniqueContent={`
        <p class="seo-p">
          If you are looking to <strong>crop image to passport size</strong>, you know how frustrating it can be to get the exact dimensions required by official government portals. Whether you are applying for a US Visa, an Indian Passport, or filling out forms for UPSC and SSC, having the precise 3.5cm x 4.5cm or 2x2 inch aspect ratio is critical to avoid application rejection.
        </p>
        <p class="seo-p">
          Our specialized tool makes it incredibly easy to <strong>crop image to passport size</strong> directly in your browser. When you upload your photo, the cropper automatically locks into the standard passport aspect ratio (0.778 or 3.5x4.5). All you have to do is drag the handles to perfectly frame your face, ensuring your chin to the top of your head takes up the required 70-80% of the photograph.
        </p>
        <p class="seo-p">
          Because identity documents are highly sensitive, our tool never uploads your picture to a server. When you use PDFandIMG to <strong>crop image to passport size</strong>, the entire process runs locally on your device via the Canvas API. This guarantees 100% privacy—protecting you from identity theft while giving you a perfectly formatted photo ready for any official upload. Once cropped, you can seamlessly send it to our <a href="/reduce-image-size-in-kb" style="color: var(--color-lime);">KB reducer</a> to hit strict file size limits like 20KB or 50KB.
        </p>
      `}
    />
  </section>
</Layout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

<style>
  .crop-controls {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    width: 100%;
  }

  .preset-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .save-btn {
    width: 100%;
  }

  .checkerboard-bg {
    background-color: #f0f0f0 !important;
    background-image: 
      linear-gradient(45deg, #ffffff 25%, transparent 25%),
      linear-gradient(-45deg, #ffffff 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #ffffff 75%),
      linear-gradient(-45deg, transparent 75%, #ffffff 75%) !important;
    background-size: 20px 20px !important;
    background-position: 0 0, 0 10px, 10px -10px, -10px 0px !important;
  }

  /* Specific overrides for Cropper.js internal components */
  :global(.cropper-bg) {
    background-image: none !important;
    background-color: transparent !important;
  }

  :global(.cropper-modal) {
    background-color: #fff !important;
    opacity: 0.15 !important;
  }

  :global(.cropper-view-box) {
    outline: none !important;
    border: none !important;
    box-shadow: 0 0 10px rgba(0,0,0,0.5), inset 0 0 10px rgba(0,0,0,0.3) !important;
  }

  :global(.cropper-view-box::after) {
    content: "";
    position: absolute;
    inset: 0;
    padding: 3px;
    background: linear-gradient(45deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #9400d3);
    background-size: 400% 400%;
    animation: rainbowBorder 3s linear infinite;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    pointer-events: none;
  }

  @keyframes rainbowBorder {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  :global(.cropper-point) {
    background-color: var(--color-lime) !important;
    width: 8px !important;
    height: 8px !important;
  }

  @media (min-width: 768px) {
    .save-btn {
      width: auto;
      margin-left: auto;
    }
    .crop-controls {
      justify-content: flex-start;
    }
  }
</style>

<script is:inline>
  let cropper = null;
  let originalFilename = 'passport_photo';
  const input = document.getElementById('crop-input');
  const target = document.getElementById('crop-target');
  const uploadStage = document.getElementById('upload-stage');
  const croppingStage = document.getElementById('cropping-stage');
  const applyBtn = document.getElementById('apply-crop');

  input.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;

    originalFilename = (file.name.substring(0, file.name.lastIndexOf('.')) || file.name);
    document.getElementById('rename-input').value = originalFilename + '_passport';

    const reader = new FileReader();
    reader.onload = (event) => {
      target.src = event.target.result;
      uploadStage.classList.add('hidden');
      croppingStage.classList.remove('hidden');
      
      if (cropper) cropper.destroy();
      cropper = new Cropper(target, {
        aspectRatio: 0.778, // Passport preset by default
        viewMode: 1,
        dragMode: 'move',
        autoCropArea: 0.8,
        background: false,
        modal: true,
        guides: true,
        highlight: true,
        responsive: true,
        restore: true,
        minCropBoxWidth: 50,
        minCropBoxHeight: 50,
        crop(event) {
          try {
            const imageData = cropper.getImageData();
            if (!imageData || !imageData.naturalWidth) return;
            const w = imageData.naturalWidth;
            const h = imageData.naturalHeight;
            const leftPct = Math.max(0, Math.min(100, Math.round(100 - (event.detail.x / w) * 100)));
            const rightPct = Math.max(0, Math.min(100, Math.round(((event.detail.x + event.detail.width) / w) * 100)));
            const topPct = Math.max(0, Math.min(100, Math.round(100 - (event.detail.y / h) * 100)));
            const bottomPct = Math.max(0, Math.min(100, Math.round(((event.detail.y + event.detail.height) / h) * 100)));
            
            document.getElementById('crop-top').textContent = 'Top: ' + topPct + '%';
            document.getElementById('crop-bottom').textContent = 'Bottom: ' + bottomPct + '%';
            document.getElementById('crop-left').textContent = 'Left: ' + leftPct + '%';
            document.getElementById('crop-right').textContent = 'Right: ' + rightPct + '%';
          } catch (err) {}
        }
      });
    };
    reader.readAsDataURL(file);
  });

  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // Highlight active preset
      document.querySelectorAll('.preset-btn').forEach(b => {
        b.style.borderColor = 'transparent';
        b.style.color = 'var(--color-ink)';
      });
      btn.style.borderColor = 'var(--color-lime)';
      btn.style.color = 'var(--color-lime)';

      const ratio = parseFloat(btn.dataset.ratio);
      cropper.setAspectRatio(isNaN(ratio) ? NaN : ratio);
    });
  });

  applyBtn.addEventListener('click', () => {
    const canvas = cropper.getCroppedCanvas({ maxWidth: 2000, maxHeight: 2000 });
    canvas.toBlob((blob) => {
      const url = URL.createObjectURL(blob);
      const customName = document.getElementById('rename-input').value.trim() || 'passport_photo';
      const a = document.createElement('a');
      a.href = url;
      a.download = `${customName}.jpg`;
      a.click();
      window.location.reload(); // Reset after download
    }, 'image/jpeg', 0.95);
  });
</script>
