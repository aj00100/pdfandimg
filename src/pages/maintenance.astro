---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Site Under Maintenance" description="We are currently performing scheduled maintenance. We'll be back shortly.">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4 relative z-10 py-20">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/5 bg-[#0a0a14]/60 backdrop-blur-md mb-8 shadow-xl opacity-0 translate-y-4" style="animation: fadeUp 1s ease-out forwards;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      <span class="text-[0.65rem] uppercase tracking-[0.2em] text-gray-300 font-bold">Maintenance Break</span>
    </div>

    <h1 class="text-[3rem] md:text-[5rem] font-serif tracking-tighter mb-6 leading-tight max-w-4xl mx-auto opacity-0 translate-y-4" style="animation: fadeUp 1s ease-out 0.2s forwards;">
      <span class="text-white font-light">We're upgrading</span><br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-500 font-bold drop-shadow-[0_0_15px_rgba(234,179,8,0.3)]">The System</span>
    </h1>

    <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed mb-12 opacity-0 translate-y-4" style="animation: fadeUp 1s ease-out 0.4s forwards;">
      PdfAndImg is currently undergoing scheduled maintenance to improve performance and add new features. We will be back online shortly. Thank you for your patience!
    </p>

    <div class="flex gap-4 items-center justify-center flex-wrap opacity-0 translate-y-4" style="animation: fadeUp 1s ease-out 0.6s forwards;">
      <a href="mailto:support@pdfandimg.com" class="flex items-center gap-2 px-6 py-3 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition text-sm text-white font-medium backdrop-blur-md">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        Contact Support
      </a>
      <a href="/maintenance" class="flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-yellow-500 to-orange-500 hover:from-yellow-400 hover:to-orange-400 text-black font-semibold transition text-sm shadow-[0_0_20px_rgba(234,179,8,0.3)]">
        Refresh Status
      </a>
    </div>
  </div>

  <style>
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</Layout>
