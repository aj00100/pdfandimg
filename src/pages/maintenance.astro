---
// Pure standalone page without Layout.astro (No Navbar, No Footer)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offline for Maintenance</title>
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #050505;
        color: #e5e5e5;
        font-family: 'IBM Plex Mono', monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        text-align: center;
      }
      .container {
        max-width: 600px;
        padding: 40px;
        border: 1px dashed #333;
      }
      .icon {
        margin-bottom: 24px;
        opacity: 0.6;
      }
      h1 {
        font-size: 2rem;
        margin: 0 0 16px 0;
        font-weight: 600;
        letter-spacing: -0.05em;
      }
      p {
        font-size: 1rem;
        color: #888;
        margin: 0;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
        </svg>
      </div>
      <h1>System Offline</h1>
      <p>PdfAndImg is currently undergoing maintenance.<br/>We'll be back online shortly.</p>
    </div>
  </body>
</html>
