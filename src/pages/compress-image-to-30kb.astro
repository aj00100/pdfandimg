---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Compress Image to 30KB — Best 30KB Image Compressor Online";
const SEO_DESC = "Compress image to 30KB online for free. Our 30KB image compressor ensures high resolution and clarity while staying under the size limit.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Precision: 30KB</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Compress Image to <br/>
        <span style="color: var(--color-lime);">Exactly 30KB.</span>
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-ink-2); line-height: 1.6; max-width: 540px; margin: 0 auto;">
        Our smart engine resizes and optimizes your photo to stay perfectly under the 30KB threshold with maximum possible clarity.
      </p>
    </div>

    <!-- The Tool -->
    <Compressor defaultKB={30} hideHeader={true} />

    <SEOContent 
      targetKB="30" 
      uniqueContent={`
        <p class="seo-p">
          Applying for Railway Recruitment Board (RRB) NTPC or Group D? The strict portal requirement for photos is 20KB to 50KB, and for signatures, it's strictly <strong>30KB to 55KB</strong> (specifically 30-49KB for NTPC and 30-55KB for Group D).
        </p>
        <p class="seo-p">
          Compress your photo and signature to exactly 30KB safely. Our engine respects the precise RRB portal constraints, ensuring you hit the minimum 30KB threshold without sacrificing clarity. This prevents the "file size too small" rejection errors common on railway application forms.
        </p>
      `}
    />

    <!-- Technical Note -->
    <div style="max-width: 860px; margin: 64px auto 0; padding: 40px; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 16px;">
       <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
         Optimal 30KB Compression
       </h3>
       <p style="color: var(--color-ink-2); font-size: 0.875rem; line-height: 1.7;">
         The 30KB limit is a precise requirement for many digital forms. PdfAndImg uses a Target-Lock algorithm to find the highest quality that fits into 30KB, ensuring your file is never rejected.
       </p>
    </div>
  </section>
</Layout>
