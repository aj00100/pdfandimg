---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Compress Image to 15KB — Precise 15KB Image Compressor Online";
const SEO_DESC = "Compress image to 15KB online for free. Our precision 15KB image compressor is perfect for small signatures and thumbnail requirements.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Precision: 15KB Lock</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Compress Image to <br/>
        <span style="color: var(--color-lime);">Exactly 15KB.</span>
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-ink-2); line-height: 1.6; max-width: 540px; margin: 0 auto;">
        Surgically optimized for small data limits. Our engine finds the perfect quality balance to hit 15KB exactly.
      </p>
    </div>

    <!-- The Tool -->
    <Compressor defaultKB={15} hideHeader={true} />

    <SEOContent 
      targetKB="15" 
      uniqueContent={`
        <p class="seo-p">
          Hitting exactly 15KB is the sweet spot for <strong>SSC CGL, SSC CHSL, and IBPS PO/Clerk</strong> Signature Uploads. These portals strictly mandate signatures to be between 10KB and 20KB.
        </p>
        <p class="seo-p">
          Standard compression tools often destroy the legibility of a signature. Our 15KB optimizer is a surgical tool. PDFandIMG's Target-Lock algorithm specifically preserves high-contrast edges—ensuring your signature remains sharp and valid for official SSC or IBPS verification while safely meeting the size constraint.
        </p>
      `}
    />

    <!-- Technical Note -->
    <div style="max-width: 860px; margin: 64px auto 0; padding: 40px; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 16px;">
       <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
         Ultra-Low Size Optimization
       </h3>
       <p style="color: var(--color-ink-2); font-size: 0.875rem; line-height: 1.7;">
         The 15KB limit is often used for tiny avatar uploads and specific signature fields. PDFandIMG ensures your file remains clear and valid for any automated verification system.
       </p>
    </div>
  </section>
</Layout>
