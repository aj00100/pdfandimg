---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Compress Image to 40KB — Best 40KB Image Compressor Online";
const SEO_DESC = "Reduce image size to 40KB online for free. Our 40KB image compressor is the most precise way to resize photos for portals and ID cards.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Precision: 40KB Lock</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Compress Image to <br/>
        <span style="color: var(--color-lime);">Exactly 40KB.</span>
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-ink-2); line-height: 1.6; max-width: 540px; margin: 0 auto;">
        Engineered for specific ID requirements. Our smart engine resizes and optimizes your photo to hit 40KB with high resolution.
      </p>
    </div>

    <!-- The Tool -->
    <Compressor defaultKB={40} hideHeader={true} />

    <SEOContent 
      targetKB="40" 
      uniqueContent={`
        <p class="seo-p">The <strong>40KB image optimizer</strong> is built for reliability. Many portals have a 20KB-50KB range, making 40KB the perfect "Safe Zone" target to ensure you stay under the maximum limit.</p>
        <p class="seo-p">Our tool preserves the aspect ratio and metadata integrity, which is essential for ID card uploads and banking KYC processes.</p>
      `}
    />

    <!-- Technical Note -->
    <div style="max-width: 860px; margin: 64px auto 0; padding: 40px; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 16px;">
       <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
         ID Card Standards
       </h3>
       <p style="color: var(--color-ink-2); font-size: 0.875rem; line-height: 1.7;">
         The 40KB limit is a common requirement for state-level portal uploads and ID cards. ImgShrink uses a Target-Lock algorithm to find the highest quality that fits into 40KB, ensuring your file is never rejected for size.
       </p>
    </div>
  </section>
</Layout>
