---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

const SEO_TITLE = "Convertire P7M in PDF Online Gratis — Aprire File .p7m e Fatture Elettroniche";
const SEO_DESC = "Apri e converti file .p7m (CAdES) e fatture elettroniche XML.P7M in PDF leggibili e stampabili. 100% sicuro nel tuo browser senza caricare file su server esterni.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come aprire un file .p7m e convertirlo in PDF gratis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trascina il tuo file .pdf.p7m o .xml.p7m nel riquadro qui sopra. Il nostro motore rimuove l'involucro crittografico CAdES direttamente nel browser: se il file contiene un PDF firmato, estrae il PDF originale; se contiene una Fattura Elettronica FatturaPA (XML), genera un riepilogo PDF pronto per la stampa."
      }
    },
    {
      "@type": "Question",
      "name": "È sicuro per le fatture con Partita IVA e IBAN?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Assolutamente sì. L'estrazione avviene al 100% nella memoria locale del tuo dispositivo (Zero-Upload). Nessuna fattura, codice fiscale o dato bancario viene mai inviato a server esterni."
      }
    }
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "PdfAndImg Convertitore P7M in PDF",
  "description": "Converti e apri file .p7m firmati digitalmente e fatture elettroniche XML direttamente nel browser.",
  "featureList": ["Client-Side Processing", "Zero Server Upload", "CAdES Envelope Extraction", "FatturaPA XML to PDF"],
  "url": "https://pdfandimg.com/it/convertire-p7m-in-pdf/",
  "operatingSystem": "WebBrowser",
  "applicationCategory": "BusinessApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};
---

<Layout title={SEO_TITLE} description={SEO_DESC} lang="it">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  <div style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
    <div style="text-align: center; margin-bottom: 36px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">
          FatturaPA & CAdES (.p7m) · 100% Locale · Senza Aruba o Dike
        </span>
      </div>
      <h1 style="font-size: clamp(2.1rem, 5vw, 3.5rem); line-height: 1.08; margin: 0 0 16px; letter-spacing: -0.03em; font-weight: 800;">
        Convertire <span style="color: var(--color-lime);">P7M in PDF</span> Online
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-ink-2); max-width: 620px; margin: 0 auto; line-height: 1.6;">
        Apri qualsiasi file firmato digitalmente (<code>.pdf.p7m</code> o <code>.xml.p7m</code>) senza installare programmi pesanti. Estrai subito il PDF originale o trasforma la tua Fattura Elettronica in un PDF stampabile.
      </p>
    </div>

    <AdSlot slotId="IT_P7M_ATF" />

    <div class="panel p-5 md:p-8">
      <div id="p7m-drop-zone" class="drop-zone" style="min-height: 240px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; border-radius: 16px; cursor: pointer;">
        <input type="file" id="p7m-file-input" style="display: none;" accept=".p7m,.xml" />
        <div style="display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 28px;">
          <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div>
            <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">Trascina qui il tuo file .P7M o .XML</p>
            <p style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-ink-3); margin: 0;">Supporta .pdf.p7m, .xml.p7m (FatturaPA) e .xml · Elaborazione 100% privata</p>
          </div>
          <button id="p7m-select-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">Scegli file dal dispositivo</button>
        </div>
      </div>

      <div id="p7m-result-box" class="hidden" style="display: none; flex-direction: column; gap: 20px; margin-top: 24px;">
        <div id="p7m-invoice-preview" style="background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: 12px; padding: 20px; font-family: var(--font-mono); font-size: 0.82rem; color: var(--color-ink); line-height: 1.6; overflow-x: auto;"></div>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
          <a id="p7m-download-pdf" href="#" class="btn-download" style="flex: 1; min-width: 240px; height: 56px; font-size: 1rem; display: inline-flex; align-items: center; justify-content: center;">
            Scarica PDF Leggibile
          </a>
          <button id="p7m-reset-btn" class="btn-ghost" type="button" style="height: 56px; padding: 0 24px;">
            ← Apri un altro file P7M
          </button>
        </div>
      </div>
    </div>

    <section style="margin-top: 64px; color: var(--color-ink-2); line-height: 1.8;">
      <h2 style="color: var(--color-ink); font-size: 1.75rem; font-weight: 800; margin-bottom: 16px;">Come funziona l'estrattore P7M senza software esterno</h2>
      <p>
        I file con estensione <strong>.p7m</strong> utilizzano lo standard crittografico <em>CMS / PKCS#7 (CAdES)</em>, obbligatorio in Italia per gli atti telematici (Processo Civile Telematico) e per le Fatture Elettroniche inviate tramite il Sistema di Interscambio (SdI) dell'Agenzia delle Entrate. Spesso su Mac, iPhone, Android o Windows 11 questi file risultano illeggibili se non si installano suite pesanti come Dike GoSign o Aruba Sign.
      </p>
      <p>
        Il nostro convertitore analizza la struttura binaria <code>ASN.1 DER</code> direttamente nella RAM del tuo browser:
      </p>
      <ul style="padding-left: 20px;">
        <li><strong>File <code>.pdf.p7m</code> (Contratti, Atti Giudiziari, Visure):</strong> Il tool individua l'intestazione binaria <code>%PDF-1.</code> fino al marcatore finale <code>%%EOF</code>, rimuovendo i blocchi ASN.1 esterni e restituendo il PDF nativo integro.</li>
        <li><strong>File <code>.xml.p7m</code> (Fattura Elettronica FatturaPA):</strong> Il tool decodifica il payload XML, riassembla eventuali blocchi frammentati (<em>constructed OCTET STRING</em>) e impagina Cedente, Cessionario, Partita IVA, linee di dettaglio, aliquote IVA e totale documento in un PDF pulito pronto da stampare o inviare al commercialista.</li>
      </ul>
    </section>
  </div>
</Layout>

<script>
  import { jsPDF } from 'jspdf';

  const dropZone = document.getElementById('p7m-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('p7m-file-input') as HTMLInputElement;
  const selectBtn = document.getElementById('p7m-select-btn') as HTMLButtonElement;
  const resultBox = document.getElementById('p7m-result-box') as HTMLDivElement;
  const previewEl = document.getElementById('p7m-invoice-preview') as HTMLDivElement;
  const downloadBtn = document.getElementById('p7m-download-pdf') as HTMLAnchorElement;
  const resetBtn = document.getElementById('p7m-reset-btn') as HTMLButtonElement;
  const blobUrls: string[] = [];

  const escapeHTML = (s: string) => String(s || '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] || m));

  if (selectBtn) {
    selectBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
  }

  dropZone.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('button')) fileInput.click();
  });
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('active'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('active'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault(); dropZone.classList.remove('active');
    if (e.dataTransfer?.files?.[0]) processP7m(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', (e: any) => {
    if (e.target.files?.[0]) processP7m(e.target.files[0]);
  });

  function findSubarray(haystack: Uint8Array, needle: number[], fromEnd = false): number {
    if (!fromEnd) {
      for (let i = 0; i <= haystack.length - needle.length; i++) {
        let ok = true;
        for (let j = 0; j < needle.length; j++) {
          if (haystack[i + j] !== needle[j]) { ok = false; break; }
        }
        if (ok) return i;
      }
      return -1;
    } else {
      for (let i = haystack.length - needle.length; i >= 0; i--) {
        let ok = true;
        for (let j = 0; j < needle.length; j++) {
          if (haystack[i + j] !== needle[j]) { ok = false; break; }
        }
        if (ok) return i;
      }
      return -1;
    }
  }

  function extractCleanXmlFromP7m(bytes: Uint8Array): string | null {
    // Decode as UTF-8 and locate XML root tags (<p:FatturaElettronica or <FatturaElettronica or <?xml)
    const rawStr = new TextDecoder('utf-8', { fatal: false }).decode(bytes);
    const startMatch = rawStr.match(/<\?xml|<([a-zA-Z0-9]+:)?FatturaElettronica/);
    const endMatch = rawStr.match(/<\/([a-zA-Z0-9]+:)?FatturaElettronica>/);
    if (!startMatch || startMatch.index === undefined || !endMatch || endMatch.index === undefined) {
      return null;
    }
    const endIdx = endMatch.index + endMatch[0].length;
    let xmlSlice = rawStr.slice(startMatch.index, endIdx);
    // Strip binary ASN.1 OCTET STRING chunk headers (0x04 + length bytes) that sometimes interleave >1KB chunks
    xmlSlice = xmlSlice.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g, '');
    return xmlSlice;
  }

  async function processP7m(file: File) {
    blobUrls.forEach(u => URL.revokeObjectURL(u));
    blobUrls.length = 0;

    let buf = new Uint8Array(await file.arrayBuffer());
    const cleanBaseName = file.name.replace(/\.p7m$/i, '').replace(/\.(pdf|xml)$/i, '');

    // Check if the P7M is Base64-encoded PEM/SMIME
    const headAscii = new TextDecoder('ascii').decode(buf.slice(0, 64)).trim();
    if (headAscii.startsWith('MII') || headAscii.startsWith('-----BEGIN')) {
      try {
        const b64Clean = new TextDecoder('ascii').decode(buf)
          .replace(/-----BEGIN[^-]+-----/g, '')
          .replace(/-----END[^-]+-----/g, '')
          .replace(/\s+/g, '');
        const binStr = atob(b64Clean);
        const decoded = new Uint8Array(binStr.length);
        for (let i = 0; i < binStr.length; i++) decoded[i] = binStr.charCodeAt(i);
        buf = decoded;
      } catch {}
    }

    // Case 1: Embedded PDF (%PDF- ... %%EOF)
    const pdfStart = findSubarray(buf, [0x25, 0x50, 0x44, 0x46, 0x2D]); // "%PDF-"
    const pdfEnd = findSubarray(buf, [0x25, 0x25, 0x45, 0x4F, 0x46], true); // "%%EOF"
    if (pdfStart !== -1 && pdfEnd !== -1 && pdfEnd > pdfStart) {
      const pdfBytes = buf.slice(pdfStart, pdfEnd + 6);
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      blobUrls.push(url);

      previewEl.innerHTML = `
        <div style="color: var(--color-lime); font-weight: 700; margin-bottom: 6px;">✓ Documento PDF nativo estratto dalla busta CAdES (.p7m)</div>
        <div><strong>File originale:</strong> ${escapeHTML(file.name)}</div>
        <div><strong>Dimensione PDF estratto:</strong> ${(pdfBytes.byteLength / 1024).toFixed(1)} KB</div>
      `;
      downloadBtn.href = url;
      downloadBtn.download = `${cleanBaseName}.pdf`;
      resultBox.classList.remove('hidden');
      resultBox.style.display = 'flex';
      return;
    }

    // Case 2: Embedded FatturaPA XML
    const xmlStr = extractCleanXmlFromP7m(buf);
    if (xmlStr) {
      const parser = new DOMParser();
      const xmlDoc = parser.parseFromString(xmlStr, 'text/xml');
      const getText = (tag: string, parent: Document | Element = xmlDoc) =>
        parent.getElementsByTagName(tag)[0]?.textContent?.trim() || '—';

      const cedenteNode = xmlDoc.getElementsByTagName('CedentePrestatore')[0];
      const cessionarioNode = xmlDoc.getElementsByTagName('CessionarioCommittente')[0];
      const datiGenNode = xmlDoc.getElementsByTagName('DatiGeneraliDocumento')[0];

      const fornitore = cedenteNode ? (getText('Denominazione', cedenteNode) !== '—' ? getText('Denominazione', cedenteNode) : `${getText('Nome', cedenteNode)} ${getText('Cognome', cedenteNode)}`) : '—';
      const pivaFornitore = cedenteNode ? getText('IdCodice', cedenteNode) : '—';
      const cliente = cessionarioNode ? (getText('Denominazione', cessionarioNode) !== '—' ? getText('Denominazione', cessionarioNode) : `${getText('Nome', cessionarioNode)} ${getText('Cognome', cessionarioNode)}`) : '—';
      const pivaCliente = cessionarioNode ? (getText('IdCodice', cessionarioNode) !== '—' ? getText('IdCodice', cessionarioNode) : getText('CodiceFiscale', cessionarioNode)) : '—';

      const numeroFatt = datiGenNode ? getText('Numero', datiGenNode) : '—';
      const dataFatt = datiGenNode ? getText('Data', datiGenNode) : '—';
      const totaleDoc = datiGenNode ? getText('ImportoTotaleDocumento', datiGenNode) : '—';
      const iban = getText('IBAN');

      const lineeNodes = Array.from(xmlDoc.getElementsByTagName('DettaglioLinee'));
      const linee = lineeNodes.map(ln => ({
        desc: getText('Descrizione', ln),
        qta: getText('Quantita', ln) === '—' ? '1' : getText('Quantita', ln),
        prezzo: getText('PrezzoTotale', ln),
        iva: getText('AliquotaIVA', ln)
      }));

      // Build PDF via jsPDF
      const doc = new jsPDF({ orientation: 'p', unit: 'mm', format: 'a4' });
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(16);
      doc.text('FATTURA ELETTRONICA (Estratto da .P7M)', 15, 20);
      doc.setFontSize(10);
      doc.setFont('helvetica', 'normal');
      doc.text(`Numero: ${numeroFatt}   |   Data: ${dataFatt}   |   Totale: EUR ${totaleDoc}`, 15, 28);
      doc.line(15, 32, 195, 32);

      doc.setFont('helvetica', 'bold');
      doc.text('CEDENTE / PRESTATORE (Fornitore):', 15, 40);
      doc.setFont('helvetica', 'normal');
      doc.text(`${fornitore} (P.IVA / CF: ${pivaFornitore})`, 15, 46);

      doc.setFont('helvetica', 'bold');
      doc.text('CESSIONARIO / COMMITTENTE (Cliente):', 15, 56);
      doc.setFont('helvetica', 'normal');
      doc.text(`${cliente} (P.IVA / CF: ${pivaCliente})`, 15, 62);
      if (iban !== '—') doc.text(`IBAN Pagamento: ${iban}`, 15, 68);

      doc.line(15, 73, 195, 73);
      doc.setFont('helvetica', 'bold');
      doc.text('Descrizione', 15, 80);
      doc.text('Q.ta', 135, 80);
      doc.text('IVA %', 155, 80);
      doc.text('Importo EUR', 172, 80);
      doc.line(15, 83, 195, 83);

      doc.setFont('helvetica', 'normal');
      let y = 90;
      for (const l of linee.slice(0, 28)) {
        const cleanDesc = l.desc.length > 62 ? l.desc.slice(0, 59) + '...' : l.desc;
        doc.text(cleanDesc, 15, y);
        doc.text(l.qta, 135, y);
        doc.text(l.iva, 155, y);
        doc.text(l.prezzo, 172, y);
        y += 7;
        if (y > 265) { doc.addPage(); y = 20; }
      }

      doc.line(15, y + 2, 195, y + 2);
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(12);
      doc.text(`TOTALE DOCUMENTO: EUR ${totaleDoc}`, 15, y + 10);

      const pdfBlob = doc.output('blob');
      const url = URL.createObjectURL(pdfBlob);
      blobUrls.push(url);

      previewEl.innerHTML = `
        <div style="color: var(--color-lime); font-weight: 700; margin-bottom: 8px;">✓ Fattura Elettronica FatturaPA decodificata con successo</div>
        <div><strong>Fornitore:</strong> ${escapeHTML(fornitore)} (${escapeHTML(pivaFornitore)})</div>
        <div><strong>Cliente:</strong> ${escapeHTML(cliente)} (${escapeHTML(pivaCliente)})</div>
        <div><strong>Fattura N°:</strong> ${escapeHTML(numeroFatt)} del ${escapeHTML(dataFatt)}</div>
        <div><strong>Totale Documento:</strong> € ${escapeHTML(totaleDoc)} (${linee.length} righe di dettaglio)</div>
      `;

      downloadBtn.href = url;
      downloadBtn.download = `Fattura_${cleanBaseName}.pdf`;
      resultBox.classList.remove('hidden');
      resultBox.style.display = 'flex';
      return;
    }

    alert('Impossibile individuare un PDF o una Fattura XML valida all\'interno di questo file P7M.');
  }

  resetBtn.addEventListener('click', () => {
    blobUrls.forEach(u => URL.revokeObjectURL(u));
    blobUrls.length = 0;
    resultBox.style.display = 'none';
    fileInput.value = '';
  });
</script>
