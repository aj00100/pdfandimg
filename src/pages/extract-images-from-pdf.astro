---
import Layout from '../layouts/Layout.astro';
import PDFExtract from '../components/PDFExtract.astro';
import SEOContentPDF from '../components/SEOContentPDF.astro';

const SEO_TITLE = "Extract Images From PDF — Free High Quality Converter";
const SEO_DESC = "Convert and extract every page of your PDF into high-quality JPG, PNG, or WEBP images. 100% free, secure, and processed completely offline.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <style is:global>
    :root {
      /* Vibrant Rose Theme for PDF */
      --color-lime: #f43f5e;
    }
  </style>

  <section class="relative z-20 pt-20 container-stripe">
    <div style="text-align: center; margin-bottom: 48px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(244, 63, 94, 0.08); border: 1px solid rgba(244, 63, 94, 0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 24px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">Zero-Server Privacy</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Extract Images <br/>
        <span style="color: var(--color-lime);">From PDF.</span>
      </h1>
      <p style="color: var(--color-ink-2); font-size: 1.125rem; margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        Convert PDF pages into crisp, high-resolution image files directly in your web browser. No software installation or cloud uploads required.
      </p>
    </div>

    <PDFExtract />
  </section>

  <SEOContentPDF toolName="extract" />
</Layout>
