---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';
import SmartRelatedTools from '../components/SmartRelatedTools.astro';
import AdSlot from '../components/AdSlot.astro';

const pageTitle = "Compress Image to 20KB Online — Free SSC, IBPS & Signature Optimizer";
const pageDescription = "Compress JPG, PNG, and WEBP images to exact 20KB online for free. Engineered for SSC CGL, IBPS PO, SBI Clerk biometric signatures and state PSC photo limits with 100% browser privacy.";

const uniqueContent = `
  <p class="seo-p">
    The <strong>20KB file size boundary</strong> is the single most critical threshold across Indian competitive recruitment portals—including the <strong>Staff Selection Commission (SSC CGL, CHSL, MTS, GD)</strong>, <strong>IBPS (PO, Clerk, RRB)</strong>, <strong>SBI Recruitment</strong>, and <strong>State Public Service Commissions (UPPSC, BPSC, MPPSC, MPSC)</strong>. However, candidates frequently face form rejection because the 20KB mark acts as a <em>strict maximum ceiling</em> for scanned signatures while simultaneously serving as the <em>mandatory minimum floor</em> for passport-size facial photographs.
  </p>
  <p class="seo-p">
    Generic image compressors blindly crush JPEG quality down to 10%, turning handwritten ink signatures into blurry gray smudges or dropping your candidate photograph to 18.4KB—which triggers an instant <code>"File size must be between 20KB and 50KB"</code> validation error on NIC and IBPS servers. PdfAndImg's binary-search Target-Lock engine eliminates this guesswork by locking your output payload between <strong>18.5KB and 19.9KB</strong> when you need to stay under the 20KB signature ceiling, or calibrating exact byte density without destroying stroke legibility.
  </p>

  <div style="overflow-x: auto; margin: 28px 0; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface-1);">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-surface-2); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--color-lime);">
          <th style="padding: 12px 16px;">Exam / Portal Authority</th>
          <th style="padding: 12px 16px;">Document Type</th>
          <th style="padding: 12px 16px;">20KB Rule Role</th>
          <th style="padding: 12px 16px;">Pixel Dimensions</th>
        </tr>
      </thead>
      <tbody style="color: var(--color-ink-2); font-family: var(--font-mono); font-size: 0.8125rem;">
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">SSC (CGL / CHSL / MTS)</td>
          <td style="padding: 12px 16px;">Scanned Signature</td>
          <td style="padding: 12px 16px;">10KB – 20KB (20KB Max Ceiling)</td>
          <td style="padding: 12px 16px;">140 × 60 px (4.0 × 2.0 cm)</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">IBPS / SBI (PO & Clerk)</td>
          <td style="padding: 12px 16px;">Biometric Signature</td>
          <td style="padding: 12px 16px;">10KB – 20KB (20KB Max Ceiling)</td>
          <td style="padding: 12px 16px;">140 × 60 px</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">IBPS / SSC / RRB</td>
          <td style="padding: 12px 16px;">Candidate Photograph</td>
          <td style="padding: 12px 16px;">20KB – 50KB (20KB Min Floor)</td>
          <td style="padding: 12px 16px;">200 × 230 px (3.5 × 4.5 cm)</td>
        </tr>
        <tr>
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">UPSC (ORA / OTR Portal)</td>
          <td style="padding: 12px 16px;">Photo & Signature</td>
          <td style="padding: 12px 16px;">20KB – 300KB (20KB Min Floor)</td>
          <td style="padding: 12px 16px;">350 × 350 px (Min)</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h3 class="seo-h3" style="margin-top: 32px;">How to Prevent "Blurred Signature" Disqualification at 20KB</h3>
  <p class="seo-p">
    When you photograph a signature on white paper using a modern 48MP smartphone camera, shadows cast by your phone create a gray gradient across the background. Standard JPEG encoders waste up to 14KB of your 20KB budget encoding that background noise, leaving only 6KB for the actual pen strokes. Before uploading to our 20KB compressor, sign on unruled bright white paper using a <strong>black ballpoint or gel pen</strong> (many IBPS notifications explicitly ban blue ink or capital-letter signatures) under direct overhead lighting, crop tightly around the signature box, and let our Discrete Cosine Transform (DCT) binary search lock the file at <strong>19.2KB</strong> with crisp edge contrast.
  </p>
`;

const customFaqs = [
  {
    q: "What is the difference between the 20KB maximum rule for signatures and the 20KB minimum rule for photos?",
    a: "In SSC, IBPS, and SBI portals, scanned signatures must be between 10KB and 20KB—meaning 20KB (20,480 bytes) is the strict upper ceiling. Conversely, candidate facial photographs must be between 20KB and 50KB—meaning 20KB is the minimum floor. If you are preparing a signature, set our target to 19KB so it stays safely under 20KB; if you are preparing a photo that must be above 20KB, set the target to 25KB or use our 50KB optimizer."
  },
  {
    q: "Why does my SSC or IBPS signature look blurry after compressing to 20KB?",
    a: "Blurriness happens when you upload a full-page 4000×3000px camera photo without cropping first. Compressing 12 million pixels into 20KB forces extreme chroma subsampling. Always crop closely around the signature rectangle (ideally a 140×60 pixel or 7:3 aspect ratio) before running the 20KB Target-Lock compressor so 100% of the byte budget is dedicated to your ink strokes."
  },
  {
    q: "Why did the portal reject my 20.1KB image when the limit says 20KB?",
    a: "Government validation scripts check strict binary byte counts (20 × 1024 = 20,480 bytes). A file measuring 20,550 bytes displays as 20.1KB and triggers an automatic server rejection. PdfAndImg applies a 4% mathematical safety buffer, locking a 20KB target at approximately 19.2KB to 19.8KB so your upload succeeds on the first attempt."
  },
  {
    q: "Are my facial photographs and handwritten signatures safe from identity theft?",
    a: "Yes, 100%. Handwritten signatures and biometric exam photos are highly sensitive personal data. PdfAndImg executes all image decoding, canvas scaling, and JPEG quantization directly inside your browser's local RAM. Zero bytes are ever uploaded to a remote server."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div style="padding-top: 40px; padding-bottom: 80px;">
    <div style="text-align: center; max-width: 760px; margin: 0 auto 40px; padding: 0 24px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">
          Target-Lock Engine: 20KB Exact
        </span>
      </div>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.25rem, 5.5vw, 3.75rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 16px; color: var(--color-ink);">
        Compress Image to <span style="color: var(--color-lime);">20KB</span> Online
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-ink-2); max-width: 560px; margin: 0 auto; line-height: 1.65;">
        Precision in-browser JPEG, PNG & WEBP compression calibrated for SSC, IBPS, SBI biometric signatures and state PSC exam portals.
      </p>
    </div>

    <Compressor defaultKB={20} hideHeader={true} allowMultiple={true} />

    <AdSlot format="horizontal" />

    <SEOContent
      targetKB={20}
      customTitle="Mastering the 20KB Image Limit for SSC, Banking & State PSC Portals"
      uniqueContent={uniqueContent}
      customFaqs={customFaqs}
    />

    <SmartRelatedTools />
  </div>
</Layout>
