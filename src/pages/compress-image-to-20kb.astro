---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Compress Image to 20KB — Best 20KB Image Compressor Online";
const SEO_DESC = "Compress image to 20KB online for free. Our 20KB image compressor ensures the highest quality while staying exactly under the size limit.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Precision: 20KB</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Compress Image to <br/>
        <span style="color: var(--color-lime);">Exactly 20KB.</span>
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-ink-2); line-height: 1.6; max-width: 540px; margin: 0 auto;">
        Our smart engine resizes and optimizes your photo to stay perfectly under the 20KB threshold with maximum possible clarity.
      </p>
    </div>

    <!-- The Tool -->
    <Compressor defaultKB={20} hideHeader={true} />

    <SEOContent 
      targetKB="20" 
      uniqueContent={`
        <p class="seo-p">
          The <strong>20KB image compression</strong> requirement is one of the most frequent hurdles for students and job seekers in India. 
          It is perfect for <strong>IBPS PO/Clerk thumb impressions</strong> and <strong>SSC CGL passport photos</strong>, which require uploads between 20KB and 50KB.
        </p>
        <p class="seo-p">
          We lock your image securely at 20KB to ensure your application passes the automated portal checks. Our engine will handle the noise reduction and background normalization automatically during the optimization process, so your photo or thumbprint stays completely legible for verification.
        </p>
      `}
    />

    <!-- Technical Note -->
    <div style="max-width: 860px; margin: 64px auto 0; padding: 40px; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 16px;">
       <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
         Optimal 20KB Compression
       </h3>
       <p style="color: var(--color-ink-2); font-size: 0.875rem; line-height: 1.7;">
         The 20KB limit is common for signatures and small photos. pdfANDimg uses a Target-Lock algorithm to find the highest quality that fits into 20KB, ensuring your file is never rejected for size.
       </p>
    </div>
  </section>
</Layout>
