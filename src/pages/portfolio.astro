---
import Layout from '../layouts/Layout.astro';

const SEO_TITLE = "Ajay Kumar - Cybersecurity Portfolio";
const SEO_DESC = "Portfolio of Ajay Kumar, a Cybersecurity undergraduate specializing in web security testing, bug bounty, Python automation, and modern web development.";
---

<Layout title={SEO_TITLE} description={SEO_DESC} noindex={true}>
  <div class="hacker-wrapper">
    <div class="terminal-container">
      
      <!-- Terminal Header -->
      <div class="terminal-header">
        <div class="mac-btns">
          <span class="btn close"></span>
          <span class="btn min"></span>
          <span class="btn max"></span>
        </div>
        <div class="terminal-title">root@ajay-sec-node:~</div>
      </div>

      <!-- Terminal Body -->
      <div class="terminal-body">
        <p class="sys-msg">INITIATING SECURE CONNECTION...</p>
        <p class="sys-msg">HANDSHAKE SUCCESSFUL.</p>
        <p class="sys-msg">ACCESS GRANTED: <span class="highlight-green">ROOT PRIVILEGES ACTIVE</span></p>
        <br/>

        <div class="typewriter-section">
          <span class="prompt">root@ajay-sec-node:~#</span> <span class="cmd type-1">whoami</span>
        </div>
        <div class="output delay-1">
          <h1 class="glitch-text" data-text="AJAY KUMAR">AJAY KUMAR</h1>
          <h2 class="sub-role">> CYBERSECURITY & WEB DEVELOPER</h2>
          <p class="bio">
            Cybersecurity undergraduate with hands-on experience in web security testing, bug bounty methodologies, and Python automation. Looking for an opportunity to apply practical security skills, learn from experienced professionals, and contribute to securing real-world applications.
          </p>
        </div>
        <br/>

        <div class="typewriter-section">
          <span class="prompt">root@ajay-sec-node:~#</span> <span class="cmd type-2">cat ./links.txt</span>
        </div>
        <div class="output delay-2 grid-links">
          <a href="mailto:ajay2026kr@gmail.com" target="_blank" rel="noopener noreferrer">[ EMAIL ]</a>
          <a href="https://github.com/aj00100" target="_blank" rel="noopener noreferrer">[ GITHUB ]</a>
          <a href="https://www.linkedin.com/in/ajay-kumar-b615ab293/" target="_blank" rel="noopener noreferrer">[ LINKEDIN ]</a>
          <a href="https://tryhackme.com/p/ajay2026kr" target="_blank" rel="noopener noreferrer">[ TRYHACKME ]</a>
          <a href="tel:+919153497721">[ +91 9153497721 ]</a>
        </div>
        <br/>

        <div class="typewriter-section">
          <span class="prompt">root@ajay-sec-node:~#</span> <span class="cmd type-3">ls -la ./skills/</span>
        </div>
        <div class="output delay-3">
          <div class="skill-group">
            <span class="skill-label">LANGUAGES_&_SCRIPTING:</span>
            <span class="skill-value">Python, JavaScript, Bash, HTML, CSS</span>
          </div>
          <div class="skill-group">
            <span class="skill-label">SECURITY_ARSENAL:</span>
            <span class="skill-value highlight-cyan">Burp Suite, Nmap, Wireshark, SQLMap</span>
          </div>
          <div class="skill-group">
            <span class="skill-label">DEV_ENVIRONMENT:</span>
            <span class="skill-value">Kali Linux, Windows, Git, VS Code, Docker</span>
          </div>
          <div class="skill-group">
            <span class="skill-label">FRAMEWORKS:</span>
            <span class="skill-value">Astro, TypeScript</span>
          </div>
        </div>
        <br/>

        <div class="typewriter-section">
          <span class="prompt">root@ajay-sec-node:~#</span> <span class="cmd type-4">cat ./projects/pdfandimg.sh</span>
        </div>
        <div class="output delay-4 project-box">
          <div class="proj-header">
            <h3>> PdfAndImg (Live: <a href="https://pdfandimg.com" target="_blank" class="highlight-green">https://pdfandimg.com</a>)</h3>
            <span class="stack">[ Astro, JS, HTML, CSS ]</span>
          </div>
          <ul>
            <li>Built and deployed a browser-based PDF and image utility platform (44+ tools).</li>
            <li>Implemented image compression, PDF editing, HEIC conversion, and image resizing.</li>
            <li>Designed the application for fast performance, SEO, and privacy by processing files entirely in the browser.</li>
          </ul>
        </div>
        <br/>

        <div class="typewriter-section">
          <span class="prompt">root@ajay-sec-node:~#</span> <span class="cmd type-5">./view_credentials.sh</span>
        </div>
        <div class="output delay-5">
          <div class="cert-box">
            <p><span class="highlight-cyan">[*]</span> <strong>B.Tech Computer Science & Engineering (Cyber Security)</strong></p>
            <p class="indent">IES College of Technology, Bhopal (2023–2027) | CGPA: 7.1/10</p>
          </div>
          <div class="cert-box">
            <p><span class="highlight-green">[+]</span> <strong>NPTEL Ethical Hacking (Elite)</strong> – IIT Kharagpur 
              <a href="https://archive.nptel.ac.in/content/noc/NOC24/SEM2/Ecertificates/106/noc24-cs94/Course/NPTEL24CS94S35390030004075414.pdf" target="_blank" class="cert-link">[ VIEW CERT ]</a>
            </p>
            <p><span class="highlight-green">[+]</span> <strong>NPTEL Systems & Usable Security (Elite+Silver)</strong> – IIT Indore 
              <a href="https://archive.nptel.ac.in/content/noc/NOC25/SEM1/Ecertificates/106/noc25-cs68/Course/NPTEL25CS68S33880002601295204.pdf" target="_blank" class="cert-link">[ VIEW CERT ]</a>
            </p>
          </div>
        </div>
        <br/>
        
        <div class="typewriter-section delay-6">
          <span class="prompt">root@ajay-sec-node:~#</span> <span class="blinking-cursor">_</span>
        </div>

      </div>
    </div>
  </div>

  <style>
    /* Scope everything inside .hacker-wrapper to not break global styles */
    .hacker-wrapper {
      padding: 40px 20px;
      min-height: 80vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace, 'Courier New';
      background: radial-gradient(circle at 50% 50%, rgba(0, 255, 157, 0.05) 0%, transparent 60%);
    }

    .terminal-container {
      width: 100%;
      max-width: 900px;
      background: #050a0f;
      border: 1px solid rgba(0, 255, 157, 0.3);
      border-radius: 12px;
      box-shadow: 0 0 40px rgba(0, 255, 157, 0.1), inset 0 0 20px rgba(0,0,0,0.8);
      overflow: hidden;
      position: relative;
    }

    .terminal-container::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(rgba(0, 255, 157, 0.03) 50%, transparent 50%);
      background-size: 100% 4px;
      pointer-events: none;
      z-index: 10;
    }

    .terminal-header {
      background: #111827;
      border-bottom: 1px solid rgba(0, 255, 157, 0.3);
      padding: 12px 16px;
      display: flex;
      align-items: center;
    }

    .mac-btns {
      display: flex;
      gap: 8px;
    }

    .mac-btns .btn {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }
    .btn.close { background: #ff5f56; }
    .btn.min { background: #ffbd2e; }
    .btn.max { background: #27c93f; }

    .terminal-title {
      flex-grow: 1;
      text-align: center;
      color: rgba(255,255,255,0.6);
      font-size: 0.85rem;
      letter-spacing: 0.05em;
    }

    .terminal-body {
      padding: 32px;
      color: #e0e0e0;
      font-size: 0.95rem;
      line-height: 1.6;
      max-height: 75vh;
      overflow-y: auto;
    }

    .terminal-body::-webkit-scrollbar { width: 8px; }
    .terminal-body::-webkit-scrollbar-track { background: #050a0f; border-left: 1px solid rgba(0, 255, 157, 0.1); }
    .terminal-body::-webkit-scrollbar-thumb { background: rgba(0, 255, 157, 0.3); border-radius: 4px; }

    .sys-msg {
      color: #888;
      margin: 0 0 4px 0;
      font-size: 0.85rem;
    }

    .highlight-green { color: #00ff9d; font-weight: bold; text-shadow: 0 0 8px rgba(0,255,157,0.4); }
    .highlight-cyan { color: #00f0ff; font-weight: bold; text-shadow: 0 0 8px rgba(0,240,255,0.4); }

    .prompt {
      color: #00ff9d;
      font-weight: bold;
      margin-right: 8px;
    }

    .glitch-text {
      font-size: 2.5rem;
      color: #fff;
      margin: 16px 0 8px 0;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 0.1em;
      position: relative;
    }
    
    .sub-role {
      color: #00f0ff;
      font-size: 1.1rem;
      margin: 0 0 16px 0;
      font-weight: 600;
    }

    .bio {
      color: #a0aec0;
      max-width: 700px;
      margin: 0;
      border-left: 2px solid rgba(0,255,157,0.3);
      padding-left: 16px;
    }

    .grid-links {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }

    .grid-links a {
      color: #00ff9d;
      text-decoration: none;
      padding: 8px 16px;
      border: 1px solid rgba(0,255,157,0.3);
      background: rgba(0,255,157,0.05);
      transition: all 0.2s;
    }

    .grid-links a:hover {
      background: rgba(0,255,157,0.2);
      box-shadow: 0 0 15px rgba(0,255,157,0.4);
      color: #fff;
    }

    .skill-group {
      margin-bottom: 8px;
      display: flex;
      flex-wrap: wrap;
    }

    .skill-label {
      width: 220px;
      color: #888;
      font-weight: bold;
    }
    
    @media (max-width: 600px) {
      .skill-label { width: 100%; margin-bottom: 4px; }
    }

    .skill-value {
      color: #e2e8f0;
    }

    .project-box {
      border: 1px dashed rgba(0,240,255,0.4);
      padding: 16px;
      background: rgba(0,240,255,0.03);
    }
    
    .proj-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .proj-header h3 {
      margin: 0;
      color: #00f0ff;
      font-size: 1.2rem;
    }

    .proj-header .stack {
      color: #888;
      font-size: 0.85rem;
    }

    .project-box ul {
      margin: 0;
      padding-left: 20px;
      color: #cbd5e1;
    }
    .project-box li { margin-bottom: 6px; }

    .cert-box {
      margin-bottom: 16px;
    }
    .cert-box p { margin: 0 0 6px 0; }
    .indent { padding-left: 28px; color: #a0aec0; font-size: 0.9rem; }
    .cert-link {
      color: #00f0ff;
      text-decoration: none;
      margin-left: 8px;
      font-size: 0.85rem;
      border-bottom: 1px dotted #00f0ff;
    }
    .cert-link:hover {
      color: #fff;
      border-bottom-color: #fff;
      text-shadow: 0 0 8px #00f0ff;
    }

    /* Animations */
    .blinking-cursor {
      display: inline-block;
      width: 10px;
      height: 1.2em;
      background-color: #00ff9d;
      vertical-align: middle;
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    /* Reveal animations */
    .output { opacity: 0; animation: reveal 0.1s forwards; }
    
    .delay-1 { animation-delay: 1.5s; }
    .delay-2 { animation-delay: 3s; }
    .delay-3 { animation-delay: 4.5s; }
    .delay-4 { animation-delay: 6s; }
    .delay-5 { animation-delay: 7.5s; }
    .delay-6 { opacity: 0; animation: reveal 0.1s forwards 8.5s; }

    @keyframes reveal {
      to { opacity: 1; }
    }

    .cmd {
      display: inline-block;
      overflow: hidden;
      white-space: nowrap;
      vertical-align: bottom;
      border-right: 2px solid transparent;
    }

    /* Typing effect widths */
    .type-1 { width: 0; animation: type 1s steps(6, end) 0.5s forwards; }
    .type-2 { width: 0; animation: type 1s steps(15, end) 2s forwards; }
    .type-3 { width: 0; animation: type 1s steps(15, end) 3.5s forwards; }
    .type-4 { width: 0; animation: type 1s steps(25, end) 5s forwards; }
    .type-5 { width: 0; animation: type 1s steps(22, end) 6.5s forwards; }

    @keyframes type {
      0% { width: 0; border-right: 2px solid #00ff9d; }
      99% { border-right: 2px solid #00ff9d; }
      100% { width: 100%; border-right: 2px solid transparent; }
    }
  </style>
</Layout>
