---
import Layout from '../layouts/Layout.astro';

const SEO_TITLE = "Ajay Kumar - Cybersecurity & Web Developer Portfolio";
const SEO_DESC = "Portfolio of Ajay Kumar, a Cybersecurity undergraduate specializing in web security testing, bug bounty, Python automation, and modern web development.";
---

<style>
  @media (max-width: 768px) {
    .portfolio-grid {
      grid-template-columns: 1fr !important;
    }
    .hero-section {
      padding: 32px 16px !important;
    }
  }

  .glass-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 40px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  
  .glass-card:hover {
    border-color: var(--color-border-hi);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .link-btn:hover {
    background: rgba(200, 241, 53, 0.1);
    border-color: var(--color-lime);
    color: var(--color-lime);
    transform: translateY(-2px);
  }

  .skill-tag {
    display: inline-block;
    padding: 6px 14px;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-mid);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-2);
  }
</style>

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-16 container-stripe">
    
    <!-- Hero Section -->
    <div class="hero-section" style="text-align: center; margin-bottom: 64px; max-width: 800px; margin-left: auto; margin-right: auto; padding: 0 24px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 24px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">
          Portfolio
        </span>
      </div>

      <h1 style="font-size: clamp(3rem, 8vw, 5rem); line-height: 1.05; margin: 0 0 16px; letter-spacing: -0.04em;">
        Ajay <span style="color: var(--color-lime);">Kumar</span>
      </h1>
      <h2 style="font-size: 1.5rem; color: var(--color-ink-2); margin: 0 0 32px; font-weight: 500;">
        Cybersecurity & Web Developer
      </h2>

      <p style="font-size: 1.125rem; color: var(--color-ink-3); line-height: 1.7; margin-bottom: 40px;">
        Cybersecurity undergraduate with hands-on experience in web security testing, bug bounty methodologies, and Python automation. Looking for an opportunity to apply practical security skills, learn from experienced professionals, and contribute to securing real-world applications.
      </p>

      <!-- Links -->
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 16px;">
        <a href="mailto:ajay2026kr@gmail.com" class="link-btn" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          Email
        </a>
        <a href="https://github.com/aj00100" class="link-btn" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          GitHub
        </a>
        <a href="https://linkedin.com/" class="link-btn" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          LinkedIn
        </a>
        <a href="https://tryhackme.com/" class="link-btn" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5.5-3.58 10.74-8 12-4.42-1.26-8-6.5-8-12V6l8-4z"></path></svg>
          TryHackMe
        </a>
        <a href="tel:+919153497721" class="link-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          +91 9153497721
        </a>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="portfolio-grid" style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 0 24px;">
      
      <!-- Experience & Projects -->
      <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Projects -->
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <div style="width: 40px; height: 40px; background: var(--color-surface-3); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; margin: 0;">Projects</h3>
          </div>
          
          <div style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
              <h4 style="font-size: 1.25rem; font-weight: 600; color: var(--color-ink); margin: 0;">PdfAndImg</h4>
              <a href="https://pdfandimg.com" target="_blank" rel="noopener noreferrer" style="color: var(--color-lime); text-decoration: none; font-size: 0.875rem; font-weight: 500;">Live Site ↗</a>
            </div>
            <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3); margin-bottom: 12px;">Astro, JavaScript, HTML, CSS</p>
            <ul style="color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.6; padding-left: 20px; margin: 0; display: flex; flex-direction: column; gap: 8px;">
              <li>Built and deployed a browser-based PDF and image utility platform (44+ tools).</li>
              <li>Implemented image compression, PDF editing, HEIC conversion, and image resizing.</li>
              <li>Designed the application for fast performance, SEO, and privacy by processing files entirely in the browser.</li>
            </ul>
          </div>
        </div>

        <!-- Education -->
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <div style="width: 40px; height: 40px; background: var(--color-surface-3); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; margin: 0;">Education</h3>
          </div>

          <div>
            <h4 style="font-size: 1.125rem; font-weight: 600; color: var(--color-ink); margin: 0 0 4px 0;">B.Tech in Computer Science & Engineering</h4>
            <p style="color: var(--color-lime); font-size: 0.875rem; font-weight: 600; margin: 0 0 8px 0;">Cyber Security Specialization (2023 – 2027)</p>
            <p style="color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.5; margin: 0 0 4px 0;">IES College of Technology, Bhopal</p>
            <p style="color: var(--color-ink-3); font-size: 0.875rem; margin: 0 0 8px 0;">Affiliated to Rajiv Gandhi Proudyogiki Vishwavidyalaya (RGPV)</p>
            <div style="display: inline-block; padding: 4px 12px; background: rgba(200,241,53,0.1); border: 1px solid var(--color-lime); border-radius: 6px; color: var(--color-lime); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700;">
              CGPA: 7.1/10
            </div>
          </div>
        </div>

      </div>

      <!-- Skills & Certificates -->
      <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Skills -->
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <div style="width: 40px; height: 40px; background: var(--color-surface-3); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"></path><path d="M10 2c1 .5 2 2 2 5"></path></svg>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; margin: 0;">Skills</h3>
          </div>

          <div style="margin-bottom: 20px;">
            <h4 style="font-size: 0.9375rem; color: var(--color-ink); margin: 0 0 12px 0;">Programming Languages</h4>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              <span class="skill-tag">Python</span>
              <span class="skill-tag">JavaScript</span>
              <span class="skill-tag">Bash</span>
              <span class="skill-tag">HTML</span>
              <span class="skill-tag">CSS</span>
            </div>
          </div>

          <div style="margin-bottom: 20px;">
            <h4 style="font-size: 0.9375rem; color: var(--color-ink); margin: 0 0 12px 0;">Frameworks & Technologies</h4>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              <span class="skill-tag">Astro</span>
              <span class="skill-tag">TypeScript</span>
            </div>
          </div>

          <div style="margin-bottom: 20px;">
            <h4 style="font-size: 0.9375rem; color: var(--color-ink); margin: 0 0 12px 0;">Security Tools</h4>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              <span class="skill-tag">Burp Suite</span>
              <span class="skill-tag">Nmap</span>
              <span class="skill-tag">Wireshark</span>
              <span class="skill-tag">SQLMap</span>
            </div>
          </div>

          <div>
            <h4 style="font-size: 0.9375rem; color: var(--color-ink); margin: 0 0 12px 0;">Operating Systems & Dev Tools</h4>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              <span class="skill-tag">Kali Linux</span>
              <span class="skill-tag">Windows</span>
              <span class="skill-tag">Git</span>
              <span class="skill-tag">VS Code</span>
              <span class="skill-tag">Docker</span>
            </div>
          </div>
        </div>

        <!-- Certificates & Languages -->
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <div style="width: 40px; height: 40px; background: var(--color-surface-3); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; margin: 0;">Certificates</h3>
          </div>

          <ul style="color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.6; padding-left: 0; list-style: none; margin: 0 0 32px 0; display: flex; flex-direction: column; gap: 12px;">
            <li style="position: relative; padding-left: 20px;">
              <span style="position: absolute; left: 0; top: 8px; width: 6px; height: 6px; background: var(--color-lime); border-radius: 50%;"></span>
              <strong>NPTEL Ethical Hacking (Elite)</strong> – IIT Kharagpur
            </li>
            <li style="position: relative; padding-left: 20px;">
              <span style="position: absolute; left: 0; top: 8px; width: 6px; height: 6px; background: var(--color-lime); border-radius: 50%;"></span>
              <strong>NPTEL Systems and Usable Security (Elite + Silver)</strong> – IIT Indore
            </li>
          </ul>

          <div style="border-top: 1px solid var(--color-border); padding-top: 24px;">
            <h4 style="font-size: 1.125rem; font-weight: 600; color: var(--color-ink); margin: 0 0 12px 0;">Languages</h4>
            <div style="display: flex; gap: 12px;">
              <span class="skill-tag">English</span>
              <span class="skill-tag">Hindi</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
