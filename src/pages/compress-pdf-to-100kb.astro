---
import Layout from '../layouts/Layout.astro';
import PDFCompressor from '../components/PDFCompressor.astro';
import SEOContentPDF from '../components/SEOContentPDF.astro';

const SEO_TITLE = "Compress PDF to 100KB — Free & Secure Offline Tool";
const SEO_DESC = "Compress your PDF file to exactly 100KB online. Fast, secure, and processed completely in your browser without uploading to any server.";
const compress100KbFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why did my compressed 100KB PDF get rejected on the portal, and how do I fix it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Government portals often calculate file sizes using strict binary limits where 100 KB equals exactly 102,400 bytes (100 KiB) or 100,000 bytes. If an online compressor creates a file that is 100.2 KB (102,604 bytes), the server firewall will reject it. Our tool deliberately targets between 92 KB and 98 KB to ensure guaranteed compliance. If a rejection still occurs, confirm that your destination portal does not require a specific naming format (e.g., no spaces or special characters in the filename) or require the PDF to be free from password protection."
      }
    },
    {
      "@type": "Question",
      "name": "Can multi-page PDF documents be compressed to under 100KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, multi-page PDFs with 2 to 4 pages can successfully be compressed below 100KB, particularly if they consist of black-and-white scanned certificates, contracts, or text sheets. To achieve the 100KB ceiling across multiple pages, ensure your document is saved in grayscale or monochrome mode at 120–150 DPI. For large booklets exceeding 10 pages, maintaining high readability below 100KB becomes challenging; in such cases, consider using our PDF Page Remover tool to extract only the mandatory pages required by the portal."
      }
    },
    {
      "@type": "Question",
      "name": "Will compressing my marksheet or certificate to 100KB blur official stamps and QR codes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Our smart compression algorithm uses adaptive bicubic downsampling that selectively maintains sharp contrast along text glyphs, rubber stamp contours, and 2D QR code matrices. Verifying officers and automated optical scanners will have no issue reading the registration numbers, subject marks, and cryptographic verification codes."
      }
    },
    {
      "@type": "Question",
      "name": "Is it safe to compress confidential PDFs like EPFO passbooks and PAN card copies here?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, it is completely safe. PdfAndImg is designed with a strict Zero-Server architecture. The entire compression process takes place within your web browser's local sandbox memory. No file is ever transmitted over the network or saved to an external database, eliminating any risk of identity theft or data leakage."
      }
    },
    {
      "@type": "Question",
      "name": "How should I scan my document to get the best quality before compressing to 100KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For ideal results, scan physical papers at 150 DPI to 200 DPI using 'Document' or 'Grayscale' mode rather than 'Color Photo' mode. Place the paper flat under even lighting to avoid shadows, and crop out desk edges, shadows, and scanner glass margins. Eliminating heavy dark borders dramatically reduces raw image weight, allowing the compressor to preserve maximum sharpness in the actual document text."
      }
    }
  ]
};
