---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "Increase Image Size in KB — Enhance Image Size to 100KB, 50KB Online";
const SEO_DESC = "Need to increase image size in KB? Our KB Enhancer helps you meet minimum file size requirements by upscaling and padding your images safely.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <section class="relative z-20 pt-20 container-stripe">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Feature: KB Enhancement</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Increase Image <br/>
        <span style="color: var(--color-lime);">Size in KB.</span>
      </h1>
      <p style="color: var(--color-ink-2); font-size: 1.125rem; margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        Upload multiple images at once for instant bulk processing. We safely upscale and pad them to meet your exact target.
      </p>
    </div>

    <!-- The Tool -->
    <Compressor defaultKB={50} hideHeader={true} allowMultiple={true} />

    <SEOContent 
      targetKB="Custom" 
      type="enhance" 
      uniqueContent={`
        <p class="seo-p">Sometimes portals require a <strong>minimum file size</strong>. Our <strong>KB Enhancer</strong> solves this by safely upscaling pixels and injecting non-visual data blocks to meet your target without altering the photo's appearance.</p>
        <p class="seo-p">This is essential for systems that reject files for being "too small," a common issue with high-efficiency modern smartphones.</p>
      `}
    />

    <!-- Technical Note -->
    <div class="enhance-grid">
       <div class="tech-card">
          <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>
            Pixel Upscaling
          </h3>
          <p style="color: var(--color-ink-2); font-size: 0.875rem; line-height: 1.7;">
            We enhance your photo's dimensions to naturally increase file size. This adds legitimate data while often improving sharpness on high-resolution displays.
          </p>
       </div>

       <div class="tech-card">
          <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>
            Metadata Padding
          </h3>
          <p style="color: var(--color-ink-2); font-size: 0.875rem; line-height: 1.7;">
            For exact targets, we inject non-visual data blocks. This increases the KB count to your target without altering the photo's appearance.
          </p>
       </div>
    </div>
  </section>
</Layout>

<style>
  .enhance-grid {
    max-width: 860px;
    margin: 64px auto 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .enhance-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tech-card {
    padding: 40px;
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }
</style>
