---
import Layout from '../layouts/Layout.astro';
import FormatConverter from '../components/FormatConverter.astro';
import SEOContentFormat from '../components/SEOContentFormat.astro';

const SEO_TITLE = "Convert WEBP to PDF — Instant & Private Online Converter";
const SEO_DESC = "Convert your WEBP images to PDF documents instantly in your browser. Supports bulk conversion, 100% private, no server upload required.";
---

<Layout title={SEO_TITLE} description={SEO_DESC}>
  <style is:global>
    :root {
      /* Electric Blue Theme for PDF Conversion */
      --color-lime: #0088ff;
    }
  </style>

  <section class="relative z-20 pt-20 container-stripe">
    <div style="text-align: center; margin-bottom: 48px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(0, 136, 255, 0.08); border: 1px solid rgba(0, 136, 255, 0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 24px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">Feature: Format Converter</span>
      </div>

      <h1 style="font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 0 0 24px; letter-spacing: -0.05em;">
        Convert <span style="color: var(--color-lime);">WEBP</span> <br/>
        to <span style="color: var(--color-lime);">PDF</span>.
      </h1>
      <p style="color: var(--color-ink-2); font-size: 1.125rem; margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        Upload multiple WEBP images and convert them to PDF documents instantly. All processing happens locally on your device for maximum privacy.
      </p>
    </div>

    <FormatConverter toFormat="pdf" allowMultiple={true} />
  </section>

  <SEOContentFormat fromFormat="WEBP" toFormat="PDF" />
</Layout>
