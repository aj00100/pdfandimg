---
import '../styles/global.css';
import TeamCard from '../components/team/TeamCard.astro';

const SEO_TITLE = "Team — College Minor Project";
---

<!doctype html>
<html lang="en" class="bg-[#05050A] text-white overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{SEO_TITLE}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        background-color: transparent !important;
        color: white;
      }
      .font-serif {
        font-family: 'Playfair Display', serif;
      }
      
      /* Planet Horizon Curve */
      .horizon {
        position: absolute;
        top: 350px;
        left: -20vw;
        width: 140vw;
        height: 1000px;
        border-radius: 50%;
        background: transparent;
        z-index: 0;
      }
      .horizon::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        padding: 2px;
        background: linear-gradient(90deg, transparent 10%, #c026d3 30%, #3b82f6 70%, transparent 90%);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
      }
      .horizon-glow {
        position: absolute;
        top: 350px;
        left: -20vw;
        width: 140vw;
        height: 1000px;
        border-radius: 50%;
        box-shadow: 
          0 -20px 150px rgba(192, 38, 211, 0.3),
          0 -20px 150px rgba(59, 130, 246, 0.3);
        z-index: -1;
      }

      /* Massive ambient glows */
      .glow-left {
        position: absolute;
        top: 200px;
        left: -10%;
        width: 700px;
        height: 500px;
        background: radial-gradient(ellipse at center, rgba(192, 38, 211, 0.2) 0%, transparent 70%);
        transform: rotate(-15deg);
        z-index: -1;
        pointer-events: none;
      }
      .glow-right {
        position: absolute;
        top: 150px;
        right: -10%;
        width: 700px;
        height: 600px;
        background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.2) 0%, transparent 70%);
        transform: rotate(15deg);
        z-index: -1;
        pointer-events: none;
      }

      /* Shooting Stars */
      .shooting-star-1 {
        position: absolute;
        top: 150px;
        left: 20%;
        width: 150px;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8));
        transform: rotate(35deg);
        opacity: 0.6;
      }
      .shooting-star-2 {
        position: absolute;
        top: 100px;
        right: 15%;
        width: 100px;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8));
        transform: rotate(35deg);
        opacity: 0.8;
      }

      @keyframes fadeUp {
        0% { opacity: 0; transform: translateY(30px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      @keyframes textGlow {
        0%, 100% { filter: drop-shadow(0 0 10px rgba(96, 165, 250, 0.4)); }
        50% { filter: drop-shadow(0 0 25px rgba(52, 211, 153, 0.9)); }
      }
    </style>
  </head>
  <body class="relative">
    
    <!-- Background Elements -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-[0]" style="background-color: #05050A;">
      <!-- Glowing rainbow nebulas -->
      <div class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-red-600 opacity-15 blur-[150px] mix-blend-screen"></div>
      <div class="absolute top-[20%] left-[20%] w-[40vw] h-[40vw] rounded-full bg-yellow-500 opacity-15 blur-[120px] mix-blend-screen"></div>
      <div class="absolute bottom-[10%] right-[30%] w-[60vw] h-[60vw] rounded-full bg-green-500 opacity-15 blur-[150px] mix-blend-screen"></div>
      <div class="absolute top-[-20%] right-[-10%] w-[50vw] h-[50vw] rounded-full bg-blue-600 opacity-15 blur-[150px] mix-blend-screen"></div>
      <div class="absolute bottom-[-10%] left-[30%] w-[40vw] h-[40vw] rounded-full bg-purple-600 opacity-15 blur-[150px] mix-blend-screen"></div>
      
      <canvas id="rainbow-dust" class="absolute inset-0 w-full h-full z-0 opacity-100"></canvas>
    </div>

    <!-- Navigation -->
    <nav class="flex items-center justify-between px-8 py-6 max-w-[1600px] mx-auto relative z-20">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
        <span class="text-[0.65rem] tracking-[0.2em] uppercase font-semibold text-white/90">College Minor Project</span>
      </div>

      <!-- Links -->
      <div class="hidden md:flex items-center gap-10 text-sm font-medium text-gray-400">
        <a href="#" class="hover:text-white transition">Home</a>
        <a href="#" class="hover:text-white transition">About</a>
        <a href="#" class="hover:text-white transition">Projects</a>
        <div class="flex flex-col items-center">
          <a href="#" class="text-white">Team</a>
          <div class="w-1 h-1 bg-[#a855f7] rounded-full mt-1.5 shadow-[0_0_6px_#a855f7]"></div>
        </div>
        <a href="#" class="hover:text-white transition">Contact</a>
      </div>

      <!-- Button -->
      <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl border border-white/10 bg-[#0a0a14]/60 hover:bg-white/10 transition text-sm text-white backdrop-blur-md">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c026d3" stroke-width="2"><path d="M12 2l3 7 7 3-7 3-3 7-3-7-7-3 7-3z"/></svg>
        Let's Collaborate
      </button>
    </nav>

    <main class="max-w-[1200px] mx-auto px-6 pt-12 pb-32 relative z-10 flex flex-col items-center">
      
      <!-- Hero -->
      <header class="text-center mb-24 w-full flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/5 bg-[#0a0a14]/60 backdrop-blur-md mb-8 opacity-0 translate-y-4 shadow-xl" style="animation: fadeUp 1s ease-out forwards;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><path d="M12 2l3 7 7 3-7 3-3 7-3-7-7-3 7-3z"/></svg>
          <span class="text-[0.6rem] uppercase tracking-[0.2em] text-gray-300 font-bold">The Driving Force</span>
        </div>
        
        <h1 class="text-[4rem] md:text-[6rem] font-serif tracking-tighter mb-8 opacity-0 translate-y-4" style="animation: fadeUp 1s ease-out 0.2s forwards; line-height: 1.1;">
          <span class="text-white font-light">Meet the</span> 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#c026d3] to-[#3b82f6] font-bold pl-2 drop-shadow-[0_0_20px_rgba(192,38,211,0.3)]">Visionaries</span>
        </h1>
        
        <p class="text-gray-300 text-xl md:text-2xl max-w-3xl mx-auto font-light leading-relaxed opacity-0 translate-y-4" style="animation: fadeUp 1s ease-out 0.4s forwards;">
          A group of passionate engineers turning ideas into impactful <br/> digital solutions. <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400 font-semibold tracking-wide inline-block" style="animation: textGlow 3s ease-in-out infinite;">Innovating today, shaping tomorrow.</span>
        </p>
      </header>

      <!-- Team Grid -->
      <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <TeamCard 
          name="Ajay Kumar" 
          role="PROJECT LEAD" 
          initials="AJ" 
          theme="purple"
          description="Full-stack architecture, core logic, and team management."
          delay={0.6} 
        />
        <TeamCard 
          name="Sahil Alam" 
          role="FRONTEND DEV" 
          initials="SA" 
          theme="blue"
          description="Building responsive interfaces and interactive web components."
          delay={0.8} 
        />
        <TeamCard 
          name="Aprajeeta Singh" 
          role="UI/UX DESIGNER" 
          initials="AS" 
          theme="purple"
          description="Crafting user journeys, wireframing, and visual aesthetics."
          delay={1.0} 
        />
        <TeamCard 
          name="Abhishek Kumar Singh" 
          role="QA & MAINTENANCE" 
          initials="AK" 
          theme="blue"
          description="Ensuring project stability, testing, and continuous maintenance."
          delay={1.2} 
        />
      </div>
      
    </main>

    <script is:inline>
      const canvas = document.getElementById("rainbow-dust");
      if (canvas) {
        const ctx = canvas.getContext("2d");
        let w, h;
        let particles = [];
        let time = 0;
        let mouseX = -1000;
        let mouseY = -1000;
        
        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });
        
        window.addEventListener('mouseout', () => {
          mouseX = -1000;
          mouseY = -1000;
        });
        
        function resize() {
          w = window.innerWidth;
          h = window.innerHeight;
          
          // High-DPI (Retina) scaling for HD quality
          const dpr = window.devicePixelRatio || 1;
          canvas.width = w * dpr;
          canvas.height = h * dpr;
          ctx.scale(dpr, dpr);
          
          particles = [];
          for (let i = 0; i < 1500; i++) {
            particles.push({
              x: Math.random() * w,
              y: Math.random() * h,
              size: Math.random() * 2 + 0.5,
              baseVx: (Math.random() - 0.5) * 0.4,
              baseVy: (Math.random() - 0.5) * 0.4 - 0.1, // floating up slowly
              vx: 0,
              vy: 0,
              hue: Math.random() * 360,
              baseAlpha: Math.random() * 0.7 + 0.3, // Increased opacity for HD contrast
              fadeSpeed: Math.random() * 2 + 1,     // Random fade duration
              fadeOffset: Math.random() * Math.PI * 2 // Random start phase
            });
          }
        }
        window.addEventListener("resize", resize);
        resize();
        
        function draw() {
          time += 0.01;
          
          // Reset blend mode to clear background properly
          ctx.globalCompositeOperation = 'source-over';
          ctx.clearRect(0, 0, w, h);
          
          // Enable Additive Blending for high-contrast HDR glowing effect
          ctx.globalCompositeOperation = 'lighter';
          
          particles.forEach(p => {
            // Mouse Repulsion interaction
            const dx = mouseX - p.x;
            const dy = mouseY - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            
            if (dist < 120) {
              const force = (120 - dist) / 120;
              p.vx -= (dx / dist) * force * 0.8;
              p.vy -= (dy / dist) * force * 0.8;
            }
            
            // Friction gently slows them back to normal speed
            p.vx *= 0.95;
            p.vy *= 0.95;
            
            p.x += Math.sin(time + p.y * 0.01) * 0.2 + p.baseVx + p.vx;
            p.y += p.baseVy + p.vy;
            
            // Wrap around
            if (p.x < -10) p.x = w + 10;
            if (p.x > w + 10) p.x = -10;
            if (p.y < -10) p.y = h + 10;
            if (p.y > h + 10) p.y = -10;
            
            // Draw glowing particle with dynamic fading alpha
            const currentAlpha = p.baseAlpha * (Math.sin(time * p.fadeSpeed + p.fadeOffset) * 0.5 + 0.5);
            ctx.fillStyle = `hsla(${p.hue}, 100%, 75%, ${currentAlpha})`;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fill();
          });
          
          requestAnimationFrame(draw);
        }
        draw();
      }
    </script>
  </body>
</html>
