---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';
import SmartRelatedTools from '../components/SmartRelatedTools.astro';
import AdSlot from '../components/AdSlot.astro';

const pageTitle = "Compress Image to 50KB Online — Passport Photo, Visa & Admission Tool";
const pageDescription = "Compress JPG, PNG, and WEBP photos to under 50KB online for free. Calibrated for 3.5x4.5cm & 2x2 inch government passport photos, online visa portals, and university admission forms.";

const uniqueContent = `
  <p class="seo-p">
    The <strong>50KB threshold (typically enforced as a 20KB to 50KB window)</strong> is the universal gold standard for <strong>digital passport-size photographs</strong> across Indian and international e-governance systems, university admission portals (CUET, JEE, state counseling boards), and consular visa applications. Whether you are uploading a <strong>3.5 × 4.5 cm</strong> portrait for Passport Seva / PAN Card (NSDL & UTIITSL) or a <strong>2 × 2 inch (51 × 51 mm)</strong> biometric headshot for a visa form, exceeding 51,200 bytes (50KB) causes immediate portal upload failure.
  </p>
  <p class="seo-p">
    Unlike low-resolution signature files, a 50KB facial photograph must pass automated <strong>ICAO 9303 facial biometrics and AI liveness/quality checks</strong>. If a generic compressor strips too much high-frequency detail, artifacts appear around the iris, eyeglasses, and ear contours—flagging your photo for manual rejection. PdfAndImg's 50KB Target-Lock engine uses an 8-pass binary search over the HTML5 Canvas JPEG quantization matrix to lock your portrait between <strong>46.5KB and 49.4KB</strong>, preserving natural skin tones, sharp interpupillary eye distance, and a clean uniform white background.
  </p>

  <div style="overflow-x: auto; margin: 28px 0; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface-1);">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-surface-2); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--color-lime);">
          <th style="padding: 12px 16px;">Application / Portal Category</th>
          <th style="padding: 12px 16px;">Physical Print Size</th>
          <th style="padding: 12px 16px;">Standard Pixel Spec (300 DPI)</th>
          <th style="padding: 12px 16px;">Accepted Byte Range</th>
        </tr>
      </thead>
      <tbody style="color: var(--color-ink-2); font-family: var(--font-mono); font-size: 0.8125rem;">
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">Indian Passport Seva / e-Visa</td>
          <td style="padding: 12px 16px;">3.5 × 4.5 cm (or 2 × 2 in)</td>
          <td style="padding: 12px 16px;">350 × 450 px / 600 × 600 px</td>
          <td style="padding: 12px 16px;">20KB – 50KB (JPEG)</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">PAN Card (Protean NSDL / UTIITSL)</td>
          <td style="padding: 12px 16px;">3.5 × 2.5 cm</td>
          <td style="padding: 12px 16px;">213 × 213 px (200 DPI)</td>
          <td style="padding: 12px 16px;">Under 50KB (Photo & Sign)</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">University Admissions & Counseling</td>
          <td style="padding: 12px 16px;">3.5 × 4.5 cm</td>
          <td style="padding: 12px 16px;">200 × 230 px to 413 × 531 px</td>
          <td style="padding: 12px 16px;">10KB – 50KB (Strict Max)</td>
        </tr>
        <tr>
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">US / Schengen / Canada Visa Portals</td>
          <td style="padding: 12px 16px;">2 × 2 inch / 35 × 45 mm</td>
          <td style="padding: 12px 16px;">600 × 600 px / 413 × 531 px</td>
          <td style="padding: 12px 16px;">Under 50KB – 240KB</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h3 class="seo-h3" style="margin-top: 32px;">Optimizing 3.5×4.5cm & 2×2 Inch Studio Portraits Without Pixelation</h3>
  <p class="seo-p">
    When photo studios hand you a digital copy of your passport photo on a USB drive or via WhatsApp/Email, the raw file is often a 2.5MB DSLR capture or a lossless PNG. Uploading a PNG to a government portal that only accepts <code>.jpg/.jpeg</code> under 50KB will fail immediately. By selecting <strong>JPG</strong> in the output format selector above and keeping the target at <strong>50KB</strong>, our tool automatically flattens any alpha transparency onto a pure white (#FFFFFF) canvas, strips bulky camera EXIF/ICC profile headers, and delivers a studio-grade portrait ready for instant submission.
  </p>
`;

const customFaqs = [
  {
    q: "How do I compress a 3.5×4.5cm or 2×2 inch passport photo to 50KB without losing facial clarity?",
    a: "Drop your studio or smartphone portrait into the uploader above and leave the target set to 50KB. Our algorithm removes hidden EXIF camera metadata first and then binary-searches the highest possible JPEG quality factor (typically 82%–91% quality at standard passport dimensions) so your eyes, ears, and facial features remain razor-sharp at ~48KB."
  },
  {
    q: "Why do university admission and government portals require a 20KB to 50KB range?",
    a: "Portals enforce a 20KB lower bound to prevent candidates from uploading tiny, unreadable thumbnail images, and a 50KB upper bound to keep database storage and admit-card PDF generation fast across millions of applicants. Compressing to 50KB on PdfAndImg places your file around 47KB–49KB, comfortably satisfying both the 20KB minimum and 50KB maximum."
  },
  {
    q: "Can I convert an iPhone HEIC or studio PNG headshot to a 50KB JPG here?",
    a: "Yes. PNG and WebP files can be dropped directly into this 50KB compressor and exported as a compliant JPG by choosing 'JPG' in the Output Format dropdown. If you have a raw iPhone .HEIC file, convert it first using our HEIC to JPG tool or Master Converter, then lock it to 50KB."
  },
  {
    q: "Does compressing my visa or passport photo to 50KB alter its aspect ratio?",
    a: "No. Our 50KB compressor preserves your exact original aspect ratio (whether 3.5:4.5 for Indian/Schengen passports or 1:1 square for 2×2 inch US visas) so your head-to-chin biometric proportions are never stretched or distorted."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div style="padding-top: 40px; padding-bottom: 80px;">
    <div style="text-align: center; max-width: 760px; margin: 0 auto 40px; padding: 0 24px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">
          Target-Lock Engine: 50KB Exact
        </span>
      </div>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.25rem, 5.5vw, 3.75rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 16px; color: var(--color-ink);">
        Compress Image to <span style="color: var(--color-lime);">50KB</span> Online
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-ink-2); max-width: 560px; margin: 0 auto; line-height: 1.65;">
        Optimize 3.5×4.5cm and 2×2 inch passport photos, online visa portraits, and university admission headshots to under 50KB locally in your browser.
      </p>
    </div>

    <Compressor defaultKB={50} hideHeader={true} allowMultiple={true} />

    <AdSlot format="horizontal" />

    <SEOContent
      targetKB={50}
      customTitle="The Complete Guide to 50KB Passport Photos, Visa Portraits & Admission Uploads"
      uniqueContent={uniqueContent}
      customFaqs={customFaqs}
    />

    <SmartRelatedTools />
  </div>
</Layout>
