---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';
import SmartRelatedTools from '../components/SmartRelatedTools.astro';
import AdSlot from '../components/AdSlot.astro';

const pageTitle = "Compress Image to 10KB Online — Thumb Impression & Micro-Signature Tool";
const pageDescription = "Compress JPG, PNG, and WEBP images to exact 10KB online for free. Engineered for left thumb impressions, micro-signatures (4KB–12KB), and state scholarship portals.";

const uniqueContent = `
  <p class="seo-p">
    The <strong>10KB file size ceiling (10,240 bytes)</strong> is the most extreme compression threshold used in online recruitment and academic portals. It is specifically mandated for <strong>scanned Left Thumb Impressions (LTI)</strong>, <strong>4KB–12KB micro-signatures</strong> on legacy state university forms, and ultra-low-bandwidth rural e-governance portals (such as regional Ration Card, e-Shram, and state scholarship forms).
  </p>
  <p class="seo-p">
    Because a standard smartphone JPEG header and color table alone can consume 4KB to 6KB of overhead, compressing an image under <strong>10KB</strong> causes ordinary tools to crash or output an unreadable mosaic of pixel blocks. PdfAndImg strips 100% of camera EXIF/ICC overhead and combines adaptive canvas downsampling with high-contrast luminance quantization, locking your thumbprint ridges or ink signature between <strong>8.8KB and 9.8KB</strong>.
  </p>

  <div style="overflow-x: auto; margin: 28px 0; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface-1);">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-surface-2); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--color-lime);">
          <th style="padding: 12px 16px;">Attachment Category</th>
          <th style="padding: 12px 16px;">Typical Portal Requirement</th>
          <th style="padding: 12px 16px;">Recommended Pixel Size</th>
          <th style="padding: 12px 16px;">Target-Lock Output</th>
        </tr>
      </thead>
      <tbody style="color: var(--color-ink-2); font-family: var(--font-mono); font-size: 0.8125rem;">
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">Left Thumb Impression (LTI)</td>
          <td style="padding: 12px 16px;">State Police, Railway & Clerical Cadres</td>
          <td style="padding: 12px 16px;">240 × 240 px (3.5 × 1.5 cm)</td>
          <td style="padding: 12px 16px;">9.1KB – 9.8KB (JPG)</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">Micro-Signature (4KB – 12KB Rule)</td>
          <td style="padding: 12px 16px;">State CETs & University Exam Forms</td>
          <td style="padding: 12px 16px;">140 × 60 px</td>
          <td style="padding: 12px 16px;">8.5KB – 9.7KB (JPG)</td>
        </tr>
        <tr>
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">SSC / IBPS Signature Lower Floor</td>
          <td style="padding: 12px 16px;">10KB – 20KB Mandatory Window</td>
          <td style="padding: 12px 16px;">140 × 60 px</td>
          <td style="padding: 12px 16px;">Set Target to 12KB–15KB</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h3 class="seo-h3" style="margin-top: 32px;">Critical Tip: 10KB Maximum vs. 10KB Minimum Floor</h3>
  <p class="seo-p">
    Always double-check whether your exam notification states <strong>"up to 10KB"</strong> or <strong>"10KB to 20KB"</strong>. Our 10KB Target-Lock tool is engineered to keep your file <em>strictly under 10,240 bytes</em> (typically ~9.5KB). If your portal requires a minimum of 10KB (such as SSC or IBPS signatures, which mandate 10KB–20KB), change the Target Size box above to <strong>15KB</strong> so your file lands right in the middle of the accepted range.
  </p>
`;

const customFaqs = [
  {
    q: "How do I compress a Left Thumb Impression (LTI) to 10KB without losing ridge lines?",
    a: "Press your thumb lightly on a blue or black stamp pad and roll it cleanly onto bright white unruled paper without smudging. Crop tightly around the oval thumbprint before uploading above. Because minimal white margin surrounds the print, our 10KB engine preserves the fine friction ridges clearly at ~9.4KB."
  },
  {
    q: "Why did my SSC/IBPS portal say 'File size must be greater than 10KB' when I used the 10KB tool?",
    a: "A 10KB target locks the file slightly *below* 10.0KB (around 9.4KB to 9.8KB) so it never exceeds a 10KB ceiling. If your portal has a 10KB–20KB window where 10KB is the minimum floor, simply type '15' in the Target Size box above or use our 15KB optimizer."
  },
  {
    q: "Can a full-body photograph be compressed to 10KB?",
    a: "Yes, our Smart Scaling algorithm will downscale the pixel dimensions until the image fits under 10KB. However, for facial ID photos, 10KB is only intended for small thumbnail dimensions (such as 100×120 px or 150×200 px)."
  },
  {
    q: "Is my biometric thumb impression stored anywhere when I use this tool?",
    a: "Never. Biometric thumbprints are sensitive permanent identifiers. PdfAndImg processes your thumb impression 100% locally inside your browser's RAM using the HTML5 Canvas API—zero data ever leaves your device."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div style="padding-top: 40px; padding-bottom: 80px;">
    <div style="text-align: center; max-width: 760px; margin: 0 auto 40px; padding: 0 24px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">
          Target-Lock Engine: 10KB Exact
        </span>
      </div>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.25rem, 5.5vw, 3.75rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 16px; color: var(--color-ink);">
        Compress Image to <span style="color: var(--color-lime);">10KB</span> Online
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-ink-2); max-width: 560px; margin: 0 auto; line-height: 1.65;">
        Ultra-lightweight in-browser JPEG optimizer calibrated for Left Thumb Impressions (LTI), 4KB–10KB micro-signatures, and state exam portals.
      </p>
    </div>

    <Compressor defaultKB={10} hideHeader={true} allowMultiple={true} />

    <AdSlot format="horizontal" />

    <SEOContent
      targetKB={10}
      customTitle="How to Compress Left Thumb Impressions & Micro-Signatures to 10KB"
      uniqueContent={uniqueContent}
      customFaqs={customFaqs}
    />

    <SmartRelatedTools />
  </div>
</Layout>
