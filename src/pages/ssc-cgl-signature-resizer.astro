---
import Layout from '../layouts/Layout.astro';
import ExamResizer from '../components/ExamResizer.astro';
import SEOContent from '../components/SEOContent.astro';

const SEO_TITLE = "SSC CGL Signature Resizer - Convert to 10-20KB (140x60px)";
const SEO_DESC = "Free SSC CGL signature resizer tool. Compress your signature to exactly 10KB-20KB and 140x60 pixels for instant approval.";
---

<Layout title={SEO_TITLE} description={SEO_DESC} showMesh={true}>
  <!-- Tool Section -->
  <section class="relative z-20 pt-16 container-stripe">
    <div style="text-align: center; margin-bottom: 32px;">
      <div style="display: inline-block; padding: 6px 16px; background: rgba(200, 241, 53, 0.1); border: 1px solid rgba(200, 241, 53, 0.3); border-radius: 100px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--color-lime); margin-bottom: 16px;">
        NO SIGNUP REQUIRED
      </div>
      <h1 style="font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: 1.05; margin: 0 0 16px; letter-spacing: -0.02em;">
        SSC CGL <span style="color: var(--color-lime);">Signature Resizer</span>
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-ink-2); max-width: 600px; margin: 0 auto; line-height: 1.65;">
        Don't let a blurry signature reject your form. Resize your SSC CGL signature to exactly 140x60 pixels and under 20KB.
      </p>
    </div>
    
    <ExamResizer defaultExam="ssc" defaultType="signature" allowMultiple={true} />
  </section>

  <!-- SEO Content Section -->
  <SEOContent 
    targetKB="10KB - 20KB" 
    customTitle="How to use the SSC CGL Signature Resizer"
    uniqueContent={`
      <p class="seo-p">
        Resizing a signature is often more difficult than resizing a photo because the aspect ratio is very wide. If you use a generic compressor, your signature will look stretched or unreadable, leading to application rejection. Our dedicated <strong>SSC CGL Signature Resizer</strong> maintains the perfect aspect ratio.
      </p>
      <ul class="seo-p" style="list-style-type: disc; margin-left: 20px; margin-bottom: 16px;">
        <li><strong>Allowed File Size:</strong> 10 KB to 20 KB.</li>
        <li><strong>Required Dimensions:</strong> 4.0 cm (width) x 2.0 cm (height) or exactly 140x60 pixels.</li>
        <li><strong>Image Format:</strong> JPEG/JPG.</li>
      </ul>
      <p class="seo-p">
        <strong>Pro Tip for Signatures:</strong> Always sign on a plain white paper using a black ink pen before scanning. Ensure the lighting is bright so the white paper doesn't look gray. Upload it to our tool above, and we will instantly convert it to the strict SSC CGL dimensions without losing clarity.
      </p>
    `}
  />
</Layout>
