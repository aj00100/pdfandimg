---
import Layout from '../layouts/Layout.astro';
import Compressor from '../components/Compressor.astro';
import SEOContent from '../components/SEOContent.astro';
import SmartRelatedTools from '../components/SmartRelatedTools.astro';
import AdSlot from '../components/AdSlot.astro';

const pageTitle = "Compress Image to 500KB Online — International Visas, Property & E-Commerce";
const pageDescription = "Compress high-resolution DSLR and smartphone photos to exact 500KB online for free. Ideal for Australia/Canada visas, MCA/GST filings, and e-commerce product catalogs.";

const uniqueContent = `
  <p class="seo-p">
    The <strong>500KB threshold (0.5 MB / 512,000 bytes)</strong> bridges the gap between strict government document portals and high-resolution commercial workflows. It is the standard upper limit for <strong>international immigration & e-Visa portals (Australia ImmiAccount, UK Gov Visas, Canada IRCC digital photos)</strong>, <strong>corporate/tax filings (GST registration, MCA director KYC, FSSAI licenses, property deed scans)</strong>, and <strong>high-speed e-commerce product galleries (Shopify, WooCommerce, Amazon listings)</strong>.
  </p>
  <p class="seo-p">
    When you shoot a product photo, architectural property image, or full-page color deed on an iPhone or mirrorless camera, the raw file typically weighs <strong>5MB to 15MB</strong>. Compressing that 10MB image down to <strong>500KB</strong> achieves a massive <strong>95% bandwidth reduction</strong> while retaining full 2K/4K retina sharpness, zero visible chroma noise, and fast Core Web Vitals (LCP) loading times.
  </p>

  <div style="overflow-x: auto; margin: 28px 0; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface-1);">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-surface-2); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; color: var(--color-lime);">
          <th style="padding: 12px 16px;">Workflow / Platform</th>
          <th style="padding: 12px 16px;">Use Case</th>
          <th style="padding: 12px 16px;">Typical Resolution Kept</th>
          <th style="padding: 12px 16px;">File Size Reduction</th>
        </tr>
      </thead>
      <tbody style="color: var(--color-ink-2); font-family: var(--font-mono); font-size: 0.8125rem;">
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">Australia / Canada / UK e-Visa</td>
          <td style="padding: 12px 16px;">Biometric Facial Portrait & Passport Bio Page</td>
          <td style="padding: 12px 16px;">1200 × 1600 px+</td>
          <td style="padding: 12px 16px;">6MB → ~485KB (JPG)</td>
        </tr>
        <tr style="border-bottom: 1px solid var(--color-border);">
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">GST / MCA / Income Tax Portals</td>
          <td style="padding: 12px 16px;">Cancelled Cheque, Electricity Bill, Rent Deed</td>
          <td style="padding: 12px 16px;">Full A4 300 DPI Scan</td>
          <td style="padding: 12px 16px;">4.5MB → ~480KB (JPG/PDF)</td>
        </tr>
        <tr>
          <td style="padding: 12px 16px; color: var(--color-ink); font-weight: 600;">E-Commerce & Web Publishing</td>
          <td style="padding: 12px 16px;">2000×2000 px Zoomable Product Shots</td>
          <td style="padding: 12px 16px;">2000 × 2000 px</td>
          <td style="padding: 12px 16px;">8MB PNG → ~475KB WEBP/JPG</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h3 class="seo-h3" style="margin-top: 32px;">Batch-Optimizing E-Commerce & Real Estate Galleries to 500KB</h3>
  <p class="seo-p">
    Uploading uncompressed 8MB studio photos directly to Shopify, WordPress, or real estate listing portals destroys mobile page speed and hurts Google Core Web Vitals rankings. With PdfAndImg, you can drag and drop up to <strong>50 high-resolution product or property images at once</strong>, select <strong>WEBP</strong> or <strong>JPG</strong> in the Output Format menu, lock the ceiling at 500KB, and download a ready-to-publish ZIP archive in seconds.
  </p>
`;

const customFaqs = [
  {
    q: "Will compressing a 10MB camera photo to 500KB cause visible quality loss?",
    a: "No. At 500KB (half a megabyte), a standard 2000×3000 pixel photograph encodes at 88% to 94% JPEG quality. To the human eye, it is visually indistinguishable from the 10MB original, as most of the removed weight comes from redundant high-frequency sensor noise and camera metadata."
  },
  {
    q: "Does the Australian ImmiAccount visa portal require photos under 500KB?",
    a: "Yes. The Australian Department of Home Affairs (ImmiAccount) requires digital passport photographs to be between 70KB and 500KB (maximum) with dimensions between 900×1200 px and 4500×6000 px. Our 500KB optimizer locks your portrait safely around 480KB."
  },
  {
    q: "Should I choose JPG or WEBP when compressing website images to 500KB?",
    a: "For government, tax, and visa portals, always choose JPG. For your own website, blog, or Shopify store, choosing WEBP at 500KB allows even higher pixel resolution and sharper edge detail than JPG at the exact same byte weight."
  },
  {
    q: "Can I convert a scanned cancelled cheque or electricity bill into a 500KB PDF?",
    a: "Yes. Upload the photo of your cancelled cheque or utility bill above, select 'PDF' under Output Format, and click Instant Optimize to generate a GST/KYC-compliant PDF under 500KB."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div style="padding-top: 40px; padding-bottom: 80px;">
    <div style="text-align: center; max-width: 760px; margin: 0 auto 40px; padding: 0 24px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.2); border-radius: 100px; padding: 5px 14px; margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-lime);">
          Target-Lock Engine: 500KB Exact
        </span>
      </div>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.25rem, 5.5vw, 3.75rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 16px; color: var(--color-ink);">
        Compress Image to <span style="color: var(--color-lime);">500KB</span> Online
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-ink-2); max-width: 560px; margin: 0 auto; line-height: 1.65;">
        Shrink 10MB+ DSLR and smartphone photos to under 500KB for Australian/Canadian e-Visas, GST/MCA filings, and e-commerce catalogs.
      </p>
    </div>

    <Compressor defaultKB={500} hideHeader={true} allowMultiple={true} />

    <AdSlot format="horizontal" />

    <SEOContent
      targetKB={500}
      customTitle="High-Resolution 500KB Image Compression for Visas, Tax Filings & E-Commerce"
      uniqueContent={uniqueContent}
      customFaqs={customFaqs}
    />

    <SmartRelatedTools />
  </div>
</Layout>
