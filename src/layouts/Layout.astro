---
// src/layouts/Layout.astro
import '../styles/global.css';
import SmartRelatedTools from '../components/SmartRelatedTools.astro';
import { getLocaleChrome, getHreflangsForPath, SUPPORTED_LOCALES } from '../data/i18nMap';

interface Props {
  title: string;
  description?: string;
  showRelatedTools?: boolean;
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = "Precision image compression. Target any file size.",
  showRelatedTools = true,
  noindex = false,
  lang = "en"
} = Astro.props;

const siteUrl = "https://pdfandimg.com";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '');
const canonicalPath = normalizedPath ? `${normalizedPath}/` : '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();

const chrome = getLocaleChrome(lang, canonicalPath);
const activeLang = chrome.langCode;

// Multi-segment localized BreadcrumbList structured data
const pathSegments = normalizedPath.split('/').filter(Boolean);
const cleanPageName = title.split(/[—|]/)[0].trim();

const breadcrumbItems = [
  { name: chrome.homeLabel, url: `${siteUrl}/` },
  ...(pathSegments.length > 0 ? [{
    name: cleanPageName,
    url: canonicalUrl,
  }] : []),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url,
  })),
};

// Reciprocal Hreflang lookup via centralized matrix (enforcing canonical trailing slashes)
const pageHreflangs = getHreflangsForPath(canonicalPath);
const computedTitle = title.includes('PdfAndImg') ? title : `${title} — PdfAndImg`;
---

<!doctype html>
<html lang={activeLang}>
  <head>
    <meta charset="UTF-8" />
    {pageHreflangs && (
      <>
        {Object.entries(pageHreflangs).map(([hlLang, hlUrl]) => (
          <link rel="alternate" hreflang={hlLang} href={new URL(hlUrl, siteUrl).toString()} />
        ))}
      </>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="msvalidate.01" content="E83688B2D84F2650E3B27304930BD2B7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{computedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={computedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={computedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S9WR64YT2D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S9WR64YT2D');
    </script>

    <!-- BreadcrumbList structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>

  <body>
    <div class="noise-overlay" aria-hidden="true"></div>

    <div
      aria-hidden="true"
      style="
        position: fixed;
        top: -200px;
        left: -200px;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(200,241,53,0.07) 0%, transparent 65%);
        pointer-events: none;
        z-index: 0;
      "
    ></div>

    <!-- Navigation -->
    <header
      style="
        height: 64px;
        display: flex;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid var(--color-border);
        background: rgba(10,10,11,0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      "
    >
      <div
        style="
          max-width: 1100px;
          margin: 0 auto;
          padding: 0 24px;
          width: 100%;
          display: flex;
          align-items: center;
          justify-content: space-between;
        "
      >
        <a
          href="/"
          style="display: flex; align-items: center; gap: 10px; text-decoration: none;"
          aria-label="PdfAndImg"
        >
          <div class="logo-mark">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path
                d="M3 14V15.5C3 16.33 3.67 17 4.5 17H13.5C14.33 17 15 16.33 15 15.5V14M9 1V11.5M9 1L5.5 4.5M9 1L12.5 4.5"
                stroke="#0a0a0b"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <span
            style="
              font-family: var(--font-display);
              font-size: 1.125rem;
              font-weight: 800;
              letter-spacing: -0.04em;
              color: var(--color-ink);
            "
          >PdfAndImg</span>
        </a>

        <nav style="display: flex; align-items: center; gap: 6px;">
          <!-- Mobile Localized Dropdown -->
          <details class="show-mobile-only mobile-menu" style="position: relative;">
            <summary class="nav-link" style="color: var(--color-lime); cursor: pointer; list-style: none;">
              {chrome.toolsDropdownLabel}
            </summary>
            <div style="position: absolute; top: 100%; right: 0; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; min-width: 190px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); z-index: 200; margin-top: 12px;">
              {chrome.navLinks.map(link => (
                <a
                  href={link.href}
                  class="nav-link nav-highlight-lime"
                  style={`text-align: left; ${link.highlight ? 'font-weight: 700; color: var(--color-lime);' : ''}`}
                >
                  {link.label}
                </a>
              ))}
              <hr style="border: none; border-top: 1px solid var(--color-border); margin: 4px 0;" />
              {chrome.companyLinks.map(link => (
                <a href={link.href} class="nav-link nav-highlight-lime" style="text-align: left;">
                  {link.label}
                </a>
              ))}
            </div>
          </details>

          <!-- Desktop Localized Links -->
          {chrome.navLinks.map(link => (
            <a
              href={link.href}
              class="nav-link hide-mobile nav-highlight-lime"
              style={`position: relative; ${link.highlight ? 'font-weight: 700;' : ''}`}
            >
              {link.label}
            </a>
          ))}

          <!-- Legal Dropdown -->
          <details class="hide-mobile mobile-menu" style="position: relative;">
            <summary class="nav-link nav-highlight-lime" style="cursor: pointer; list-style: none;">
              {chrome.moreDropdownLabel}
            </summary>
            <div style="position: absolute; top: 100%; right: 0; background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; min-width: 190px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); z-index: 200; margin-top: 12px;">
              {chrome.companyLinks.map(link => (
                <a href={link.href} class="nav-link nav-highlight-lime" style="text-align: left;">
                  {link.label}
                </a>
              ))}
            </div>
          </details>

          <a
            href="/"
            class="btn-primary"
            style="padding: 8px 18px; font-size: 0.875rem; margin-left: 8px; box-shadow: 0 0 15px rgba(200, 241, 53, 0.15);"
          >{chrome.homeLabel}</a>
        </nav>
      </div>
    </header>

    <main style="position: relative; z-index: 10; padding: 48px 0 80px;">
      <slot />
    </main>

    {showRelatedTools && <SmartRelatedTools lang={activeLang} />}

    <footer style="position: relative; z-index: 10; padding-bottom: 48px;">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 24px;">
        <hr class="footer-divider" />

        <div class="footer-grid">
          <!-- Brand -->
          <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
              <div class="logo-mark">
                <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
                  <path d="M3 14V15.5C3 16.33 3.67 17 4.5 17H13.5C14.33 17 15 16.33 15 15.5V14M9 1V11.5M9 1L5.5 4.5M9 1L12.5 4.5" stroke="#0a0a0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span
                style="
                  font-family: var(--font-display);
                  font-weight: 800;
                  font-size: 1.0625rem;
                  letter-spacing: -0.04em;
                  color: var(--color-ink);
                "
              >PdfAndImg</span>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-ink-2); line-height: 1.7; max-width: 280px;">
              {chrome.footerTagline}
            </p>
          </div>

          <!-- Localized Tools Column -->
          <div>
            <p
              style="
                font-family: var(--font-mono);
                font-size: 0.6875rem;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: var(--color-ink-3);
                margin-bottom: 16px;
              "
            >{chrome.footerToolsHeading}</p>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
              {chrome.footerToolLinks.map(item => (
                <li>
                  <a
                    href={item.href}
                    class="nav-link"
                    style={`padding: 0; border: none; color: var(--color-lime); ${item.highlight ? 'font-weight: 700;' : ''}`}
                  >
                    <span class="hide-mobile">{item.label}</span>
                    <span class="show-mobile-only">{item.mobileLabel || item.label}</span>
                  </a>
                </li>
              ))}
              <li style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--color-border);">
                <a href="/tools/" class="nav-link" style="padding: 0; border: none; font-weight: 700; color: var(--color-ink);">
                  {chrome.footerViewAllTools}
                </a>
              </li>
            </ul>
          </div>

          <!-- Localized Company Column -->
          <div>
            <p
              style="
                font-family: var(--font-mono);
                font-size: 0.6875rem;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: var(--color-ink-3);
                margin-bottom: 16px;
              "
            >{chrome.footerCompanyHeading}</p>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
              {chrome.companyLinks.map(item => (
                <li>
                  <a href={item.href} class="nav-link" style="padding: 0; border: none;">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <hr class="footer-divider" />

        <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 24px; flex-wrap: wrap; gap: 16px;">
          <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3);">
            {chrome.footerCopyright}
          </p>

          <!-- Region / Locale Switcher -->
          {pageHreflangs && (
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <span style="font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-ink-3);">Region:</span>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                {SUPPORTED_LOCALES.filter(l => pageHreflangs[l.code]).map(l => (
                  <a
                    href={pageHreflangs[l.code]}
                    class={`locale-pill ${activeLang === l.code ? 'active' : ''}`}
                    style={`
                      font-size: 0.75rem;
                      padding: 4px 10px;
                      border-radius: 999px;
                      text-decoration: none;
                      background: ${activeLang === l.code ? 'rgba(200,241,53,0.15)' : 'var(--color-surface-2)'};
                      border: 1px solid ${activeLang === l.code ? 'var(--color-lime)' : 'var(--color-border)'};
                      color: ${activeLang === l.code ? 'var(--color-lime)' : 'var(--color-ink-2)'};
                      font-weight: ${activeLang === l.code ? '700' : '400'};
                      display: inline-flex;
                      align-items: center;
                      gap: 4px;
                    `}
                  >
                    <span>{l.flag}</span>
                    <span>{l.label}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </footer>

    <script>
      document.addEventListener('click', (e) => {
        const detailsElements = document.querySelectorAll('.mobile-menu');
        detailsElements.forEach(details => {
          if (details.hasAttribute('open') && !details.contains(e.target as Node)) {
            details.removeAttribute('open');
          }
        });
      });
    </script>
  </body>
</html>
