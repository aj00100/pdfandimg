---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Precision image compression. Target any file size." } = Astro.props;

// Canonical URL Logic
const siteUrl = "https://imgshrink.com";
const path = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = new URL(path || '/', siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title} — ImgShrink</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} — ImgShrink`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} — ImgShrink`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- Fonts: Syne (display) + DM Sans (body) + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700;800&family=Outfit:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Atmospheric layers -->
    <div class="noise-overlay" aria-hidden="true"></div>

    <!-- Glow accent top-left -->
    <div
      aria-hidden="true"
      style="
        position: fixed;
        top: -200px;
        left: -200px;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(200,241,53,0.07) 0%, transparent 65%);
        pointer-events: none;
        z-index: 0;
      "
    ></div>

    <!-- Navigation -->
    <header
      style="
        height: 64px;
        display: flex;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid var(--color-border);
        background: rgba(10,10,11,0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      "
    >
      <div
        style="
          max-width: 1100px;
          margin: 0 auto;
          padding: 0 24px;
          width: 100%;
          display: flex;
          align-items: center;
          justify-content: space-between;
        "
      >
        <!-- Logo -->
        <a
          href="/"
          style="display: flex; align-items: center; gap: 10px; text-decoration: none;"
        >
          <div class="logo-mark">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path
                d="M3 14V15.5C3 16.33 3.67 17 4.5 17H13.5C14.33 17 15 16.33 15 15.5V14M9 1V11.5M9 1L5.5 4.5M9 1L12.5 4.5"
                stroke="#0a0a0b"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <span
            style="
              font-family: var(--font-display);
              font-size: 1.125rem;
              font-weight: 800;
              letter-spacing: -0.04em;
              color: var(--color-ink);
            "
          >ImgShrink</span>
        </a>

        <!-- Nav links -->
        <nav style="display: flex; align-items: center; gap: 6px;">
          <a href="/tools" class="nav-link show-mobile-only" style="color: var(--color-lime);">Tools</a>
          <a href="/enhance-image-size" class="nav-link hide-mobile nav-highlight-lime" style="position: relative;">
            Enhance KB
            <span class="new-tag">NEW</span>
          </a>
          <a href="/crop-image" class="nav-link hide-mobile nav-highlight-lime" style="position: relative;">
            Crop Image
            <span class="new-tag">NEW</span>
          </a>
          <a href="/compress-image-to-20kb" class="nav-link hide-mobile">20 KB</a>
          <a href="/compress-image-to-50kb" class="nav-link hide-mobile">50 KB</a>
          <a href="/compress-image-to-100kb" class="nav-link hide-mobile">100 KB</a>
          <a
            href="/"
            class="btn-primary"
            style="padding: 8px 18px; font-size: 0.875rem; margin-left: 8px; box-shadow: 0 0 15px rgba(200, 241, 53, 0.15);"
          >HOME</a>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main style="position: relative; z-index: 10; padding: 48px 0 80px;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="position: relative; z-index: 10; padding-bottom: 48px;">
      <div
        style="
          max-width: 1100px;
          margin: 0 auto;
          padding: 0 24px;
        "
      >
        <hr class="footer-divider" />

        <div
          style="
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 48px;
            padding-top: 48px;
            margin-bottom: 48px;
          "
        >
          <!-- Brand -->
          <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
              <div class="logo-mark">
                <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
                  <path d="M3 14V15.5C3 16.33 3.67 17 4.5 17H13.5C14.33 17 15 16.33 15 15.5V14M9 1V11.5M9 1L5.5 4.5M9 1L12.5 4.5" stroke="#0a0a0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span
                style="
                  font-family: var(--font-display);
                  font-weight: 800;
                  font-size: 1.0625rem;
                  letter-spacing: -0.04em;
                  color: var(--color-ink);
                "
              >ImgShrink</span>
            </div>
            <p
              style="
                font-size: 0.875rem;
                color: var(--color-ink-2);
                line-height: 1.7;
                max-width: 280px;
              "
            >
              Precision image optimization for professionals.
              Target any file size with mathematical accuracy.
            </p>
          </div>

          <!-- Tools -->
          <div>
            <p
              style="
                font-family: var(--font-mono);
                font-size: 0.6875rem;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: var(--color-ink-3);
                margin-bottom: 16px;
              "
            >Tools</p>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
              <li><a href="/reduce-image-size-in-kb" class="nav-link" style="padding: 0; border: none; color: var(--color-lime);">
                <span class="hide-mobile">Reduce Image Size in KB</span>
                <span class="show-mobile-only">Reduce KB Size</span>
              </a></li>
              <li><a href="/enhance-image-size" class="nav-link" style="padding: 0; border: none; color: var(--color-lime);">
                <span class="hide-mobile">Increase Image Size in KB</span>
                <span class="show-mobile-only">Increase KB Size</span>
              </a></li>
              <li><a href="/png-to-jpg" class="nav-link" style="padding: 0; border: none; color: var(--color-lime);">
                <span class="hide-mobile">Convert PNG to JPG</span>
                <span class="show-mobile-only">PNG to JPG</span>
              </a></li>
              <li><a href="/jpg-to-pdf" class="nav-link" style="padding: 0; border: none; color: var(--color-lime);">
                <span class="hide-mobile">Convert JPG to PDF</span>
                <span class="show-mobile-only">JPG to PDF</span>
              </a></li>
              <li><a href="/passport-size-photo" class="nav-link" style="padding: 0; border: none;">Passport Size Photo</a></li>
              <li style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--color-border);">
                <a href="/tools" class="nav-link" style="padding: 0; border: none; font-weight: 700; color: var(--color-ink);">View all tools →</a>
              </li>
            </ul>
          </div>

          <!-- Company -->
          <div>
            <p
              style="
                font-family: var(--font-mono);
                font-size: 0.6875rem;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: var(--color-ink-3);
                margin-bottom: 16px;
              "
            >Company</p>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
              <li><a href="/about" class="nav-link" style="padding: 0; border: none;">About Precision</a></li>
              <li><a href="/contact" class="nav-link" style="padding: 0; border: none;">Contact Us</a></li>
              <li><a href="/privacy" class="nav-link" style="padding: 0; border: none;">Privacy Protocol</a></li>
              <li><a href="/terms" class="nav-link" style="padding: 0; border: none;">Terms of Service</a></li>
            </ul>

          </div>
        </div>

        <hr class="footer-divider" />

        <div
          style="
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 24px;
          "
        >
          <p
            style="
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--color-ink-3);
            "
          >© 2026 ImgShrink — All rights reserved</p>
        </div>
      </div>
    </footer>
  </body>
</html>
