---
interface Props {
  defaultTargetKB?: number;
}
const { defaultTargetKB = 100 } = Astro.props;
---

<div id="jpg-pdf-root" style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
  <div class="panel p-5 md:p-8">
    
    <div style="display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 120px;">
        <label for="jpg-pdf-target" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; color: var(--color-ink-3); margin-bottom: 8px; text-align: center;">Target Size (KB)</label>
        <input type="number" id="jpg-pdf-target" class="input-number" value={defaultTargetKB} style="width: 100%; height: 56px; font-size: 1.5rem; text-align: center; background: var(--color-surface-1); border: 2px solid var(--color-border); border-radius: 12px; color: var(--color-ink); outline: none;" />
      </div>
    </div>

    <div id="jpg-pdf-drop-zone" class="drop-zone" style="min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 24px; position: relative; border-radius: 16px;">
      <input type="file" id="jpg-pdf-file-input" style="display: none;" accept="image/jpeg, image/png, image/webp" />
      
      <div id="jpg-pdf-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">Select Image</p>
          <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin: 0;">to convert to exactly target KB PDF</p>
        </div>
        <button onclick="document.getElementById('jpg-pdf-file-input').click()" class="btn-ghost" type="button" style="font-size: 0.75rem; z-index: 10;">Browse files</button>
      </div>

      <div id="jpg-pdf-preview-container" class="hidden" style="position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; background: var(--color-surface-2); border-radius: 14px; z-index: 5;">
        <img id="jpg-pdf-preview-img" style="max-height: 160px; object-fit: contain; border-radius: 8px; margin-bottom: 12px;" />
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); text-align: center;">
          <strong id="jpg-pdf-filename" style="display: block; margin-bottom: 4px;"></strong>
          <span id="jpg-pdf-original-size" style="color: var(--color-ink-2);"></span>
        </div>
        <button id="jpg-pdf-change-btn" class="btn-ghost" type="button" style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem; z-index: 10;">Change</button>
      </div>
    </div>

    <button id="jpg-pdf-convert-btn" class="btn-primary" disabled style="width: 100%; height: 56px; font-size: 1rem; display: flex; align-items: center; justify-content: center; gap: 8px;" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
      Instant PDF
    </button>
  </div>

  <div id="jpg-pdf-status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px;">
      <div id="jpg-pdf-processing" class="hidden" style="flex-direction: column; width: 100%; gap: 16px; padding: 16px 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); text-align: center;" id="jpg-pdf-status-text">Processing...</div>
        <div style="width: 100%; max-width: 500px; margin: 0 auto; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden;">
          <div id="jpg-pdf-progress-bar" style="width: 0%; height: 100%; background: currentColor; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div id="jpg-pdf-result-view" class="hidden flex-col gap-8 items-center w-full text-center">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Conversion Complete!</h2>
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink-2);">
          Final PDF Size: <strong id="jpg-pdf-final-size" style="color: var(--color-ink);"></strong>
        </div>
        <a id="jpg-pdf-download-link" href="#" class="btn-download" style="width: 100%; max-width: 400px; height: 56px; font-size: 1rem;">
          Download PDF
        </a>
        <button id="jpg-pdf-reset-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">
          ← Convert another image
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { jsPDF } from "jspdf";

  const root = document.getElementById('jpg-pdf-root') as HTMLDivElement;
  if (root) {
    const blobUrlsToRevoke: string[] = [];
    const dropZone = document.getElementById('jpg-pdf-drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('jpg-pdf-file-input') as HTMLInputElement;
    const placeholder = document.getElementById('jpg-pdf-upload-placeholder') as HTMLDivElement;
    const previewContainer = document.getElementById('jpg-pdf-preview-container') as HTMLDivElement;
    const previewImg = document.getElementById('jpg-pdf-preview-img') as HTMLImageElement;
    const fileNameText = document.getElementById('jpg-pdf-filename') as HTMLSpanElement;
    const originalSizeText = document.getElementById('jpg-pdf-original-size') as HTMLSpanElement;
    const changeBtn = document.getElementById('jpg-pdf-change-btn') as HTMLButtonElement;
    const convertBtn = document.getElementById('jpg-pdf-convert-btn') as HTMLButtonElement;
    const targetInput = document.getElementById('jpg-pdf-target') as HTMLInputElement;
    
    const statusPanel = document.getElementById('jpg-pdf-status-panel') as HTMLDivElement;
    const processing = document.getElementById('jpg-pdf-processing') as HTMLDivElement;
    const progressBar = document.getElementById('jpg-pdf-progress-bar') as HTMLDivElement;
    const statusText = document.getElementById('jpg-pdf-status-text') as HTMLDivElement;
    const resultView = document.getElementById('jpg-pdf-result-view') as HTMLDivElement;
    const finalSizeText = document.getElementById('jpg-pdf-final-size') as HTMLSpanElement;
    const downloadLink = document.getElementById('jpg-pdf-download-link') as HTMLAnchorElement;
    const resetBtn = document.getElementById('jpg-pdf-reset-btn') as HTMLButtonElement;

    let selectedFile: File | null = null;
    let canvas: HTMLCanvasElement | null = null;

    dropZone.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('button')) {
        fileInput.value = ''; fileInput.click();
      }
    });
    
    changeBtn.addEventListener('click', (e) => {
      blobUrlsToRevoke.forEach(u => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      e.stopPropagation();
      fileInput.value = ''; fileInput.click();
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('active');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('active');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('active');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', (e: any) => {
      const files = e.target.files;
      if (files && files.length > 0) handleFile(files[0]);
    });

    function handleFile(file: File) {
      if (!file.type.startsWith('image/')) {
        alert("Please select a valid image file.");
        return;
      }

      selectedFile = file;
      
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          canvas = document.createElement('canvas');
          canvas.width = img.width;
          canvas.height = img.height;
          const ctx = canvas.getContext('2d');
          if (ctx) ctx.drawImage(img, 0, 0);
          
          previewImg.src = e.target?.result as string;
          placeholder.classList.add('hidden');
          previewContainer.classList.remove('hidden');
          fileNameText.textContent = file.name;
          originalSizeText.textContent = `Original Size: ${(file.size / 1024).toFixed(2)} KB`;
          convertBtn.disabled = false;
          statusPanel.classList.add('hidden');
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    }

    convertBtn.addEventListener('click', async () => {
      if (!selectedFile || !canvas) return;
      
      const targetKB = parseFloat(targetInput.value);
      if (isNaN(targetKB) || targetKB <= 0) {
        alert("Please enter a valid target KB.");
        return;
      }
      
      const targetBytes = targetKB * 1024;
      
      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      resultView.classList.add('hidden');
      convertBtn.disabled = true;
      statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        statusText.textContent = 'Locking target size...';
        progressBar.style.width = '20%';
        
        let bestPdfBlob: Blob | null = null;
        let minQ = 0.05;
        let maxQ = 0.95;
        let currentQ = 0.5;
        
        // Binary search for perfect JPEG quality
        for (let iteration = 0; iteration < 8; iteration++) {
          const doc = new jsPDF({
            orientation: canvas.width > canvas.height ? 'l' : 'p',
            unit: 'px',
            format: [canvas.width, canvas.height]
          });
          
          const dataUrl = canvas.toDataURL('image/jpeg', currentQ);
          doc.addImage(dataUrl, 'JPEG', 0, 0, canvas.width, canvas.height);
          
          const testBlob = doc.output('blob');
          const testSize = testBlob.size;
          
          if (testSize <= targetBytes) {
            bestPdfBlob = testBlob;
            minQ = currentQ; // try to get better quality
            currentQ = (minQ + maxQ) / 2;
          } else {
            maxQ = currentQ;
            currentQ = (minQ + maxQ) / 2;
          }
          
          progressBar.style.width = `${20 + Math.round((iteration / 8) * 70)}%`;
          await new Promise(r => setTimeout(r, 0)); // let UI update instantly
        }
        
        // If we still didn't find one that fits, try worst quality
        if (!bestPdfBlob) {
           const doc = new jsPDF({
              orientation: canvas.width > canvas.height ? 'l' : 'p',
              unit: 'px',
              format: [canvas.width, canvas.height]
            });
            const dataUrl = canvas.toDataURL('image/jpeg', 0.01);
            doc.addImage(dataUrl, 'JPEG', 0, 0, canvas.width, canvas.height);
            bestPdfBlob = doc.output('blob');
        }

        statusText.textContent = 'Padding metadata...';
        progressBar.style.width = '95%';

        let finalBlob = bestPdfBlob;
        
        // Pad the PDF to exactly target size if it's smaller
        if (finalBlob && finalBlob.size < targetBytes) {
          const diff = targetBytes - finalBlob.size;
          const padding = new Uint8Array(diff);
          padding.fill(32); // 32 is space character
          if (diff >= 2) {
            padding[0] = 10; // \n
            padding[1] = 37; // %
          }
          finalBlob = new Blob([finalBlob, padding], { type: 'application/pdf' });
        }

        progressBar.style.width = '100%';
        statusText.textContent = 'Done!';

        if (finalBlob) {
          const finalSizeKB = (finalBlob.size / 1024).toFixed(2);
          finalSizeText.textContent = `${finalSizeKB} KB`;
          
          const url = URL.createObjectURL(finalBlob);
          blobUrlsToRevoke.push(url);
          downloadLink.href = url;
          const originalName = (selectedFile.name.substring(0, selectedFile.name.lastIndexOf('.')) || selectedFile.name);
          downloadLink.download = `${originalName}_${targetKB}kb.pdf`;
          
          processing.classList.add('hidden');
          resultView.classList.remove('hidden');
          resultView.style.display = 'flex';
        }

      } catch (err: any) {
        console.error(err);
        alert(err?.message || 'Conversion failed.');
        processing.classList.add('hidden');
      } finally {
        convertBtn.disabled = false;
      }
    });

    resetBtn.addEventListener('click', () => {
      blobUrlsToRevoke.forEach(u => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      selectedFile = null;
      canvas = null;
      previewContainer.classList.add('hidden');
      placeholder.classList.remove('hidden');
      statusPanel.classList.add('hidden');
      convertBtn.disabled = true;
      fileInput.value = '';
    });
  }
</script>
