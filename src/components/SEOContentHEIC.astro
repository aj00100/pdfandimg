---
interface Props {
  toolName: 'convert-heic' | 'convert-heic-to-png' | 'convert-heic-to-pdf';
}

const { toolName } = Astro.props;

let targetFormat = 'JPG';
let title = 'Convert HEIC to JPG Online Free';
let descFormat = 'JPG';

if (toolName === 'convert-heic-to-png') {
  targetFormat = 'PNG';
  title = 'Convert HEIC to PNG Online Free';
  descFormat = 'PNG';
} else if (toolName === 'convert-heic-to-pdf') {
  targetFormat = 'PDF';
  title = 'Convert HEIC to PDF Online Free';
  descFormat = 'PDF';
}

const content = {
  title: title,
  desc: `Change Apple iPhone HEIC/HEIF photos to universally compatible ${descFormat} format. 100% free and processed securely on your local device.`,
  h2: `Convert iPhone HEIC Photos to ${targetFormat} Securely`,
  p1: `Apple iPhones save high-quality photos in the HEIC format to save storage space. However, many government portals, job applications, and older software do not accept HEIC files. Our offline converter instantly changes your HEIC photos to standard ${targetFormat} format without forcing you to upload your personal pictures to a cloud server.`,
  faq1: { q: 'Are my personal photos uploaded anywhere?', a: 'No. Our converter runs completely in your web browser using WebAssembly. Your photos never leave your device.' },
  faq2: { q: 'Will the conversion lose quality?', a: `We use high-quality rendering algorithms to ensure the resulting ${targetFormat} looks exactly like your original HEIC photo.` }
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": content.faq1.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": content.faq1.a
      }
    },
    {
      "@type": "Question",
      "name": content.faq2.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": content.faq2.a
      }
    }
  ]
};

const relatedTools = [
  { name: 'Compress Image', href: '/compress-image-to-20kb' },
  { name: 'Convert PNG to JPG', href: '/png-to-jpg' },
  { name: 'Convert JPEG to PNG', href: '/jpeg-to-png' }
];
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<section class="seo-section">
  <div class="seo-divider"></div>
  <div class="seo-grid">
    <div class="seo-main">
      <div class="seo-intro">
        <h2 class="seo-h2">{content.h2}</h2>
        <p class="seo-p">{content.p1}</p>
        <p class="seo-p">With ImgShrink's Zero-Server architecture, you can batch convert your files instantly without worrying about privacy leaks or waiting for slow uploads.</p>
      </div>

      <div class="seo-steps">
        <h3 class="seo-h3">How Our Zero-Server Converter Works</h3>
        <ol class="seo-list">
          <li>
            <div class="seo-step-num">01</div>
            <div>
              <h4 class="seo-step-title">Local Reading</h4>
              <p class="seo-p-small">Your HEIC files are read securely into your computer's RAM. We never transmit data to the cloud.</p>
            </div>
          </li>
          <li>
            <div class="seo-step-num">02</div>
            <div>
              <h4 class="seo-step-title">WebAssembly Decoding</h4>
              <p class="seo-p-small">Your browser runs an advanced decoding engine locally to translate the HEIC structure into standard pixels.</p>
            </div>
          </li>
          <li>
            <div class="seo-step-num">03</div>
            <div>
              <h4 class="seo-step-title">Instant {targetFormat} Download</h4>
              <p class="seo-p-small">The pixels are immediately compiled into a fresh {targetFormat} and downloaded back to your hard drive.</p>
            </div>
          </li>
        </ol>
      </div>

      <div class="seo-faq">
        <h3 class="seo-h3">Frequently Asked Questions</h3>
        <div class="faq-stack">
          <div class="faq-item">
            <h4 class="faq-q">{content.faq1.q}</h4>
            <p class="faq-a">{content.faq1.a}</p>
          </div>
          <div class="faq-item">
            <h4 class="faq-q">{content.faq2.q}</h4>
            <p class="faq-a">{content.faq2.a}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="seo-sidebar">
      <div class="sidebar-box">
        <h3 class="sidebar-title">Privacy Assured</h3>
        <ul class="sidebar-list">
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>100% Offline Processing</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>No Cloud Uploads</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>No Registration</span>
          </li>
        </ul>
      </div>

      <div class="sidebar-box" style="margin-top: 40px;">
        <h3 class="sidebar-title">Image Tools</h3>
        <div style="display: grid; grid-template-columns: 1fr; gap: 10px;">
          {relatedTools.map(tool => (
            <a href={tool.href} class="related-tag">{tool.name}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .seo-section { max-width: 1000px; margin: 80px auto 0; padding: 0 24px; text-align: left; }
  .seo-divider { height: 1px; background: linear-gradient(to right, transparent, var(--color-border), transparent); margin-bottom: 80px; }
  .seo-grid { display: grid; grid-template-columns: 1fr; gap: 80px; }
  @media (min-width: 900px) { .seo-grid { grid-template-columns: 1.8fr 1fr; } }
  .seo-main { display: flex; flex-direction: column; gap: 64px; }
  .seo-h2 { font-family: var(--font-display); font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 32px; color: var(--color-ink); line-height: 1.1; }
  .seo-h3 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin-bottom: 24px; color: var(--color-ink); }
  .seo-p { font-size: 1rem; color: var(--color-ink-2); line-height: 1.8; margin-bottom: 20px; }
  .seo-p-small { font-size: 0.9375rem; color: var(--color-ink-2); line-height: 1.6; }
  .seo-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 32px; }
  .seo-list li { display: flex; gap: 20px; }
  .seo-step-num { flex-shrink: 0; width: 36px; height: 36px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-lime); font-weight: 700; }
  .seo-step-title { font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin-bottom: 8px; }
  .faq-stack { display: flex; flex-direction: column; gap: 40px; }
  .faq-q { color: var(--color-ink); font-weight: 700; font-size: 1.125rem; margin-bottom: 12px; }
  .faq-a { color: var(--color-ink-2); font-size: 0.9375rem; line-height: 1.7; }
  .sidebar-box { background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: 24px; padding: 32px; margin-bottom: 32px; }
  .sidebar-title { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-lime); margin-bottom: 24px; }
  .sidebar-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 20px; }
  .sidebar-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 0.875rem; color: var(--color-ink-2); }
  .check-icon { color: var(--color-lime); margin-top: 2px; }
  .related-tag { display: block; padding: 8px; background: var(--color-surface-3); border: 1px solid var(--color-border); border-radius: 8px; font-size: 0.75rem; color: var(--color-ink-2); text-decoration: none; text-align: center; transition: all 0.2s ease; }
  .related-tag:hover { border-color: var(--color-lime); color: var(--color-lime); transform: translateY(-2px); }
  @media (max-width: 640px) { .seo-h2 { font-size: 1.75rem; } .seo-grid { gap: 48px; } .seo-main { gap: 48px; } }
</style>
