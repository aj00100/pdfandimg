---
// src/components/SmartRelatedTools.astro
import { toolsMap } from '../data/toolsMap';
import { getLocaleChrome } from '../data/i18nMap';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const rawPath = Astro.url.pathname.replace(/\/+$/, '');
const currentPath = rawPath ? `${rawPath}/` : '/';

const chrome = getLocaleChrome(lang, currentPath);
const isNonEnglish = chrome.langCode !== 'en';

// For English pages, dynamically pull from toolsMap excluding current route
const currentTool = toolsMap.find(t => t.href === currentPath);
const englishRelated = toolsMap
  .filter(t => t.href !== currentPath)
  .sort((a, b) => {
    if (currentTool && a.category === currentTool.category && b.category !== currentTool.category) return -1;
    if (currentTool && b.category === currentTool.category && a.category !== currentTool.category) return 1;
    return 0;
  })
  .slice(0, 6);

const localizedCards = isNonEnglish
  ? chrome.relatedTools.filter(t => t.href !== currentPath)
  : englishRelated.map(t => ({
      name: t.name,
      desc: t.desc,
      href: t.href,
      badge: t.category.toUpperCase(),
    }));
---

<section
  style="
    max-width: 1000px;
    margin: 72px auto 0;
    padding: 0 24px;
  "
  aria-label={chrome.relatedHeading}
>
  <div style="border-top: 1px solid var(--color-border); padding-top: 48px;">
    <h2
      style="
        font-family: var(--font-display);
        font-size: 1.375rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--color-ink);
        margin: 0 0 24px;
      "
    >
      {chrome.relatedHeading}
    </h2>

    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
      "
    >
      {localizedCards.map(item => (
        <a
          href={item.href}
          style="
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 10px;
            padding: 20px;
            background: var(--color-surface-1);
            border: 1px solid var(--color-border);
            border-radius: 14px;
            text-decoration: none;
            transition: border-color 0.2s ease, transform 0.2s ease;
          "
          class="smart-related-card"
        >
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px;">
              <span style="font-weight: 700; font-size: 0.95rem; color: var(--color-ink);">
                {item.name}
              </span>
              <span
                style="
                  font-family: var(--font-mono);
                  font-size: 0.625rem;
                  font-weight: 700;
                  padding: 2px 8px;
                  border-radius: 999px;
                  background: rgba(200,241,53,0.1);
                  color: var(--color-lime);
                  border: 1px solid rgba(200,241,53,0.25);
                "
              >
                {item.badge}
              </span>
            </div>
            <p style="font-size: 0.8125rem; color: var(--color-ink-2); margin: 0; line-height: 1.55;">
              {item.desc}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .smart-related-card:hover {
    border-color: var(--color-lime) !important;
    transform: translateY(-2px);
  }
</style>
