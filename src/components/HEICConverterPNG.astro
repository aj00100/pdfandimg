---
---
<div id="heic-png-root" style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
  <div class="panel p-5 md:p-8">
    <div id="heic-png-drop-zone" class="drop-zone" style="min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 24px; position: relative; border-radius: 16px;">
      <input type="file" id="heic-png-file-input" style="display: none;" accept=".heic,.heif" multiple />
      
      <div id="heic-png-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">Select HEIC Files</p>
          <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin: 0;">Upload iPhone photos to convert to PNG</p>
        </div>
        <button onclick="document.getElementById('heic-png-file-input').click()" class="btn-ghost" type="button" style="font-size: 0.75rem; z-index: 10;">Browse files</button>
      </div>

      <div id="heic-png-preview-container" class="hidden" style="position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; background: var(--color-surface-2); border-radius: 14px; z-index: 5;">
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); text-align: center;">
          <strong id="heic-png-filename" style="display: block; margin-bottom: 4px;"></strong>
          <span id="heic-png-file-count" style="color: var(--color-ink-2);"></span>
        </div>
        <button id="heic-png-change-btn" class="btn-ghost" type="button" style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem; z-index: 10;">Change</button>
      </div>
    </div>

    <button id="heic-png-convert-btn" class="btn-primary" disabled style="width: 100%; height: 56px; font-size: 1rem;" type="button">
      Convert to PNG
    </button>
  </div>

  <div id="heic-png-status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px;">
      <div id="heic-png-processing" class="hidden" style="flex-direction: column; width: 100%; gap: 16px; padding: 16px 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); text-align: center;" id="heic-png-status-text">Loading WebAssembly engine...</div>
        <div style="width: 100%; max-width: 500px; margin: 0 auto; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden;">
          <div id="heic-png-progress-bar" style="width: 0%; height: 100%; background: currentColor; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div id="heic-png-result-view" class="hidden flex-col gap-8 items-center w-full text-center">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Conversion Complete!</h2>
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink-2);" id="heic-png-result-details">
          Successfully converted to PNG format.
        </div>
        
        <div id="heic-png-download-links" style="display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 400px;">
          <!-- Download buttons injected here -->
        </div>

        <button id="heic-png-reset-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">
          ← Convert more files
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline src="https://unpkg.com/heic2any@0.0.4/dist/heic2any.js"></script>

<script>
  declare global {
    interface Window {
      heic2any: any;
    }
  }

  const root = document.getElementById('heic-png-root');
  if (root) {
    const blobUrlsToRevoke: string[] = [];
    const dropZone = document.getElementById('heic-png-drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('heic-png-file-input') as HTMLInputElement;
    const placeholder = document.getElementById('heic-png-upload-placeholder') as HTMLDivElement;
    const previewContainer = document.getElementById('heic-png-preview-container') as HTMLDivElement;
    const fileNameText = document.getElementById('heic-png-filename') as HTMLSpanElement;
    const fileCountText = document.getElementById('heic-png-file-count') as HTMLSpanElement;
    const changeBtn = document.getElementById('heic-png-change-btn') as HTMLButtonElement;
    const convertBtn = document.getElementById('heic-png-convert-btn') as HTMLButtonElement;
    
    const statusPanel = document.getElementById('heic-png-status-panel') as HTMLDivElement;
    const processing = document.getElementById('heic-png-processing') as HTMLDivElement;
    const progressBar = document.getElementById('heic-png-progress-bar') as HTMLDivElement;
    const statusText = document.getElementById('heic-png-status-text') as HTMLDivElement;
    const resultView = document.getElementById('heic-png-result-view') as HTMLDivElement;
    const downloadLinksContainer = document.getElementById('heic-png-download-links') as HTMLDivElement;
    const resetBtn = document.getElementById('heic-png-reset-btn') as HTMLButtonElement;

    let selectedFiles: File[] = [];

    dropZone.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('button')) {
        fileInput.value = ''; fileInput.click();
      }
    });
    
    changeBtn.addEventListener('click', (e) => {
      blobUrlsToRevoke.forEach(u => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      e.stopPropagation();
      fileInput.value = ''; fileInput.click();
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('active');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('active');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('active');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) handleFiles(Array.from(files));
    });

    fileInput.addEventListener('change', (e: any) => {
      const files = e.target.files;
      if (files && files.length > 0) handleFiles(Array.from(files));
    });

    function handleFiles(files: File[]) {
      const validFiles = files.filter(f => f.name.toLowerCase().endsWith('.heic') || f.name.toLowerCase().endsWith('.heif'));
      
      if (validFiles.length === 0) {
        alert("Please select valid HEIC/HEIF image files.");
        return;
      }

      selectedFiles = validFiles;
      
      placeholder.classList.add('hidden');
      previewContainer.classList.remove('hidden');
      
      if (validFiles.length === 1) {
        fileNameText.textContent = validFiles[0].name;
        fileCountText.textContent = `${(validFiles[0].size / 1024 / 1024).toFixed(2)} MB`;
      } else {
        fileNameText.textContent = `${validFiles.length} files selected`;
        const totalSize = validFiles.reduce((acc, f) => acc + f.size, 0);
        fileCountText.textContent = `Total Size: ${(totalSize / 1024 / 1024).toFixed(2)} MB`;
      }
      
      convertBtn.disabled = false;
      statusPanel.classList.add('hidden');
    }

    convertBtn.addEventListener('click', async () => {
      if (selectedFiles.length === 0) return;
      if (!window.heic2any) {
        alert("The converter engine failed to load. Please check your connection or try again.");
        return;
      }
      
      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      resultView.classList.add('hidden');
      convertBtn.disabled = true;
      statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      downloadLinksContainer.innerHTML = '';
      
      try {
        const results: { blob: Blob, name: string }[] = [];
        
        for (let i = 0; i < selectedFiles.length; i++) {
          const file = selectedFiles[i];
          statusText.textContent = `Converting ${file.name} (${i + 1} of ${selectedFiles.length})...`;
          progressBar.style.width = `${Math.round((i / selectedFiles.length) * 100)}%`;
          
          const conversionResult = await window.heic2any({
            blob: file,
            toType: "image/png"
          });
          
          let blobArray = Array.isArray(conversionResult) ? conversionResult : [conversionResult];
          
          results.push({
            blob: blobArray[0] as Blob,
            name: file.name.replace(/\.heic$/i, '.png').replace(/\.heif$/i, '.png')
          });
        }

        progressBar.style.width = '100%';
        statusText.textContent = 'Done!';

        results.forEach(res => {
          const a = document.createElement('a');
          const tempUrl = URL.createObjectURL(res.blob);
          blobUrlsToRevoke.push(tempUrl);
          a.href = tempUrl;
          a.download = res.name;
          a.className = 'btn-download';
          a.style.width = '100%';
          a.style.height = '48px';
          a.style.fontSize = '0.9rem';
          a.textContent = `Download ${res.name}`;
          downloadLinksContainer.appendChild(a);
        });
        
        processing.classList.add('hidden');
        resultView.classList.remove('hidden');
        resultView.style.display = 'flex';

      } catch (err: any) {
        console.error(err);
        alert('Conversion failed. The file may be corrupted or unsupported.');
        processing.classList.add('hidden');
      } finally {
        convertBtn.disabled = false;
      }
    });

    resetBtn.addEventListener('click', () => {
      blobUrlsToRevoke.forEach(u => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      selectedFiles = [];
      previewContainer.classList.add('hidden');
      placeholder.classList.remove('hidden');
      statusPanel.classList.add('hidden');
      convertBtn.disabled = true;
      fileInput.value = '';
    });
  }
</script>
