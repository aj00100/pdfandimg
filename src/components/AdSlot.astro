---
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'vertical';
  minHeightMobile?: string;
  minHeightDesktop?: string;
}

const { 
  slotId = "", 
  format = 'horizontal', 
  minHeightMobile = '100px', 
  minHeightDesktop = '90px' 
} = Astro.props;

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const isLiveAdSense = Boolean(adsenseClient && adsenseClient.startsWith('ca-pub-') && !adsenseClient.includes('XXXX'));
---

{isLiveAdSense ? (
  <div 
    class="ad-slot-wrapper" 
    style={`--mh-mobile: ${minHeightMobile}; --mh-desktop: ${minHeightDesktop};`}
    aria-label="Advertisement"
  >
    <span class="ad-label">ADVERTISEMENT</span>
    <ins class="adsbygoogle"
         style="display:block; width: 100%;"
         data-ad-client={adsenseClient}
         data-ad-slot={slotId}
         data-ad-format={format}
         data-full-width-responsive="true"></ins>
  </div>
) : null}

<style>
  .ad-slot-wrapper {
    width: 100%;
    max-width: 860px;
    margin: 24px auto;
    min-height: var(--mh-mobile);
    background: var(--color-surface-1);
    border: 1px dashed var(--color-border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .ad-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-3);
    margin: 4px 0;
  }
  @media (min-width: 768px) {
    .ad-slot-wrapper {
      min-height: var(--mh-desktop);
    }
  }
</style>
