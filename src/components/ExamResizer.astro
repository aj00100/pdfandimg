---
// ExamResizer.astro
interface Props {
  allowMultiple?: boolean;
  defaultExam?: string;
  defaultType?: 'photo' | 'signature' | 'thumb' | 'declaration' | 'postcard';
}

const { allowMultiple = true, defaultExam = 'upsc', defaultType = 'photo' } = Astro.props;
---

<div id="exam-resizer-root" data-default-exam={defaultExam} data-default-type={defaultType} style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
  <div class="panel p-5 md:p-8">
    
    <!-- Presets Section -->
    <div style="margin-bottom: 24px;">
      <h3 style="font-family: var(--font-head); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin-bottom: 12px;">1. Select Exam & Document Type</h3>
      
      <div style="margin-bottom: 16px;">
        <label for="er-exam-select" style="display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); margin-bottom: 8px;">Select Exam / Portal</label>
        <select id="er-exam-select" class="input-select" style="width: 100%; height: 48px; font-size: 1rem; padding: 0 16px; border-radius: 8px; border: 1px solid var(--color-border); background: var(--color-surface-2); color: var(--color-ink); cursor: pointer;">
          <optgroup label="Govt & ID Documents">
            <option value="pan">PAN Card (NSDL / UTIITSL — 300 DPI)</option>
            <option value="passport">Indian Passport Seva</option>
          </optgroup>
          <optgroup label="Central Exams">
            <option value="upsc">UPSC OTR (IAS / IPS / CDS / NDA)</option>
            <option value="ssc">SSC (CGL / CHSL / MTS / GD)</option>
            <option value="rrb">RRB NTPC / Group D / ALP</option>
          </optgroup>
          <optgroup label="Banking Exams">
            <option value="ibps">IBPS (PO / Clerk / RRB / SO)</option>
            <option value="sbi">SBI (PO / Clerk)</option>
            <option value="rbi">RBI Grade B / Assistant / LIC</option>
          </optgroup>
          <optgroup label="Entrance Exams">
            <option value="neet">NEET UG (Passport + 4x6 Postcard)</option>
            <option value="jee">JEE Main / Advanced</option>
            <option value="gate">GATE GOAPS</option>
          </optgroup>
          <optgroup label="State PSC & Police">
            <option value="bpsc">BPSC (Bihar)</option>
            <option value="uppsc">UPPSC (UP)</option>
            <option value="mppsc">MPPSC (MP)</option>
            <option value="police">All State Police Exams</option>
          </optgroup>
        </select>
      </div>

      <div id="er-tabs-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 14px;">
        <label class="er-tab-card active" data-type="photo" id="er-card-photo" style="cursor: pointer;">
          <input type="radio" name="er-type" value="photo" checked style="position: absolute; opacity: 0; pointer-events: none;" />
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <span class="er-tab-title" id="er-lbl-photo" style="font-weight: 700; font-size: 0.875rem; color: var(--color-ink);">Photograph</span>
          </div>
          <span class="er-tab-desc" id="er-desc-photo" style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-top: 4px; display: block;">Passport Size</span>
        </label>

        <label class="er-tab-card" data-type="postcard" id="er-card-postcard" style="cursor: pointer; position: relative;">
          <input type="radio" name="er-type" value="postcard" style="position: absolute; opacity: 0; pointer-events: none;" />
          <span class="er-tab-pill-badge" id="er-badge-postcard" style="display: none; position: absolute; top: -8px; right: 8px; font-family: var(--font-mono); font-size: 0.625rem; font-weight: 800; color: #c8f135; background: #000; border: 1px solid rgba(200, 241, 53, 0.5); padding: 1px 7px; border-radius: 99px; letter-spacing: 0.04em;">NTA MANDATORY</span>
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="18" rx="2"/><line x1="2" y1="9" x2="22" y2="9"/><line x1="8" y1="21" x2="8" y2="9"/></svg>
            <span class="er-tab-title" id="er-lbl-postcard" style="font-weight: 700; font-size: 0.875rem; color: var(--color-ink);">4×6" Postcard</span>
          </div>
          <span class="er-tab-desc" id="er-desc-postcard" style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-top: 4px; display: block;">10×15 cm Postcard</span>
        </label>

        <label class="er-tab-card" data-type="signature" id="er-card-signature" style="cursor: pointer;">
          <input type="radio" name="er-type" value="signature" style="position: absolute; opacity: 0; pointer-events: none;" />
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            <span class="er-tab-title" id="er-lbl-signature" style="font-weight: 700; font-size: 0.875rem; color: var(--color-ink);">Signature</span>
          </div>
          <span class="er-tab-desc" id="er-desc-signature" style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-top: 4px; display: block;">Black Ink / Clean</span>
        </label>

        <label class="er-tab-card" data-type="thumb" id="er-card-thumb" style="cursor: pointer;">
          <input type="radio" name="er-type" value="thumb" style="position: absolute; opacity: 0; pointer-events: none;" />
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
            <span class="er-tab-title" id="er-lbl-thumb" style="font-weight: 700; font-size: 0.875rem; color: var(--color-ink);">Thumb / Fingers</span>
          </div>
          <span class="er-tab-desc" id="er-desc-thumb" style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-top: 4px; display: block;">Impression</span>
        </label>

        <label class="er-tab-card" data-type="declaration" id="er-card-declaration" style="cursor: pointer;">
          <input type="radio" name="er-type" value="declaration" style="position: absolute; opacity: 0; pointer-events: none;" />
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span class="er-tab-title" id="er-lbl-declaration" style="font-weight: 700; font-size: 0.875rem; color: var(--color-ink);">Declaration</span>
          </div>
          <span class="er-tab-desc" id="er-desc-declaration" style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-top: 4px; display: block;">Handwritten 50–100KB</span>
        </label>
      </div>
    </div>

    <!-- Configuration Section (Auto-filled by presets) -->
    <div style="background: var(--color-surface-2); padding: 16px; border-radius: 12px; margin-bottom: 24px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
        <h3 style="font-family: var(--font-head); font-size: 0.875rem; font-weight: 700; color: var(--color-ink-2); margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">Current Specifications</h3>
        <span id="er-mode-badge" style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-lime); background: rgba(200,241,53,0.1); padding: 3px 10px; border-radius: 99px; border: 1px solid rgba(200,241,53,0.25);">300 DPI · Center-Crop</span>
      </div>
      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 100px;">
          <label for="er-width" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-bottom: 4px;">Width (px)</label>
          <input type="number" id="er-width" class="input-number" style="width: 100%; height: 44px; font-size: 1rem; text-align: center;" />
        </div>
        <div style="flex: 1; min-width: 100px;">
          <label for="er-height" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-bottom: 4px;">Height (px)</label>
          <input type="number" id="er-height" class="input-number" style="width: 100%; height: 44px; font-size: 1rem; text-align: center;" />
        </div>
        <div style="flex: 1; min-width: 100px;">
          <label for="er-kb" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-bottom: 4px;">Target (KB)</label>
          <input type="number" id="er-kb" class="input-number" style="width: 100%; height: 44px; font-size: 1rem; text-align: center;" />
        </div>
      </div>

      <!-- Name & Date on Photo (DOP) Toggle -->
      <div id="er-dop-container" style="margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--color-border);">
        <label style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none;">
          <input type="checkbox" id="er-dop-toggle" style="width: 16px; height: 16px; accent-color: var(--color-lime); cursor: pointer;" />
          <span style="font-family: var(--font-body); font-size: 0.875rem; font-weight: 700; color: var(--color-ink);">
            Print Name & Date on Photo (DOP)
          </span>
          <span id="er-dop-badge" style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-lime); background: rgba(200,241,53,0.1); padding: 2px 8px; border-radius: 99px;">SSC / UPSC Requirement</span>
        </label>
        
        <div id="er-dop-fields" style="display: none; gap: 12px; margin-top: 12px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 140px;">
            <label for="er-cand-name" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-bottom: 4px;">Candidate Name</label>
            <input type="text" id="er-cand-name" placeholder="e.g. RAHUL SHARMA" style="width: 100%; height: 40px; font-size: 0.875rem; padding: 0 12px; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-surface-1); color: var(--color-ink); text-transform: uppercase;" />
          </div>
          <div style="flex: 1; min-width: 140px;">
            <label for="er-cand-date" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin-bottom: 4px;">Date of Photo (DD-MM-YYYY)</label>
            <input type="text" id="er-cand-date" placeholder="DD-MM-YYYY" style="width: 100%; height: 40px; font-size: 0.875rem; padding: 0 12px; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-surface-1); color: var(--color-ink);" />
          </div>
        </div>
      </div>
    </div>

    <!-- Drop Zone -->
    <h3 style="font-family: var(--font-head); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin-bottom: 12px;">2. Upload & Process</h3>
    <div id="er-drop-zone" class="drop-zone" style="min-height: 240px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 24px; position: relative; border-radius: 16px;">
      <input type="file" id="er-file-input" style="display: none;" accept="image/jpeg,image/png,image/webp" multiple={allowMultiple} />
      
      <div id="er-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">{allowMultiple ? 'Drop images here' : 'Drop image here'}</p>
          <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin: 0;">JPG, PNG, WEBP</p>
        </div>
        <button onclick="document.getElementById('er-file-input').click()" class="btn-ghost" type="button" style="font-size: 0.75rem; z-index: 10;">Browse files</button>
      </div>

      <div id="er-preview-container" class="hidden" style="position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; background: var(--color-surface-2); border-radius: 14px; z-index: 5;">
        <img id="er-upload-preview" src="data:," alt="Selected image preview" style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; display: none;" />
        <div id="er-bulk-text" style="display: none; font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); max-height: 180px; overflow-y: auto; width: 100%;"></div>
        <button id="er-change-btn" class="btn-ghost" type="button" style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem; z-index: 10;">Change</button>
      </div>
    </div>

    <button id="er-convert-btn" class="btn-primary" disabled style="width: 100%; height: 56px; font-size: 1rem; display: flex; align-items: center; justify-content: center; gap: 8px;" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
      Generate Compliant Image
    </button>
  </div>

  <div id="er-status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px;">
      <div id="er-processing" class="hidden" style="flex-direction: column; width: 100%; gap: 16px; padding: 16px 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); text-align: center;" id="er-status-text">Processing...</div>
        <div style="width: 100%; max-width: 500px; margin: 0 auto; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden;">
          <div id="er-progress-bar" style="width: 0%; height: 100%; background: currentColor; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div id="er-result-view" class="hidden flex-col gap-8 items-center w-full text-center">
        <div style="font-size: 1.5rem; font-weight: 800; margin: 0; color: var(--color-ink);">Ready for Portal Upload!</div>
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink-2);">
          Final Size: <strong id="er-final-kb" style="color: var(--color-lime);">--</strong>
        </div>
        <a id="er-download-link" href="#" class="btn-download" style="width: 100%; max-width: 400px; height: 56px; font-size: 1rem;">
          Download Compliant JPG
        </a>
        <button id="er-reset-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">
          ← Optimize another
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { resizeAndCompressExact } from '../utils/imageCompressor';
  import JSZip from 'jszip';

  const escapeHTML = (str: string) =>
    String(str).replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] || m));

  type DocCategory = 'photo' | 'signature' | 'thumb' | 'declaration' | 'postcard';
  type SpecEntry = { w: number; h: number; kb: number; dpi?: number };

  const defaultExtras: Record<'thumb' | 'declaration' | 'postcard', SpecEntry> = {
    thumb:       { w: 240,  h: 240,  kb: 35,  dpi: 300 },
    declaration: { w: 800,  h: 400,  kb: 85,  dpi: 300 },
    postcard:    { w: 1200, h: 1800, kb: 160, dpi: 300 },
  };

  const presets: Record<string, Record<DocCategory, SpecEntry>> = {
    pan:      { photo: { w: 213, h: 213, kb: 26, dpi: 300 },  signature: { w: 400, h: 200, kb: 45, dpi: 600 }, ...defaultExtras },
    passport: { photo: { w: 350, h: 450, kb: 45, dpi: 300 },  signature: { w: 350, h: 150, kb: 35, dpi: 300 }, ...defaultExtras },
    upsc:     { photo: { w: 500, h: 500, kb: 120, dpi: 300 }, signature: { w: 400, h: 400, kb: 60, dpi: 300 }, ...defaultExtras },
    ssc:      { photo: { w: 200, h: 240, kb: 38, dpi: 300 },  signature: { w: 140, h: 60,  kb: 16, dpi: 300 }, ...defaultExtras },
    rrb:      { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 25, dpi: 300 }, ...defaultExtras },
    ibps:     { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 16, dpi: 300 }, thumb: { w: 240, h: 240, kb: 35, dpi: 300 }, declaration: { w: 800, h: 400, kb: 85, dpi: 300 }, postcard: { w: 1200, h: 1800, kb: 160, dpi: 300 } },
    sbi:      { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 16, dpi: 300 }, thumb: { w: 240, h: 240, kb: 35, dpi: 300 }, declaration: { w: 800, h: 400, kb: 85, dpi: 300 }, postcard: { w: 1200, h: 1800, kb: 160, dpi: 300 } },
    rbi:      { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 16, dpi: 300 }, thumb: { w: 240, h: 240, kb: 35, dpi: 300 }, declaration: { w: 800, h: 400, kb: 85, dpi: 300 }, postcard: { w: 1200, h: 1800, kb: 160, dpi: 300 } },
    neet:     { photo: { w: 350, h: 450, kb: 120, dpi: 300 }, signature: { w: 140, h: 60,  kb: 20, dpi: 300 }, thumb: { w: 400, h: 400, kb: 80, dpi: 300 }, declaration: { w: 800, h: 400, kb: 85, dpi: 300 }, postcard: { w: 1200, h: 1800, kb: 160, dpi: 300 } },
    jee:      { photo: { w: 200, h: 230, kb: 120, dpi: 300 }, signature: { w: 140, h: 60,  kb: 22, dpi: 300 }, ...defaultExtras },
    gate:     { photo: { w: 480, h: 640, kb: 160, dpi: 300 }, signature: { w: 480, h: 160, kb: 35, dpi: 300 }, ...defaultExtras },
    bpsc:     { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 18, dpi: 300 }, ...defaultExtras },
    uppsc:    { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 18, dpi: 300 }, ...defaultExtras },
    mppsc:    { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 18, dpi: 300 }, ...defaultExtras },
    police:   { photo: { w: 200, h: 230, kb: 42, dpi: 300 },  signature: { w: 140, h: 60,  kb: 18, dpi: 300 }, ...defaultExtras },
  };

  const root = document.getElementById('exam-resizer-root') as HTMLDivElement;
  if (root) {
    const blobUrlsToRevoke: string[] = [];
    const dropZone = document.getElementById('er-drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('er-file-input') as HTMLInputElement;
    const placeholder = document.getElementById('er-upload-placeholder') as HTMLDivElement;
    const previewContainer = document.getElementById('er-preview-container') as HTMLDivElement;
    const uploadPreview = document.getElementById('er-upload-preview') as HTMLImageElement;
    const bulkText = document.getElementById('er-bulk-text') as HTMLDivElement;
    const changeBtn = document.getElementById('er-change-btn') as HTMLButtonElement;
    const convertBtn = document.getElementById('er-convert-btn') as HTMLButtonElement;
    const modeBadge = document.getElementById('er-mode-badge') as HTMLSpanElement;

    const widthInput = document.getElementById('er-width') as HTMLInputElement;
    const heightInput = document.getElementById('er-height') as HTMLInputElement;
    const kbInput = document.getElementById('er-kb') as HTMLInputElement;

    const dopContainer = document.getElementById('er-dop-container') as HTMLDivElement;
    const dopToggle = document.getElementById('er-dop-toggle') as HTMLInputElement;
    const dopFields = document.getElementById('er-dop-fields') as HTMLDivElement;
    const candNameInput = document.getElementById('er-cand-name') as HTMLInputElement;
    const candDateInput = document.getElementById('er-cand-date') as HTMLInputElement;

    if (dopToggle && dopFields) {
      dopToggle.addEventListener('change', () => {
        dopFields.style.display = dopToggle.checked ? 'flex' : 'none';
        if (dopToggle.checked && candDateInput && !candDateInput.value) {
          const now = new Date();
          const dd = String(now.getDate()).padStart(2, '0');
          const mm = String(now.getMonth() + 1).padStart(2, '0');
          const yyyy = now.getFullYear();
          candDateInput.value = `${dd}-${mm}-${yyyy}`;
        }
      });
    }

    const statusPanel = document.getElementById('er-status-panel') as HTMLDivElement;
    const processing = document.getElementById('er-processing') as HTMLDivElement;
    const progressBar = document.getElementById('er-progress-bar') as HTMLDivElement;
    const statusText = document.getElementById('er-status-text') as HTMLDivElement;
    const resultView = document.getElementById('er-result-view') as HTMLDivElement;
    const downloadLink = document.getElementById('er-download-link') as HTMLAnchorElement;
    const resetBtn = document.getElementById('er-reset-btn') as HTMLButtonElement;
    const finalKbText = document.getElementById('er-final-kb') as HTMLElement;

    let selectedFiles: File[] = [];
    let currentExam = root.dataset.defaultExam || 'upsc';
    let currentType = (root.dataset.defaultType || 'photo') as DocCategory;

    const examSelect = document.getElementById('er-exam-select') as HTMLSelectElement;
    examSelect.value = currentExam;

    const tabCards = document.querySelectorAll('.er-tab-card');
    const postcardCard = document.getElementById('er-card-postcard') as HTMLElement;
    const postcardBadge = document.getElementById('er-badge-postcard') as HTMLElement;
    const thumbCard = document.getElementById('er-card-thumb') as HTMLElement;
    const declCard = document.getElementById('er-card-declaration') as HTMLElement;

    const lblPhoto = document.getElementById('er-lbl-photo');
    const descPhoto = document.getElementById('er-desc-photo');
    const lblPostcard = document.getElementById('er-lbl-postcard');
    const descPostcard = document.getElementById('er-desc-postcard');
    const lblSig = document.getElementById('er-lbl-signature');
    const descSig = document.getElementById('er-desc-signature');
    const lblThumb = document.getElementById('er-lbl-thumb');
    const descThumb = document.getElementById('er-desc-thumb');
    const lblDecl = document.getElementById('er-lbl-declaration');
    const descDecl = document.getElementById('er-desc-declaration');

    function syncActiveTabVisuals() {
      tabCards.forEach((card) => {
        const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio && radio.checked) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    const typeRadios = document.querySelectorAll('input[name="er-type"]');
    typeRadios.forEach((radio) => {
      const radioInput = radio as HTMLInputElement;
      if (radioInput.value === currentType) {
        radioInput.checked = true;
      }
    });

    function getActiveType(): DocCategory {
      const checked = document.querySelector('input[name="er-type"]:checked') as HTMLInputElement;
      return (checked?.value || 'photo') as DocCategory;
    }

    function configureTabsForExam(exam: string) {
      if (postcardBadge) postcardBadge.style.display = 'none';
      if (postcardCard) postcardCard.style.display = '';
      if (thumbCard) thumbCard.style.display = '';
      if (declCard) declCard.style.display = '';

      if (exam === 'neet') {
        if (lblPhoto) lblPhoto.textContent = 'Passport Photo';
        if (descPhoto) descPhoto.textContent = '3.5×4.5 cm · 10–200 KB';
        if (lblPostcard) lblPostcard.textContent = '4×6" Postcard';
        if (descPostcard) descPostcard.textContent = '1200×1800 px · 10–200 KB';
        if (postcardBadge) postcardBadge.style.display = 'inline-block';
        if (lblSig) lblSig.textContent = 'Signature';
        if (descSig) descSig.textContent = '140×60 px · 4–30 KB';
        if (lblThumb) lblThumb.textContent = 'Thumb & Fingers';
        if (descThumb) descThumb.textContent = '400×400 px · 10–200 KB';
        if (declCard) declCard.style.display = 'none';
      } else if (exam === 'ibps' || exam === 'sbi' || exam === 'rbi') {
        if (lblPhoto) lblPhoto.textContent = 'Candidate Photo';
        if (descPhoto) descPhoto.textContent = '200×230 px · 20–50 KB';
        if (lblSig) lblSig.textContent = 'Signature';
        if (descSig) descSig.textContent = '140×60 px · 10–20 KB';
        if (lblThumb) lblThumb.textContent = 'Left Thumb';
        if (descThumb) descThumb.textContent = '240×240 px · 20–50 KB';
        if (lblDecl) lblDecl.textContent = 'Declaration';
        if (descDecl) descDecl.textContent = '800×400 px · 50–100 KB';
        if (postcardCard) postcardCard.style.display = 'none';
      } else if (exam === 'ssc' || exam === 'upsc') {
        if (lblPhoto) lblPhoto.textContent = 'Photograph';
        const p = presets[exam]?.photo || { w: 200, h: 240, kb: 50 };
        if (descPhoto) descPhoto.textContent = `${p.w}×${p.h} px · <${p.kb} KB`;
        if (lblSig) lblSig.textContent = 'Signature';
        const s = presets[exam]?.signature || { w: 140, h: 60, kb: 20 };
        if (descSig) descSig.textContent = `${s.w}×${s.h} px · <${s.kb} KB`;
        if (postcardCard) postcardCard.style.display = 'none';
        if (thumbCard) thumbCard.style.display = 'none';
        if (declCard) declCard.style.display = 'none';
      } else if (exam === 'pan') {
        if (lblPhoto) lblPhoto.textContent = 'Passport Photo';
        if (descPhoto) descPhoto.textContent = '213×213 px · <50 KB';
        if (lblSig) lblSig.textContent = 'Signature';
        if (descSig) descSig.textContent = '400×200 px · 600 DPI';
        if (postcardCard) postcardCard.style.display = 'none';
        if (thumbCard) thumbCard.style.display = 'none';
        if (declCard) declCard.style.display = 'none';
      } else {
        if (lblPhoto) lblPhoto.textContent = 'Photograph';
        if (descPhoto) descPhoto.textContent = 'Standard Photo';
        if (lblPostcard) lblPostcard.textContent = '4×6" Postcard';
        if (descPostcard) descPostcard.textContent = '1200×1800 px';
        if (lblSig) lblSig.textContent = 'Signature';
        if (descSig) descSig.textContent = 'Black / Dark Ink';
        if (lblThumb) lblThumb.textContent = 'Thumb Impression';
        if (descThumb) descThumb.textContent = 'Biometric Scan';
        if (lblDecl) lblDecl.textContent = 'Declaration';
        if (descDecl) descDecl.textContent = 'Handwritten';
      }

      // If active tab was hidden, reset to photo
      const activeCard = document.querySelector('.er-tab-card.active') as HTMLElement;
      if (activeCard && activeCard.style.display === 'none') {
        const photoRadio = document.querySelector('input[name="er-type"][value="photo"]') as HTMLInputElement;
        if (photoRadio) photoRadio.checked = true;
      }
      syncActiveTabVisuals();
    }

    function applyPreset() {
      const type = getActiveType();
      const examData = presets[currentExam] || presets.upsc;
      const data = examData[type] || examData.photo;
      widthInput.value = data.w.toString();
      heightInput.value = data.h.toString();
      kbInput.value = data.kb.toString();

      const isContain = type === 'signature' || type === 'declaration' || type === 'thumb';
      const dpi = data.dpi || 300;
      if (modeBadge) {
        modeBadge.textContent = `${dpi} DPI · ${isContain ? 'White Pad (No Clip)' : 'Center-Crop (No Stretch)'}`;
      }
      if (dopContainer) {
        const isPhotoOrPostcard = (type === 'photo' || type === 'postcard');
        dopContainer.style.display = isPhotoOrPostcard ? 'block' : 'none';

        const dopBadge = document.getElementById('er-dop-badge');
        if (dopBadge) {
          if (currentExam === 'neet') {
            dopBadge.textContent = 'NTA NEET Requirement (Name & Date of Photo)';
          } else if (currentExam === 'ssc') {
            dopBadge.textContent = 'SSC Mandatory (Name & Date of Photo)';
          } else if (currentExam === 'upsc') {
            dopBadge.textContent = 'UPSC OTR 10-Day Rule (Name & Date)';
          } else {
            dopBadge.textContent = 'Candidate Name & Date Stamp';
          }
        }

        if (currentExam === 'neet' && isPhotoOrPostcard && !dopToggle.checked) {
          dopToggle.checked = true;
          if (dopFields) dopFields.style.display = 'flex';
          if (candDateInput && !candDateInput.value) {
            const now = new Date();
            const dd = String(now.getDate()).padStart(2, '0');
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            candDateInput.value = `${dd}-${mm}-${now.getFullYear()}`;
          }
        }
      }
      syncActiveTabVisuals();
    }

    tabCards.forEach((card) => {
      card.addEventListener('click', () => {
        const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio) {
          radio.checked = true;
          syncActiveTabVisuals();
          applyPreset();
        }
      });
    });

    examSelect.addEventListener('change', (e) => {
      currentExam = (e.target as HTMLSelectElement).value;
      configureTabsForExam(currentExam);
      applyPreset();
    });

    typeRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        syncActiveTabVisuals();
        applyPreset();
      });
    });

    configureTabsForExam(currentExam);
    applyPreset();

    dropZone.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('button')) {
        fileInput.value = '';
        fileInput.click();
      }
    });

    changeBtn.addEventListener('click', (e) => {
      blobUrlsToRevoke.forEach((u) => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      e.stopPropagation();
      fileInput.value = '';
      fileInput.click();
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('active');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('active'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('active');
      if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', (e: any) => {
      if (e.target.files) handleFiles(e.target.files);
    });

    function handleFiles(filesList: FileList | File[]) {
      const arr = Array.from(filesList);
      selectedFiles = arr.filter((f) => f.type.startsWith('image/')).slice(0, 50);
      if (selectedFiles.length === 0) return;

      placeholder.classList.add('hidden');
      previewContainer.classList.remove('hidden');
      convertBtn.disabled = false;

      if (selectedFiles.length === 1) {
        uploadPreview.style.display = 'block';
        bulkText.style.display = 'none';
        const reader = new FileReader();
        reader.onload = (e) => (uploadPreview.src = e.target?.result as string);
        reader.readAsDataURL(selectedFiles[0]);
      } else {
        uploadPreview.style.display = 'none';
        bulkText.style.display = 'block';
        bulkText.innerHTML = selectedFiles.map((f, i) => `${i + 1}. ${escapeHTML(f.name)}`).join('<br/>');
      }
      statusPanel.classList.add('hidden');
    }

    convertBtn.addEventListener('click', async () => {
      if (selectedFiles.length === 0) return;

      const width = parseInt(widthInput.value);
      const height = parseInt(heightInput.value);
      const targetKB = parseInt(kbInput.value);

      if (isNaN(width) || isNaN(height) || isNaN(targetKB) || width <= 0 || height <= 0 || targetKB <= 0) {
        alert('Please ensure width, height, and KB are valid positive numbers.');
        return;
      }

      const type = getActiveType();
      const fitMode = type === 'signature' || type === 'declaration' || type === 'thumb' ? 'contain' : 'cover';
      const dpi = presets[currentExam]?.[type]?.dpi || 300;
      const nameDateStamp = (dopToggle?.checked && (type === 'photo' || type === 'postcard'))
        ? { name: candNameInput?.value || '', date: candDateInput?.value || '' }
        : undefined;

      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      resultView.classList.add('hidden');
      convertBtn.disabled = true;
      statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        if (selectedFiles.length === 1) {
          statusText.textContent = 'Calibrating dimensions, DPI & target KB...';
          progressBar.style.width = '50%';
          const result = await resizeAndCompressExact(
            selectedFiles[0],
            width,
            height,
            targetKB,
            'image/jpeg',
            fitMode,
            dpi,
            nameDateStamp
          );
          progressBar.style.width = '100%';

          const url = URL.createObjectURL(result.blob);
          blobUrlsToRevoke.push(url);
          downloadLink.href = url;
          const cleanName = (
            selectedFiles[0].name.substring(0, selectedFiles[0].name.lastIndexOf('.')) || selectedFiles[0].name
          ).replace(/\s+/g, '_');
          downloadLink.download = `${currentExam}_${type}_${width}x${height}_${cleanName}.jpg`;

          finalKbText.textContent = `${(result.blob.size / 1024).toFixed(1)} KB (${width}×${height} px · ${dpi} DPI)`;
        } else {
          const zip = new JSZip();
          let totalBytes = 0;
          for (let i = 0; i < selectedFiles.length; i++) {
            statusText.textContent = `Processing ${i + 1} of ${selectedFiles.length}...`;
            const result = await resizeAndCompressExact(
              selectedFiles[i],
              width,
              height,
              targetKB,
              'image/jpeg',
              fitMode,
              dpi,
              nameDateStamp
            );
            const cleanName = (
              selectedFiles[i].name.substring(0, selectedFiles[i].name.lastIndexOf('.')) || selectedFiles[i].name
            ).replace(/\s+/g, '_');
            zip.file(`${currentExam}_${type}_${width}x${height}_${cleanName}.jpg`, result.blob);
            totalBytes += result.blob.size;
            progressBar.style.width = `${Math.round(((i + 1) / selectedFiles.length) * 80)}%`;
          }
          statusText.textContent = 'Zipping files...';
          const zipBlob = await zip.generateAsync({ type: 'blob' });
          progressBar.style.width = '100%';

          const url = URL.createObjectURL(zipBlob);
          blobUrlsToRevoke.push(url);
          downloadLink.href = url;
          downloadLink.download = `${currentExam}_${type}_batch.zip`;
          finalKbText.textContent = `${(totalBytes / 1024).toFixed(1)} KB total`;
        }

        processing.classList.add('hidden');
        resultView.classList.remove('hidden');
        resultView.style.display = 'flex';
      } catch (err: any) {
        console.error(err);
        alert(err?.message || 'Processing failed.');
        processing.classList.add('hidden');
      } finally {
        convertBtn.disabled = false;
      }
    });

    resetBtn.addEventListener('click', () => {
      blobUrlsToRevoke.forEach((u) => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      selectedFiles = [];
      uploadPreview.src = 'data:,';
      previewContainer.classList.add('hidden');
      placeholder.classList.remove('hidden');
      statusPanel.classList.add('hidden');
      convertBtn.disabled = true;
      fileInput.value = '';
    });
  }
</script>

<style>
  .er-tab-card {
    padding: 12px 14px;
    border-radius: 12px;
    border: 1.5px solid var(--color-border);
    background: var(--color-surface-2);
    transition: all 0.18s ease;
    user-select: none;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .er-tab-card:hover {
    border-color: var(--color-border-mid);
    background: var(--color-surface-3);
  }
  .er-tab-card.active {
    border-color: var(--color-lime);
    background: rgba(200, 241, 53, 0.08);
    box-shadow: 0 0 0 1px var(--color-lime);
  }
  .er-tab-card.active .er-tab-title {
    color: var(--color-lime) !important;
  }
</style>