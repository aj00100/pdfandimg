---
---

<div id="pdf-merge-root" style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
  <div class="panel p-5 md:p-8">
    <div id="pdf-merge-drop-zone" class="drop-zone" style="min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 24px; position: relative; border-radius: 16px;">
      <input type="file" id="pdf-merge-file-input" style="display: none;" accept="application/pdf" multiple />
      
      <div id="pdf-merge-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">Select Multiple PDFs</p>
          <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin: 0;">to merge into one</p>
        </div>
        <button onclick="document.getElementById('pdf-merge-file-input').click()" class="btn-ghost" type="button" style="font-size: 0.75rem; z-index: 10;">Browse files</button>
      </div>

      <div id="pdf-merge-preview-container" class="hidden" style="position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; background: var(--color-surface-2); border-radius: 14px; z-index: 5;">
        <div id="pdf-merge-bulk-text" style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); max-height: 200px; overflow-y: auto; width: 100%; text-align: left; padding: 16px;"></div>
        <button id="pdf-merge-change-btn" class="btn-ghost" type="button" style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem; z-index: 10;">Change</button>
      </div>
    </div>

    <button id="pdf-merge-convert-btn" class="btn-primary" disabled style="width: 100%; height: 56px; font-size: 1rem;" type="button">
      Merge PDFs
    </button>
  </div>

  <div id="pdf-merge-status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px;">
      <div id="pdf-merge-processing" class="hidden" style="flex-direction: column; width: 100%; gap: 16px; padding: 16px 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); text-align: center;" id="pdf-merge-status-text">Processing...</div>
        <div style="width: 100%; max-width: 500px; margin: 0 auto; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden;">
          <div id="pdf-merge-progress-bar" style="width: 0%; height: 100%; background: currentColor; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div id="pdf-merge-result-view" class="hidden flex-col gap-8 items-center w-full text-center">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Merge Complete!</h2>
        <a id="pdf-merge-download-link" href="#" class="btn-download" style="width: 100%; max-width: 400px; height: 56px; font-size: 1rem;">
          Download PDF
        </a>
        <button id="pdf-merge-reset-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">
          ← Merge more PDFs
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { PDFDocument } from 'pdf-lib';

  const root = document.getElementById('pdf-merge-root') as HTMLDivElement;
  if (root) {
    const blobUrlsToRevoke: string[] = [];
    const dropZone = document.getElementById('pdf-merge-drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('pdf-merge-file-input') as HTMLInputElement;
    const placeholder = document.getElementById('pdf-merge-upload-placeholder') as HTMLDivElement;
    const previewContainer = document.getElementById('pdf-merge-preview-container') as HTMLDivElement;
    const bulkText = document.getElementById('pdf-merge-bulk-text') as HTMLDivElement;
    const changeBtn = document.getElementById('pdf-merge-change-btn') as HTMLButtonElement;
    const convertBtn = document.getElementById('pdf-merge-convert-btn') as HTMLButtonElement;
    
    const statusPanel = document.getElementById('pdf-merge-status-panel') as HTMLDivElement;
    const processing = document.getElementById('pdf-merge-processing') as HTMLDivElement;
    const progressBar = document.getElementById('pdf-merge-progress-bar') as HTMLDivElement;
    const statusText = document.getElementById('pdf-merge-status-text') as HTMLDivElement;
    const resultView = document.getElementById('pdf-merge-result-view') as HTMLDivElement;
    const downloadLink = document.getElementById('pdf-merge-download-link') as HTMLAnchorElement;
    const resetBtn = document.getElementById('pdf-merge-reset-btn') as HTMLButtonElement;

    let selectedFiles: File[] = [];

    dropZone.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('button')) {
        fileInput.value = ''; fileInput.click();
      }
    });
    
    changeBtn.addEventListener('click', (e) => {
      blobUrlsToRevoke.forEach(u => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      e.stopPropagation();
      fileInput.value = ''; fileInput.click();
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('active');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('active');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('active');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) handleFiles(files);
    });

    fileInput.addEventListener('change', (e: any) => {
      const files = e.target.files;
      if (files && files.length > 0) handleFiles(files);
    });

    function handleFiles(filesList: FileList | File[]) {
      const arr = Array.from(filesList);
      selectedFiles = arr.filter(f => f.type === 'application/pdf').slice(0, 50);
      if (selectedFiles.length < 2) {
        alert("Please select at least 2 PDF files to merge.");
        return;
      }

      placeholder.classList.add('hidden');
      previewContainer.classList.remove('hidden');
      convertBtn.disabled = false;

      bulkText.innerHTML = `<strong>${selectedFiles.length} PDF(s) ready to merge:</strong><br/>` + 
                           selectedFiles.map((f, i) => `${i + 1}. ${f.name}`).join('<br/>');
      
      statusPanel.classList.add('hidden');
    }

    convertBtn.addEventListener('click', async () => {
      if (selectedFiles.length < 2) return;
      
      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      resultView.classList.add('hidden');
      convertBtn.disabled = true;
      statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        const mergedPdf = await PDFDocument.create();

        for (let i = 0; i < selectedFiles.length; i++) {
          statusText.textContent = `Merging file ${i+1} of ${selectedFiles.length}...`;
          progressBar.style.width = `${Math.round(((i) / selectedFiles.length) * 100)}%`;
          
          const file = selectedFiles[i];
          const arrayBuffer = await file.arrayBuffer();
          const pdfToMerge = await PDFDocument.load(arrayBuffer);
          const copiedPages = await mergedPdf.copyPages(pdfToMerge, pdfToMerge.getPageIndices());
          
          for (const page of copiedPages) {
            mergedPdf.addPage(page);
          }
        }

        statusText.textContent = 'Generating PDF...';
        progressBar.style.width = '100%';
        
        const pdfBytes = await mergedPdf.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
          blobUrlsToRevoke.push(url);
        
        downloadLink.href = url;
        downloadLink.download = `merged_document.pdf`;
        
        processing.classList.add('hidden');
        resultView.classList.remove('hidden');
        resultView.style.display = 'flex';
      } catch (err: any) {
        console.error(err);
        alert(err?.message || 'Merge failed.');
        processing.classList.add('hidden');
      } finally {
        convertBtn.disabled = false;
      }
    });

    resetBtn.addEventListener('click', () => {
      blobUrlsToRevoke.forEach(u => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      selectedFiles = [];
      previewContainer.classList.add('hidden');
      placeholder.classList.remove('hidden');
      statusPanel.classList.add('hidden');
      convertBtn.disabled = true;
      fileInput.value = '';
    });
  }
</script>
