---
interface Props {
  defaultTargetKB?: number;
}
const { defaultTargetKB = 100 } = Astro.props;
---

<div id="pdf-comp-root" style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
  <div class="panel p-5 md:p-8">
    
    <!-- Quick Target Size Switcher (No Reload) -->
    <div style="margin-bottom: 16px;">
      <span style="display: block; font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-ink-3); margin-bottom: 8px; text-align: center;">
        Quick PDF Target Presets
      </span>
      <div style="display: flex; justify-content: center; gap: 8px; flex-wrap: wrap;">
        {[50, 100, 150, 200, 300, 500].map((kb) => (
          <button
            type="button"
            class="pdf-preset-pill"
            data-kb={kb}
            style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; padding: 6px 14px; border-radius: 8px; background: var(--color-surface-2); border: 1px solid var(--color-border); color: var(--color-ink-2); cursor: pointer;"
          >
            {kb} KB
          </button>
        ))}
      </div>
    </div>

    <div style="display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 140px;">
        <label for="pdf-comp-target" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; color: var(--color-ink-3); margin-bottom: 8px; text-align: center;">Target Limit (KB)</label>
        <input type="number" id="pdf-comp-target" class="input-number" value={defaultTargetKB} min="15" max="20480" style="width: 100%; height: 56px; font-size: 1.5rem; text-align: center; background: var(--color-surface-1); border: 2px solid var(--color-border); border-radius: 12px; color: var(--color-ink); outline: none;" />
      </div>

      <div style="flex: 1; min-width: 180px;">
        <label for="pdf-comp-mode" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; color: var(--color-ink-3); margin-bottom: 8px; text-align: center;">Text Clarity Mode</label>
        <select id="pdf-comp-mode" class="input-number" style="width: 100%; height: 56px; font-size: 0.95rem; text-align: center; background: var(--color-surface-1); border: 2px solid var(--color-border); border-radius: 12px; color: var(--color-ink); outline: none; cursor: pointer;">
          <option value="crisp" selected>Document Crisp Mode (Sharp Text)</option>
          <option value="color">Standard Color Mode</option>
        </select>
      </div>
    </div>

    <!-- Multi-page Low Budget Advisory Banner -->
    <div id="pdf-budget-advisory" class="hidden" style="margin-bottom: 20px; padding: 12px 16px; border-radius: 10px; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.35); color: #fde047; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.5;">
      ⚠️ <strong>Multi-Page Clarity Notice:</strong> Compressing a multi-page PDF under 100KB divides the byte budget across all pages. Switching to <strong>200 KB</strong> or keeping <strong>Document Crisp Mode</strong> active is recommended for sharp text.
    </div>

    <div id="pdf-comp-drop-zone" class="drop-zone" style="min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 24px; position: relative; border-radius: 16px;">
      <input type="file" id="pdf-comp-file-input" style="display: none;" accept="application/pdf" />
      
      <div id="pdf-comp-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">Select PDF File</p>
          <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin: 0;">Preserves sharp typography & meets strict portal limits</p>
        </div>
        <button onclick="document.getElementById('pdf-comp-file-input').click()" class="btn-ghost" type="button" style="font-size: 0.75rem; z-index: 10;">Browse files</button>
      </div>

      <div id="pdf-comp-preview-container" class="hidden" style="position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; background: var(--color-surface-2); border-radius: 14px; z-index: 5;">
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); max-height: 200px; overflow-y: auto; width: 100%; text-align: center; padding: 16px;">
          <strong id="pdf-comp-filename" style="display: block; margin-bottom: 8px;"></strong>
          <span id="pdf-comp-original-size" style="color: var(--color-ink-2);"></span>
        </div>
        <button id="pdf-comp-change-btn" class="btn-ghost" type="button" style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem; z-index: 10; border-color: var(--color-lime); color: var(--color-lime);">Replace PDF</button>
      </div>
    </div>

    <button id="pdf-comp-convert-btn" class="btn-primary" disabled style="width: 100%; height: 56px; font-size: 1rem;" type="button">
      Compress PDF
    </button>
  </div>

  <div id="pdf-comp-status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px;">
      <div id="pdf-comp-processing" class="hidden" style="flex-direction: column; width: 100%; gap: 16px; padding: 16px 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); text-align: center;" id="pdf-comp-status-text">Processing...</div>
        <div style="width: 100%; max-width: 500px; margin: 0 auto; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden;">
          <div id="pdf-comp-progress-bar" style="width: 0%; height: 100%; background: currentColor; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div id="pdf-comp-result-view" class="hidden flex-col gap-6 items-center w-full text-center">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Compression Complete!</h2>
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink-2);">
          Final Size: <strong id="pdf-comp-final-size" style="color: var(--color-lime);"></strong>
          <div id="pdf-comp-method-note" style="font-size: 0.75rem; color: var(--color-ink-3); margin-top: 6px;"></div>
        </div>
        <a id="pdf-comp-download-link" href="#" class="btn-download" style="width: 100%; max-width: 400px; height: 56px; font-size: 1rem;">
          Download PDF
        </a>
        <button id="pdf-comp-reset-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">
          ← Replace / Compress another PDF
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" defer></script>

<script>
  import { jsPDF } from 'jspdf';
  import { PDFDocument } from 'pdf-lib';

  declare global {
    interface Window {
      pdfjsLib: any;
    }
  }

  const root = document.getElementById('pdf-comp-root') as HTMLDivElement;
  if (root) {
    const blobUrlsToRevoke: string[] = [];
    const dropZone = document.getElementById('pdf-comp-drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('pdf-comp-file-input') as HTMLInputElement;
    const placeholder = document.getElementById('pdf-comp-upload-placeholder') as HTMLDivElement;
    const previewContainer = document.getElementById('pdf-comp-preview-container') as HTMLDivElement;
    const fileNameText = document.getElementById('pdf-comp-filename') as HTMLSpanElement;
    const originalSizeText = document.getElementById('pdf-comp-original-size') as HTMLSpanElement;
    const changeBtn = document.getElementById('pdf-comp-change-btn') as HTMLButtonElement;
    const convertBtn = document.getElementById('pdf-comp-convert-btn') as HTMLButtonElement;
    const targetInput = document.getElementById('pdf-comp-target') as HTMLInputElement;
    const modeSelect = document.getElementById('pdf-comp-mode') as HTMLSelectElement;
    const advisoryBanner = document.getElementById('pdf-budget-advisory') as HTMLDivElement;
    const presetPills = document.querySelectorAll('.pdf-preset-pill');

    const statusPanel = document.getElementById('pdf-comp-status-panel') as HTMLDivElement;
    const processing = document.getElementById('pdf-comp-processing') as HTMLDivElement;
    const progressBar = document.getElementById('pdf-comp-progress-bar') as HTMLDivElement;
    const statusText = document.getElementById('pdf-comp-status-text') as HTMLDivElement;
    const resultView = document.getElementById('pdf-comp-result-view') as HTMLDivElement;
    const finalSizeText = document.getElementById('pdf-comp-final-size') as HTMLSpanElement;
    const methodNote = document.getElementById('pdf-comp-method-note') as HTMLDivElement;
    const downloadLink = document.getElementById('pdf-comp-download-link') as HTMLAnchorElement;
    const resetBtn = document.getElementById('pdf-comp-reset-btn') as HTMLButtonElement;

    let selectedFile: File | null = null;
    let fileArrayBuffer: ArrayBuffer | null = null;
    let detectedPageCount = 1;

    function updateAdvisory() {
      const targetKB = parseFloat(targetInput.value);
      if (detectedPageCount > 2 && targetKB <= 100) {
        advisoryBanner.classList.remove('hidden');
      } else {
        advisoryBanner.classList.add('hidden');
      }
      presetPills.forEach((p) => {
        const el = p as HTMLElement;
        if (parseFloat(el.dataset.kb || '0') === targetKB) {
          el.style.borderColor = 'var(--color-lime)';
          el.style.color = 'var(--color-lime)';
        } else {
          el.style.borderColor = 'var(--color-border)';
          el.style.color = 'var(--color-ink-2)';
        }
      });
    }
    updateAdvisory();

    presetPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const kb = (pill as HTMLElement).dataset.kb || '100';
        targetInput.value = kb;
        updateAdvisory();
      });
    });

    targetInput.addEventListener('input', updateAdvisory);

    async function loadPdfJs() {
      if (window.pdfjsLib) {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        return window.pdfjsLib;
      }
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        script.onload = () => {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc =
            'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          resolve(window.pdfjsLib);
        };
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    /**
     * Enhances contrast and converts to crisp grayscale so text edges remain sharp
     * at 60% smaller JPEG byte payloads (inspired by Pi7's pi7FilterPixels).
     */
    function applyDocumentCrispFilter(ctx: CanvasRenderingContext2D, width: number, height: number) {
      const imgData = ctx.getImageData(0, 0, width, height);
      const data = imgData.data;
      for (let i = 0; i < data.length; i += 4) {
        // Luminance grayscale
        const lum = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
        // S-curve contrast stretch to whiten paper background and darken ink strokes
        let c = lum;
        if (lum > 215) {
          c = 255;
        } else if (lum < 75) {
          c = Math.max(0, lum * 0.65);
        } else {
          c = ((lum - 75) / (215 - 75)) * 255;
        }
        data[i] = c;
        data[i + 1] = c;
        data[i + 2] = c;
      }
      ctx.putImageData(imgData, 0, 0);
    }

    dropZone.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('button')) {
        fileInput.value = '';
        fileInput.click();
      }
    });

    changeBtn.addEventListener('click', (e) => {
      blobUrlsToRevoke.forEach((u) => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      e.stopPropagation();
      fileInput.value = '';
      fileInput.click();
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('active');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('active');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('active');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', (e: any) => {
      const files = e.target.files;
      if (files && files.length > 0) handleFile(files[0]);
    });

    async function handleFile(file: File) {
      if (file.type !== 'application/pdf') {
        alert('Please select a valid PDF file.');
        return;
      }

      try {
        const pdfjs = await loadPdfJs();
        selectedFile = file;
        fileArrayBuffer = await file.arrayBuffer();

        const loadingTask = pdfjs.getDocument({ data: fileArrayBuffer.slice(0) });
        const pdf = await loadingTask.promise;
        detectedPageCount = pdf.numPages;

        placeholder.classList.add('hidden');
        previewContainer.classList.remove('hidden');
        fileNameText.textContent = file.name;
        originalSizeText.textContent = `Original: ${(file.size / 1024).toFixed(2)} KB · ${detectedPageCount} Page(s)`;
        convertBtn.disabled = false;
        statusPanel.classList.add('hidden');
        updateAdvisory();
      } catch (err) {
        alert('Failed to read PDF file.');
      }
    }

    convertBtn.addEventListener('click', async () => {
      if (!selectedFile || !fileArrayBuffer) return;

      const targetKB = parseFloat(targetInput.value);
      if (isNaN(targetKB) || targetKB <= 0) {
        alert('Please enter a valid target KB.');
        return;
      }

      const targetBytes = Math.floor(targetKB * 1024);
      const isCrispMode = modeSelect.value === 'crisp';

      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      resultView.classList.add('hidden');
      convertBtn.disabled = true;
      statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        statusText.textContent = 'Tier 1: Checking native vector stream compression...';
        progressBar.style.width = '15%';

        // TIER 1: Attempt pure vector preservation via pdf-lib object stream packing
        let finalBlob: Blob | null = null;
        let usedVectorTier = false;

        try {
          const pdfDoc = await PDFDocument.load(fileArrayBuffer.slice(0), { ignoreEncryption: true });
          pdfDoc.setTitle('');
          pdfDoc.setAuthor('');
          pdfDoc.setSubject('');
          pdfDoc.setKeywords([]);
          pdfDoc.setProducer('');
          pdfDoc.setCreator('');
          const packedBytes = await pdfDoc.save({ useObjectStreams: true });
          if (packedBytes.byteLength <= targetBytes) {
            finalBlob = new Blob([packedBytes], { type: 'application/pdf' });
            usedVectorTier = true;
          }
        } catch {
          // Proceed to Tier 2 if pdf-lib stream packing is insufficient
        }

        // TIER 2: High-Resolution Crisp Rasterization with Readability Floor
        if (!finalBlob) {
          const pdfjs = await loadPdfJs();
          const loadingTask = pdfjs.getDocument({ data: fileArrayBuffer.slice(0) });
          const pdf = await loadingTask.promise;
          const totalPages = pdf.numPages;

          // Try high-clarity scale ladder (from 2.2x down to 1.25x, never below readable DPI)
          const scaleCandidates = totalPages === 1 ? [2.2, 1.8, 1.4, 1.15] : [1.8, 1.45, 1.15, 0.95];
          const qualityFloor = targetKB <= 50 ? 0.28 : 0.38;

          for (let sIdx = 0; sIdx < scaleCandidates.length; sIdx++) {
            const scaleFactor = scaleCandidates[sIdx];
            statusText.textContent = `Rendering crisp pages at ${Math.round(scaleFactor * 96)} DPI...`;
            progressBar.style.width = `${25 + sIdx * 15}%`;

            const renderedPages: { canvas: HTMLCanvasElement; width: number; height: number }[] = [];

            for (let i = 1; i <= totalPages; i++) {
              await new Promise((r) => setTimeout(r, 0));
              const page = await pdf.getPage(i);
              const viewport = page.getViewport({ scale: scaleFactor });

              const canvas = document.createElement('canvas');
              canvas.width = Math.round(viewport.width);
              canvas.height = Math.round(viewport.height);
              const ctx = canvas.getContext('2d')!;
              ctx.fillStyle = '#FFFFFF';
              ctx.fillRect(0, 0, canvas.width, canvas.height);

              await page.render({ canvasContext: ctx, viewport }).promise;
              if (isCrispMode) {
                applyDocumentCrispFilter(ctx, canvas.width, canvas.height);
              }
              renderedPages.push({ canvas, width: canvas.width, height: canvas.height });
              page.cleanup();
            }

            // Binary search quality between [qualityFloor, 0.92]
            let minQ = qualityFloor;
            let maxQ = 0.92;
            let bestAtScale: Blob | null = null;

            for (let iter = 0; iter < 7; iter++) {
              await new Promise((r) => setTimeout(r, 0));
              const midQ = (minQ + maxQ) / 2;

              const doc = new jsPDF({
                orientation: renderedPages[0].width > renderedPages[0].height ? 'l' : 'p',
                unit: 'px',
                format: [renderedPages[0].width, renderedPages[0].height],
                compress: true
              });

              for (let p = 0; p < renderedPages.length; p++) {
                if (p > 0) {
                  doc.addPage(
                    [renderedPages[p].width, renderedPages[p].height],
                    renderedPages[p].width > renderedPages[p].height ? 'l' : 'p'
                  );
                }
                const dataUrl = renderedPages[p].canvas.toDataURL('image/jpeg', midQ);
                doc.addImage(dataUrl, 'JPEG', 0, 0, renderedPages[p].width, renderedPages[p].height, undefined, 'FAST');
              }

              const candidate = doc.output('blob');
              if (candidate.size <= targetBytes) {
                bestAtScale = candidate;
                minQ = midQ;
                if (candidate.size >= targetBytes * 0.92) break;
              } else {
                maxQ = midQ;
              }
            }

            // Cleanup canvases if we need another scale pass or if we succeeded
            if (bestAtScale || sIdx === scaleCandidates.length - 1) {
              if (!bestAtScale) {
                // Final fallback at lowest allowed floor
                const doc = new jsPDF({
                  orientation: renderedPages[0].width > renderedPages[0].height ? 'l' : 'p',
                  unit: 'px',
                  format: [renderedPages[0].width, renderedPages[0].height],
                  compress: true
                });
                for (let p = 0; p < renderedPages.length; p++) {
                  if (p > 0) {
                    doc.addPage(
                      [renderedPages[p].width, renderedPages[p].height],
                      renderedPages[p].width > renderedPages[p].height ? 'l' : 'p'
                    );
                  }
                  const dataUrl = renderedPages[p].canvas.toDataURL('image/jpeg', 0.22);
                  doc.addImage(dataUrl, 'JPEG', 0, 0, renderedPages[p].width, renderedPages[p].height, undefined, 'FAST');
                }
                bestAtScale = doc.output('blob');
              }
              renderedPages.forEach((rp) => {
                rp.canvas.width = 0;
                rp.canvas.height = 0;
              });
              finalBlob = bestAtScale;
              break;
            }

            renderedPages.forEach((rp) => {
              rp.canvas.width = 0;
              rp.canvas.height = 0;
            });
          }
          pdf.destroy();
        }

        progressBar.style.width = '100%';
        statusText.textContent = 'Done!';

        if (finalBlob) {
          const finalSizeKB = (finalBlob.size / 1024).toFixed(2);
          finalSizeText.textContent = `${finalSizeKB} KB (Limit: ${targetKB} KB)`;
          methodNote.textContent = usedVectorTier
            ? '✓ 100% Native Vector Text Preserved (Zero Raster Blur)'
            : isCrispMode
              ? '✓ High-Contrast Document Crisp Mode Applied for Sharp Typography'
              : '✓ High-DPI Color Compression Applied';

          const url = URL.createObjectURL(finalBlob);
          blobUrlsToRevoke.push(url);
          downloadLink.href = url;
          const originalName = selectedFile.name.replace(/\.pdf$/i, '');
          downloadLink.download = `${originalName}_${targetKB}kb.pdf`;

          processing.classList.add('hidden');
          resultView.classList.remove('hidden');
          resultView.style.display = 'flex';
        }
      } catch (err: any) {
        console.error(err);
        alert(err?.message || 'Compression failed.');
        processing.classList.add('hidden');
      } finally {
        convertBtn.disabled = false;
      }
    });

    resetBtn.addEventListener('click', () => {
      blobUrlsToRevoke.forEach((u) => URL.revokeObjectURL(u));
      blobUrlsToRevoke.length = 0;
      selectedFile = null;
      fileArrayBuffer = null;
      previewContainer.classList.add('hidden');
      placeholder.classList.remove('hidden');
      statusPanel.classList.add('hidden');
      advisoryBanner.classList.add('hidden');
      convertBtn.disabled = true;
      fileInput.value = '';
    });
  }
</script>

