---
interface Props {
  defaultKB?: number;
  hideHeader?: boolean;
  allowMultiple?: boolean;
}

const { defaultKB = 20, hideHeader = false, allowMultiple = false } = Astro.props;
---

<div
  id="compressor-root"
  style="max-width: 860px; margin: 0 auto; padding: 0 24px;"
>

  { !hideHeader && (
    <!-- Page header -->
    <div style="text-align: center; margin-bottom: 48px;">
      <div
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(200,241,53,0.08);
          border: 1px solid rgba(200,241,53,0.2);
          border-radius: 100px;
          padding: 5px 14px;
          margin-bottom: 24px;
        "
      >
        <span
          style="
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-lime);
          "
        >Precision Tool: Image Compression</span>
      </div>
      <h1
        style="
          font-size: clamp(2.5rem, 6vw, 4.25rem);
          line-height: 1.05;
          margin: 0 0 16px;
          letter-spacing: -0.02em;
        "
      >
        Compress to<br/>
        <span
          style="
            color: var(--color-lime);
            display: inline-block;
          "
        >Exact Size</span>
      </h1>
      <p
        style="
          font-size: 1.0625rem;
          color: var(--color-ink-2);
          max-width: 440px;
          margin: 0 auto;
          line-height: 1.65;
        "
      >
        Upload your images, set a KB target. Supports instant bulk processing.
      </p>
    </div>
  )}

  <!-- Main panel -->
  <div class="panel p-5 md:p-8">

    <!-- Drop Zone -->
    <div
      id="drop-zone"
      class="drop-zone"
      style="
        min-height: 280px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        margin-bottom: 24px;
        position: relative;
        border-radius: 16px;
      "
    >
      {allowMultiple ? (
        <input
          type="file"
          id="file-input"
          style="display: none;"
          accept="image/jpeg,image/png,image/webp"
          multiple="multiple"
        />
      ) : (
        <input
          type="file"
          id="file-input"
          style="display: none;"
          accept="image/jpeg,image/png,image/webp"
        />
      )}

      <!-- Upload placeholder -->
      <div id="upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div
          style="
            width: 56px;
            height: 56px;
            border-radius: 12px;
            background: var(--color-surface-3);
            border: 1px solid var(--color-border-mid);
            display: flex;
            align-items: center;
            justify-content: center;
          "
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-lime)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <div>
          <p
            style="
              font-family: var(--font-display);
              font-size: 1.125rem;
              font-weight: 700;
              letter-spacing: -0.03em;
              color: var(--color-ink);
              margin: 0 0 4px;
            "
          >{allowMultiple ? 'Drop image(s) here' : 'Drop image here'}</p>
          <p
            style="
              font-family: var(--font-mono);
              font-size: 0.6875rem;
              color: var(--color-ink-3);
              margin: 0;
              text-transform: uppercase;
              letter-spacing: 0.08em;
            "
          >JPEG · PNG · WEBP</p>
        </div>
        <button
          onclick="document.getElementById('file-input').click()"
          class="btn-ghost"
          type="button"
          style="font-size: 0.75rem;"
        >
          Browse files
        </button>
      </div>

      <!-- Uploading state -->
      <div id="upload-loading" class="hidden" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div class="spinner"></div>
        <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.08em;">
          Reading file...
        </p>
      </div>

      <!-- Preview state -->
      <div
        id="image-preview-container"
        class="hidden"
        style="
          position: absolute;
          inset: 2px;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 12px;
          background: var(--color-surface-2);
          border-radius: 14px;
        "
      >
        <img
          id="upload-preview"
          src=""
          alt="Preview"
          style="
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 8px;
          "
        />
        <button
          id="change-image-btn"
          class="btn-ghost"
          type="button"
          style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem;"
        >
          Change
        </button>
      </div>
    </div>

    <!-- File info pills -->
    <div
      id="file-info-bar"
      class="hidden"
      style="
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
      "
    >
      <span class="stat-pill" style="font-size: 0.6875rem; padding: 4px 12px;">
        <span class="label">Original</span>
        <span class="value" id="preview-size-tag">—</span>
      </span>
      <span class="stat-pill" style="font-size: 0.6875rem; padding: 4px 12px;">
        <span class="label">Format</span>
        <span class="value" id="preview-type-tag">—</span>
      </span>
    </div>

    <!-- Controls row -->
    <div
      style="
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
      "
    >
      <!-- Target KB input -->
      <div style="flex: 1; min-width: 140px;">
        <label
          for="target-kb"
          style="
            display: block;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-ink-3);
            margin-bottom: 8px;
            text-align: center;
          "
        >Target size</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input
            type="number"
            id="target-kb"
            value={defaultKB > 5000 ? (defaultKB / 1024).toFixed(0) : defaultKB}
            min="5"
            max="50000"
            class="input-number"
            style="padding-right: 70px; padding-left: 16px; font-size: 1.25rem; height: 56px; width: 100%; text-align: center;"
          />
          <select
            id="target-unit"
            style="
              position: absolute;
              right: 8px;
              top: 50%;
              transform: translateY(-50%);
              background: var(--color-surface-3) url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2210%22%20height%3D%226%22%20viewBox%3D%220%200%2010%206%22%20fill%3D%22none%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M1%201L5%205L9%201%22%20stroke%3D%22%2362666D%22%20stroke-width%3D%221.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22/%3E%3C/svg%3E') no-repeat right 10px center;
              border: 1px solid var(--color-border);
              border-radius: 6px;
              color: var(--color-ink-3);
              font-family: var(--font-mono);
              font-size: 0.6875rem;
              font-weight: 700;
              padding: 4px 24px 4px 8px;
              cursor: pointer;
              outline: none;
              appearance: none;
              text-align: left;
              min-width: 58px;
            "
          >
            <option value="kb" selected={defaultKB <= 5000}>KB</option>
            <option value="mb" selected={defaultKB > 5000}>MB</option>
          </select>
        </div>
      </div>

      <!-- Output Format input -->
      <div style="flex: 1; min-width: 140px;">
        <label
          for="output-format"
          style="
            display: block;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-ink-3);
            margin-bottom: 8px;
            text-align: center;
          "
        >Output Format</label>
        <select
          id="output-format"
          class="input-number"
          style="
            width: 100%;
            height: 56px;
            font-size: 1.125rem;
            text-align: center;
            background: var(--color-surface-1) url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2210%22%20height%3D%226%22%20viewBox%3D%220%200%2010%206%22%20fill%3D%22none%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M1%201L5%205L9%201%22%20stroke%3D%22%2362666D%22%20stroke-width%3D%221.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22/%3E%3C/svg%3E') no-repeat right 16px center;
            appearance: none;
            cursor: pointer;
            border: 2px solid var(--color-border);
            border-radius: 12px;
            color: var(--color-ink);
            outline: none;
          "
        >
          <option value="auto" selected>Keep Original</option>
          <option value="image/jpeg">JPG</option>
          <option value="image/png">PNG</option>
          <option value="image/webp">WEBP</option>
          <option value="application/pdf">PDF</option>
        </select>
      </div>
    </div>

      <!-- Compress button -->
      <button
        id="compress-btn"
        class="btn-primary"
        disabled
        style="width: 100%; height: 56px; font-size: 1rem; margin-top: 8px;"
        type="button"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Instant Optimize
      </button>
    </div>
  </div>

  <!-- Result / Status Panel -->
  <div id="status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px md:padding: 32px;">

      <!-- Processing state (Terminal Style) -->
      <div id="processing" class="hidden" style="flex-direction: column; width: 100%; gap: 24px; padding: 24px 0;">
        <!-- Terminal Window -->
        <div style="background: #0a0a0b; border: 1px solid var(--color-border-mid); border-radius: 12px; width: 100%; max-width: 500px; margin: 0 auto; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.4);">
          <!-- Title Bar -->
          <div style="background: var(--color-surface-3); padding: 8px 16px; border-bottom: 1px solid var(--color-border); display: flex; align-items: center; gap: 8px;">
            <div style="display: flex; gap: 6px;">
              <div style="width: 10px; height: 10px; border-radius: 50%; background: #ff5f56;"></div>
              <div style="width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e;"></div>
              <div style="width: 10px; height: 10px; border-radius: 50%; background: #27c93f;"></div>
            </div>
            <span style="font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.1em; margin-left: 8px;">Target-Lock Console v3.0</span>
          </div>
          <!-- Lines -->
          <div style="padding: 20px; text-align: left; font-family: var(--font-mono); min-height: 160px; display: flex; flex-direction: column; justify-content: flex-start;">
            <div id="terminal-lines"></div>
            <div style="display: flex; align-items: center; gap: 4px;">
              <span id="terminal-cursor" class="terminal-cursor">_</span>
            </div>
          </div>
        </div>

        <div style="width: 100%; max-width: 500px; margin: 0 auto;">
          <div style="width: 100%; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
            <div id="progress-bar" style="width: 0%; height: 100%; background: var(--color-lime); transition: width 0.3s ease;"></div>
          </div>
          <p style="font-family: var(--font-mono); font-size: 0.625rem; color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">System processing payload...</p>
        </div>
      </div>

      <!-- Result view -->
      <div
        id="result-view"
        class="hidden flex-col gap-8 items-start w-full"
      >
        <!-- Top Half: Grid for Image & Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-start w-full">
          <!-- Left: preview -->
          <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
            <div
              style="
                aspect-ratio: 4/3;
                background: var(--color-surface-2);
                border: 1px solid var(--color-border);
                border-radius: 12px;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 16px;
                width: 100%;
              "
            >
              <img
                id="preview-img"
                src=""
                alt="Compressed result"
                style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 6px;"
              />
              <div id="pdf-preview-icon" style="display: none; flex-direction: column; align-items: center; gap: 12px; color: var(--color-ink-2);">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <path d="M12 18v-6"></path>
                  <path d="M9 15h6"></path>
                </svg>
                <span style="font-family: var(--font-mono); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.05em;">PDF READY</span>
              </div>
            </div>
            <div class="badge-success" style="align-self: flex-start;">
              SUCCESS
            </div>
          </div>

          <!-- Right: stats -->
          <div style="display: flex; flex-direction: column; gap: 24px; width: 100%;">
            <div>
              <h2
                style="
                  font-size: 1.5rem;
                  font-weight: 800;
                  letter-spacing: -0.04em;
                  margin: 0 0 8px;
                "
              >Ready for download</h2>
              <p
                id="algo-log"
                style="
                  font-family: var(--font-mono);
                  font-size: 0.75rem;
                  color: var(--color-ink-2);
                  margin: 0;
                  line-height: 1.6;
                "
              >Mathematical optimum identified.</p>
            </div>

            <!-- Metrics grid -->
            <div class="grid grid-cols-2 gap-2">
              <div class="metric-card" style="padding: 12px;">
                <span class="metric-label" style="font-size: 0.625rem;">Final Size</span>
                <span class="metric-value" style="font-size: 1.25rem;" id="result-size">—</span>
              </div>
              <div class="metric-card accent" style="padding: 12px;">
                <span class="metric-label" style="font-size: 0.625rem;">Savings</span>
                <span class="metric-value" style="font-size: 1.25rem;" id="savings-percent">—</span>
              </div>
              <div class="metric-card" style="padding: 12px;">
                <span class="metric-label" style="font-size: 0.625rem;">Quality</span>
                <span class="metric-value" style="font-size: 1.25rem;" id="quality-tag">—</span>
              </div>
              <div class="metric-card" style="padding: 12px;">
                <span class="metric-label" style="font-size: 0.625rem;">Time</span>
                <span class="metric-value" style="font-size: 1.25rem;" id="processing-time">—</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Full Width Buttons -->
        <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
          <div style="position: relative;">
            <label for="rename-input" style="display: block; font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-ink-3); margin-bottom: 6px; text-align: center;">Rename File (Optional)</label>
            <input 
              type="text" 
              id="rename-input" 
              placeholder="Enter custom name..." 
              class="input-number"
              style="width: 100%; height: 56px; font-size: 1rem; padding: 0 12px; text-align: center;"
            />
          </div>

          <a
            id="download-link"
            href="#"
            download="compressed.jpg"
            class="btn-download"
            style="width: 100%; height: 56px; font-size: 1rem;"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            Download JPEG
          </a>

          <!-- Compress again -->
          <button
            id="reset-btn"
            class="btn-ghost"
            type="button"
            style="align-self: center; font-size: 0.75rem; margin-top: 12px;"
          >
            ← Optimize another
          </button>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  import { compressToTarget } from '../utils/imageCompressor';
  import JSZip from 'jszip';

  /* ── Elements ── */
  const dropZone     = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput    = document.getElementById('file-input') as HTMLInputElement;
  const targetInput  = document.getElementById('target-kb') as HTMLInputElement;
  const unitSelect   = document.getElementById('target-unit') as HTMLSelectElement;
  const outputFormatSelect = document.getElementById('output-format') as HTMLSelectElement;
  const compressBtn  = document.getElementById('compress-btn') as HTMLButtonElement;
  const statusPanel  = document.getElementById('status-panel') as HTMLDivElement;
  const processing   = document.getElementById('processing') as HTMLDivElement;
  const resultView   = document.getElementById('result-view') as HTMLDivElement;
  const previewImg   = document.getElementById('preview-img') as HTMLImageElement;
  const pdfIcon = document.getElementById('pdf-preview-icon') as HTMLDivElement;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
  const renameInput  = document.getElementById('rename-input') as HTMLInputElement;

  const uploadPlaceholder  = document.getElementById('upload-placeholder') as HTMLDivElement;
  const uploadLoading      = document.getElementById('upload-loading') as HTMLDivElement;
  const previewContainer   = document.getElementById('image-preview-container') as HTMLDivElement;
  const uploadPreview      = document.getElementById('upload-preview') as HTMLImageElement;
  const fileInfoBar        = document.getElementById('file-info-bar') as HTMLDivElement;
  const changeImageBtn     = document.getElementById('change-image-btn') as HTMLButtonElement;
  const resetBtn           = document.getElementById('reset-btn') as HTMLButtonElement;

  let selectedFiles: File[] = [];

  /* ── Drop zone interactions ── */
  dropZone.addEventListener('click', (e) => {
    if (e.target === changeImageBtn || e.target === uploadLoading) return;
    fileInput.click();
  });

  changeImageBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });

  fileInput.addEventListener('change', (e: any) => {
    const files = e.target.files;
    if (files && files.length > 0) handleFiles(files);
  });

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('active');
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('active');
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('active');
    const files = e.dataTransfer?.files;
    if (files && files.length > 0) handleFiles(files);
  });

  /* ── Handle file(s) ── */
  async function handleFiles(filesList: FileList | File[]) {
    const arr = Array.from(filesList);
    const validFiles = arr.filter(f => f.type.startsWith('image/'));
    if (validFiles.length === 0) return;

    const isMultipleAllowed = fileInput.multiple || fileInput.hasAttribute('multiple');
    let filesToProcess = isMultipleAllowed ? validFiles.slice(0, 50) : [validFiles[0]];
    
    if (isMultipleAllowed) {
      const currentNames = new Set(selectedFiles.map(f => f.name));
      const newFiles = filesToProcess.filter(f => !currentNames.has(f.name));
      selectedFiles = [...selectedFiles, ...newFiles].slice(0, 50);
      changeImageBtn.textContent = 'Add more';
    } else {
      selectedFiles = filesToProcess;
    }
    compressBtn.disabled = true;

    // Show upload state
    uploadPlaceholder.classList.add('hidden');
    previewContainer.classList.add('hidden');
    uploadLoading.classList.remove('hidden');
    uploadLoading.style.display = 'flex';

    if (selectedFiles.length === 1) {
      const file = selectedFiles[0];
      const reader = new FileReader();
      reader.onload = (e) => {
        uploadPreview.style.display = 'block';
        uploadPreview.src = e.target?.result as string;
        
        let bulkText = document.getElementById('bulk-preview-text');
        if(bulkText) bulkText.style.display = 'none';

        uploadLoading.classList.add('hidden');
        uploadLoading.style.display = 'none';
        previewContainer.classList.remove('hidden');
        previewContainer.style.display = 'flex';
        compressBtn.disabled = false;
      };
      reader.readAsDataURL(file);

      const sizeTag    = document.getElementById('preview-size-tag')!;
      const typeTag    = document.getElementById('preview-type-tag')!;
      sizeTag.textContent = (file.size / 1024).toFixed(1) + ' KB';
      typeTag.textContent = file.type.split('/')[1].toUpperCase();
    } else {
      // Multiple files preview
      uploadPreview.style.display = 'none';
      let bulkText = document.getElementById('bulk-preview-text');
      if (!bulkText) {
        bulkText = document.createElement('div');
        bulkText.id = 'bulk-preview-text';
        bulkText.style.cssText = 'font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); text-align: left; padding: 16px 24px; word-break: break-word; overflow-y: auto; max-height: 200px; line-height: 1.6; width: 100%;';
        previewContainer.insertBefore(bulkText, uploadPreview);
      }
      bulkText.style.display = 'block';
      
      bulkText.innerHTML = selectedFiles.map((f, i) => `${i + 1}. ${f.name}`).join('<br/>');

      uploadLoading.classList.add('hidden');
      uploadLoading.style.display = 'none';
      previewContainer.classList.remove('hidden');
      previewContainer.style.display = 'flex';
      compressBtn.disabled = false;

      const sizeTag    = document.getElementById('preview-size-tag')!;
      const typeTag    = document.getElementById('preview-type-tag')!;
      const totalSize = selectedFiles.reduce((acc, f) => acc + f.size, 0);
      sizeTag.textContent = (totalSize / 1024 / 1024).toFixed(2) + ' MB total';
      typeTag.textContent = 'MIXED';
    }

    fileInfoBar.classList.remove('hidden');
    fileInfoBar.style.display = 'flex';
    statusPanel.classList.add('hidden');
  }

  /* ── Compress ── */
  compressBtn.addEventListener('click', async () => {
    if (selectedFiles.length === 0) return;
    
    let rawValue = parseFloat(targetInput.value);
    const unit = unitSelect.value;
    
    if (isNaN(rawValue) || rawValue <= 0) return;
    const targetKB = unit === 'mb' ? rawValue * 1024 : rawValue;
    const targetFormat = outputFormatSelect.value as 'image/jpeg' | 'image/png' | 'image/webp' | 'application/pdf' | 'auto';

    if (targetKB < 5) {
      alert('Minimum target is 5KB. Most images cannot be compressed below this.');
      return;
    }

    statusPanel.classList.remove('hidden');
    processing.classList.remove('hidden');
    processing.style.display = 'flex';
    resultView.classList.add('hidden');
    compressBtn.disabled = true;

    statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

    try {
      const startTime = performance.now();
      const progressBar  = document.getElementById('progress-bar') as HTMLDivElement;
      const termLines    = document.getElementById('terminal-lines') as HTMLDivElement;
      const termCursor   = document.getElementById('terminal-cursor') as HTMLSpanElement;

      termLines.innerHTML = '';
      termCursor.style.display = 'inline';
      progressBar.style.width = '0%';

      if (selectedFiles.length === 1) {
        // --- SINGLE FILE LOGIC ---
        const selectedFile = selectedFiles[0];
        const actualFormat = targetFormat === 'auto' ? selectedFile.type : targetFormat;
        const ext = actualFormat === 'image/png' ? 'png' : actualFormat === 'image/webp' ? 'webp' : actualFormat === 'application/pdf' ? 'pdf' : 'jpg';

        const result = await compressToTarget(selectedFile, targetKB, 12, targetFormat);
        const endTime = performance.now();
        const timeInSeconds = ((endTime - startTime) / 1000).toFixed(1) + 's';
        const url    = URL.createObjectURL(result.blob);

        const finalKB  = (result.blob.size / 1024).toFixed(1);
        const savedPct = Math.abs(Math.round((1 - result.blob.size / selectedFile.size) * 100));
        const inputKB  = (selectedFile.size / 1024).toFixed(1);

        const lines = [
          { text: `$ imgshrink --target ${targetKB}kb --format ${ext}`, color: '#c8f135',              delay: 0   },
          { text: `  reading input   ·  ${inputKB}kb`,          color: 'rgba(255,255,255,0.38)', delay: 160 },
          { text: `  binary search   ·  ${result.iterations ?? 8} iterations  ·  converged`, color: 'rgba(255,255,255,0.38)', delay: 340 },
          { text: `  output          ·  ${finalKB}kb`, color: 'rgba(255,255,255,0.38)', delay: 680 },
          { text: `✓ done`,                                                  color: '#c8f135',              delay: 860 },
        ];

        for (let i = 0; i < lines.length; i++) {
          const el = document.createElement('div');
          el.style.cssText = `font-size:0.75rem;color:${lines[i].color};letter-spacing:0.02em;opacity:0;transition:opacity 0.15s ease;white-space:pre;margin-bottom:5px;line-height:1.5;`;
          el.textContent = lines[i].text;
          termLines.appendChild(el);
          requestAnimationFrame(() => requestAnimationFrame(() => { el.style.opacity = '1'; }));
          progressBar.style.width = `${Math.round((i + 1) / lines.length * 100)}%`;
        }

        termCursor.style.display = 'none';
        termCursor.style.display = 'none';
        progressBar.style.width = '100%';

        if (ext === 'pdf') {
          previewImg.style.display = 'none';
          pdfIcon.style.display = 'flex';
        } else {
          previewImg.style.display = 'block';
          previewImg.src      = url;
          pdfIcon.style.display = 'none';
        }
        
        let bulkResultText = document.getElementById('bulk-result-text');
        if (bulkResultText) bulkResultText.style.display = 'none';

        downloadLink.href   = url;
        
        const cleanOriginalName = selectedFile.name.split('.')[0].replace(/\s+/g, '_');
        const defaultName = `${cleanOriginalName}_${rawValue}${unit}`;
        renameInput.value = defaultName;
        downloadLink.download = `${defaultName}.${ext}`;

        renameInput.oninput = () => {
          const customName = renameInput.value.trim() || defaultName;
          downloadLink.download = `${customName}.${ext}`;
        };

        const resKB    = result.size / 1024;
        const origKB   = selectedFile.size / 1024;
        const isUpsized = result.size > selectedFile.size;

        document.getElementById('result-size')!.textContent     = resKB.toFixed(1) + ' KB';
        
        const savingsEl = document.getElementById('savings-percent')!;
        const savingsLabel = savingsEl.previousElementSibling as HTMLElement;
        
        if (isUpsized) {
          const growth = ((resKB / origKB - 1) * 100).toFixed(0);
          savingsEl.textContent = `+${growth}%`;
          savingsLabel.textContent = 'Growth';
        } else {
          const savings  = ((origKB - resKB) / origKB * 100).toFixed(0);
          savingsEl.textContent = savings + '%';
          savingsLabel.textContent = 'Savings';
        }

        document.getElementById('quality-tag')!.textContent     = Math.round(result.quality * 100) + '%';
        document.getElementById('processing-time')!.textContent = timeInSeconds;
        
        document.getElementById('algo-log')!.textContent        = isUpsized
          ? `Enhancement mode: Upscaled for target size.`
          : `Smart Scaling: Adjusted dimensions and quality.`;

        downloadLink.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg> Download ${ext.toUpperCase()}`;
        downloadLink.classList.remove('animate-jump');
      } else {
        // --- BULK FILE LOGIC ---
        const el = document.createElement('div');
        el.style.cssText = `font-size:0.75rem;color:#c8f135;letter-spacing:0.02em;opacity:1;white-space:pre;margin-bottom:5px;line-height:1.5;`;
        el.textContent = `$ imgshrink --batch ${selectedFiles.length} --target ${targetKB}kb`;
        termLines.appendChild(el);

        const zip = new JSZip();
        let totalProcessed = 0;
        let totalOrigSize = 0;
        let totalResSize = 0;
        
          for (let i = 0; i < selectedFiles.length; i += 4) {
          const batch = selectedFiles.slice(i, i + 4);
          const batchPromises = batch.map(async (file) => {
             const actualFormat = targetFormat === 'auto' ? file.type : targetFormat;
             const ext = actualFormat === 'image/png' ? 'png' : actualFormat === 'image/webp' ? 'webp' : actualFormat === 'application/pdf' ? 'pdf' : 'jpg';
             const result = await compressToTarget(file, targetKB, 12, targetFormat);
             const cleanOriginalName = file.name.split('.')[0].replace(/\s+/g, '_');
             const filename = `${cleanOriginalName}_compressed.${ext}`;
             zip.file(filename, result.blob);
             totalOrigSize += file.size;
             totalResSize += result.size;
             return result;
          });
          
          await Promise.all(batchPromises);
          
          totalProcessed += batch.length;
          progressBar.style.width = `${Math.round((totalProcessed / selectedFiles.length) * 80)}%`;
          
          const msgEl = document.createElement('div');
          msgEl.style.cssText = `font-size:0.75rem;color:rgba(255,255,255,0.38);letter-spacing:0.02em;opacity:1;white-space:pre;margin-bottom:5px;line-height:1.5;`;
          msgEl.textContent = `  processed ${totalProcessed}/${selectedFiles.length} images...`;
          termLines.appendChild(msgEl);
          termLines.scrollTop = termLines.scrollHeight;
        }
        
        const msgElZipping = document.createElement('div');
        msgElZipping.style.cssText = `font-size:0.75rem;color:rgba(255,255,255,0.38);letter-spacing:0.02em;opacity:1;white-space:pre;margin-bottom:5px;line-height:1.5;`;
        msgElZipping.textContent = `  compressing into zip archive...`;
        termLines.appendChild(msgElZipping);
        termLines.scrollTop = termLines.scrollHeight;

        const zipBlob = await zip.generateAsync({ type: 'blob' });
        progressBar.style.width = '100%';
        
        const doneEl = document.createElement('div');
        doneEl.style.cssText = `font-size:0.75rem;color:#c8f135;letter-spacing:0.02em;opacity:1;white-space:pre;margin-bottom:5px;line-height:1.5;`;
        doneEl.textContent = `✓ done`;
        termLines.appendChild(doneEl);
        
        termCursor.style.display = 'none';
        termCursor.style.display = 'none';

        const url = URL.createObjectURL(zipBlob);
        
        previewImg.style.display = 'none';
        let bulkResultText = document.getElementById('bulk-result-text');
        if (!bulkResultText) {
          bulkResultText = document.createElement('div');
          bulkResultText.id = 'bulk-result-text';
          bulkResultText.style.cssText = 'font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--color-ink); text-align: center; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;';
          previewImg.parentElement!.appendChild(bulkResultText);
        }
        bulkResultText.style.display = 'flex';
        bulkResultText.textContent = `${selectedFiles.length} files zipped`;

        downloadLink.href = url;
        
        const defaultZipName = `imgshrink_batch_${targetKB}kb`;
        renameInput.value = defaultZipName;
        downloadLink.download = `${defaultZipName}.zip`;

        renameInput.oninput = () => {
          const customName = renameInput.value.trim() || defaultZipName;
          downloadLink.download = `${customName}.zip`;
        };
        
        const endTime = performance.now();
        const timeInSeconds = ((endTime - startTime) / 1000).toFixed(1) + 's';
        
        const resMB    = totalResSize / 1024 / 1024;
        const origKB   = totalOrigSize / 1024;
        const resKB    = totalResSize / 1024;
        const isUpsized = totalResSize > totalOrigSize;

        document.getElementById('result-size')!.textContent     = resMB.toFixed(2) + ' MB';
        
        const savingsEl = document.getElementById('savings-percent')!;
        const savingsLabel = savingsEl.previousElementSibling as HTMLElement;
        
        if (isUpsized) {
          const growth = ((resKB / origKB - 1) * 100).toFixed(0);
          savingsEl.textContent = `+${growth}%`;
          savingsLabel.textContent = 'Growth';
        } else {
          const savings  = ((origKB - resKB) / origKB * 100).toFixed(0);
          savingsEl.textContent = savings + '%';
          savingsLabel.textContent = 'Savings';
        }

        document.getElementById('quality-tag')!.textContent     = 'MIXED';
        document.getElementById('processing-time')!.textContent = timeInSeconds;
        
        document.getElementById('algo-log')!.textContent        = `Batch processing completed for ${selectedFiles.length} files.`;

        downloadLink.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg> Download ZIP`;
        
        // Add jump animation
        downloadLink.classList.remove('animate-jump');
        void downloadLink.offsetWidth;
        downloadLink.classList.add('animate-jump');
      }

      processing.classList.add('hidden');
      resultView.classList.remove('hidden');
      resultView.style.display = 'flex';

      downloadLink.classList.add('btn-glow');
      downloadLink.focus();

    } catch (err: any) {
      console.error(err);
      processing.classList.add('hidden');
      alert(err?.message || 'Compression failed. Please try a different image.');
    } finally {
      compressBtn.disabled = false;
    }
  });

  /* ── Reset ── */
  resetBtn.addEventListener('click', () => {
    selectedFiles = [];
    compressBtn.disabled = true;
    uploadPreview.src = '';
    
    let bulkText = document.getElementById('bulk-preview-text');
    if(bulkText) bulkText.style.display = 'none';
    uploadPreview.style.display = 'block';

    uploadPlaceholder.classList.remove('hidden');
    previewContainer.classList.add('hidden');
    previewContainer.style.display = 'none';
    fileInfoBar.classList.add('hidden');
    fileInfoBar.style.display = 'none';
    statusPanel.classList.add('hidden');
    fileInput.value = '';
    
    downloadLink.classList.remove('btn-glow');
    downloadLink.classList.remove('animate-jump');
  });
</script>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .terminal-cursor {
    color: var(--color-lime);
    animation: blink 1s step-end infinite;
  }
  @keyframes jump {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .animate-jump {
    animation: jump 0.4s ease-out 2;
  }
</style>
