---
interface Props {
  isPassport?: boolean;
}

const { isPassport = false } = Astro.props;

// FAQ Data for JSON-LD
const faqData = [
  {
    q: `Is it safe to upload my personal photo for ${isPassport ? 'passport resizing' : 'pixel resizing'}?`,
    a: `Yes, it is 100% safe. pdfANDimg processes your images locally in your web browser. Your sensitive identity photographs are never uploaded to a remote server, ensuring total privacy and preventing identity theft.`
  },
  {
    q: `Will changing the pixel dimensions reduce the file size?`,
    a: `Usually, yes. Reducing the pixel dimensions (width and height) removes a massive amount of data from the image, which naturally lowers the file size in KB or MB. However, if you are increasing the dimensions (upscaling), the file size will increase.`
  },
  {
    q: `Does this tool meet official government requirements?`,
    a: isPassport 
      ? `Yes! Our Passport Size Photo maker is pre-calibrated for the standard US passport and visa dimensions (600x600 pixels). However, always double-check your specific local government portal's requirements.`
      : `Our Pixel Resizer allows you to set the exact mathematical width and height required by your target platform, ensuring 100% compliance with strict upload portals.`
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqData.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": isPassport ? `pdfANDimg Passport Photo Maker` : `pdfANDimg Exact Pixel Resizer`,
  "url": Astro.url.href,
  "operatingSystem": "WebBrowser",
  "applicationCategory": "UtilitiesApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

// Internal Linking Data (Topic Cluster)
const relatedTools = [
  { name: 'Crop Image', href: '/crop-image' },
  { name: 'Compress to 20KB', href: '/compress-image-to-20kb' },
  { name: 'Compress to 50KB', href: '/compress-image-to-50kb' },
  { name: 'PNG to JPG', href: '/png-to-jpg' },
];
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

<section class="seo-section">
  
  <!-- Divider -->
  <div class="seo-divider"></div>

  <div class="seo-grid">
    
    <!-- Main Content Area -->
    <div class="seo-main">
      
      <!-- Dynamic Heading -->
      <div class="seo-intro">
        <h2 class="seo-h2">
          {isPassport 
            ? "Comprehensive Guide: Creating Official Passport & Visa Photos"
            : "Comprehensive Guide: Resizing Images to Exact Pixel Dimensions"
          }
        </h2>
        
        <p class="seo-p">
          In an increasingly strict digital landscape, uploading photos with incorrect dimensions is the leading cause of application rejection. Whether you are submitting a job application to a corporate portal, uploading a headshot for a government ID card, or preparing assets for a high-performance website, getting the pixel dimensions exactly right is non-negotiable. 
        </p>
        <p class="seo-p">
          Most modern smartphone cameras take incredibly high-resolution photos—often exceeding 4000x3000 pixels. While these look stunning, they are far too large for standard web portals, which usually require specific dimensions like 600x600 pixels or 1080x1080 pixels. Our browser-based resizing engine allows you to mathematically redefine the exact width and height of your image without relying on slow, privacy-invading cloud services.
        </p>
      </div>

      <!-- How it works -->
      <div class="seo-steps">
        <h3 class="seo-h3">Technical Workflow: How the Resizer Engine Works</h3>
        <ol class="seo-list">
          <li>
            <div class="seo-step-num">01</div>
            <div>
              <h4 class="seo-step-title">Zero-Upload Ingestion</h4>
              <p class="seo-p-small">
                Your photograph is instantly read into your device's local memory. We do not upload your sensitive identity photos to any remote server, guaranteeing absolute privacy.
              </p>
            </div>
          </li>
          <li>
            <div class="seo-step-num">02</div>
            <div>
              <h4 class="seo-step-title">Mathematical Scaling</h4>
              <p class="seo-p-small">
                Our algorithm calculates the difference between your original resolution and your target dimensions. It utilizes bicubic interpolation to smoothly downscale or upscale the pixels.
              </p>
            </div>
          </li>
          <li>
            <div class="seo-step-num">03</div>
            <div>
              <h4 class="seo-step-title">Canvas Rendering</h4>
              <p class="seo-p-small">
                The calculated pixels are drawn onto an HTML5 Canvas matching your exact required width and height, effectively cropping and scaling the image in a fraction of a second.
              </p>
            </div>
          </li>
          <li>
            <div class="seo-step-num">04</div>
            <div>
              <h4 class="seo-step-title">Instant Local Export</h4>
              <p class="seo-p-small">
                The canvas is immediately converted back into an optimized JPEG or PNG file. If you are processing multiple photos, they are instantly compiled into a ZIP archive for one-click downloading.
              </p>
            </div>
          </li>
        </ol>
      </div>

      <!-- Detailed Use Cases -->
      <div class="seo-details">
        <h3 class="seo-h3">Why Exact Dimensions Matter</h3>
        <p class="seo-p">
          Automated web portals utilize rigid bounding boxes. If you upload a massive smartphone photo to a government application portal, the system's automated AI will often attempt to crop it randomly, potentially cutting off vital parts of your face or signature. By taking control of the resizing process locally, you ensure that your subject matter remains perfectly centered and visible.
        </p>
        <p class="seo-p">
          {isPassport 
            ? "For official passports, visas, and ID cards, the requirements are heavily standardized. The US Department of State, for example, demands a minimum of 600x600 pixels. Our Passport Maker tool defaults to these exact dimensions, removing the guesswork and ensuring your application avoids the dreaded 'Photo Rejected' delay."
            : "For social media professionals, web developers, and eCommerce managers, maintaining consistent image dimensions is key to a polished visual aesthetic. Our bulk resizer allows you to drag 50 diverse images into the engine and instantly unify them to the exact same width and height."
          }
        </p>
        <p class="seo-p">
          Avoid the security risks of uploading your face and identity to sketchy free-tier websites. With pdfANDimg's client-side processing architecture, you achieve professional-grade results instantly, with the absolute certainty that your data never left your computer.
        </p>
      </div>

      <!-- FAQ Section -->
      <div class="seo-faq">
        <h3 class="seo-h3">Frequently Asked Questions</h3>
        <div class="faq-stack">
          {faqData.map(item => (
            <div class="faq-item">
              <h4 class="faq-q">{item.q}</h4>
              <p class="faq-a">{item.a}</p>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Sidebar / Context -->
    <div class="seo-sidebar">
      <div class="sidebar-box">
        <h3 class="sidebar-title">Optimized Use Cases</h3>
        <ul class="sidebar-list">
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Passports & Visas</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Government ID Cards</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Social Media Profile Pics</span>
          </li>
          <li>
            <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>eCommerce Galleries</span>
          </li>
        </ul>
      </div>

      <div class="sidebar-stats">
        <h3 class="stats-title">Technical Specifications</h3>
        <p class="stats-text"><strong>Algorithm:</strong> Bicubic Canvas Scaling</p>
        <p class="stats-text"><strong>Privacy:</strong> No Server Upload</p>
      </div>

      <!-- Related Tools Cluster -->
      <div class="sidebar-box" style="margin-top: 40px;">
        <h3 class="sidebar-title">Related Tools</h3>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
          {relatedTools.map(tool => (
            <a href={tool.href} class="related-tag">{tool.name}</a>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .seo-section {
    max-width: 1000px;
    margin: 80px auto 0;
    padding: 0 24px;
    text-align: left;
  }

  .seo-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
    margin-bottom: 80px;
  }

  .seo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 80px;
  }

  @media (min-width: 900px) {
    .seo-grid {
      grid-template-columns: 1.8fr 1fr;
    }
  }

  .seo-main {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .seo-h2 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 32px;
    color: var(--color-ink);
    line-height: 1.1;
  }

  .seo-h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 24px;
    color: var(--color-ink);
  }

  .seo-p {
    font-size: 1rem;
    color: var(--color-ink-2);
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .seo-p-small {
    font-size: 0.9375rem;
    color: var(--color-ink-2);
    line-height: 1.6;
  }

  .seo-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .seo-list li {
    display: flex;
    gap: 20px;
  }

  .seo-step-num {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-mid);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-lime);
    font-weight: 700;
  }

  .seo-step-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .faq-stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .faq-q {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 12px;
  }

  .faq-a {
    color: var(--color-ink-2);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .sidebar-box {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 32px;
    margin-bottom: 32px;
  }

  .sidebar-title {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-lime);
    margin-bottom: 24px;
  }

  .sidebar-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }

  .check-icon {
    color: var(--color-lime);
    margin-top: 2px;
  }

  .sidebar-stats {
    padding: 0 32px;
  }

  .stats-title {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-ink-3);
    margin-bottom: 16px;
  }

  .stats-text {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    margin-bottom: 8px;
  }

  .related-tag {
    display: block;
    padding: 8px;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.75rem;
    color: var(--color-ink-2);
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
  }
  .related-tag:hover {
    border-color: var(--color-lime);
    color: var(--color-lime);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .seo-h2 { font-size: 1.75rem; }
    .seo-grid { gap: 48px; }
    .seo-main { gap: 48px; }
  }
</style>
