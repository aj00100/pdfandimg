---
---

<div id="unlock-root" style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
  <div class="panel p-5 md:p-8">
    <div id="unlock-drop-zone" class="drop-zone" style="min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 24px; position: relative; border-radius: 16px;">
      <input type="file" id="unlock-file-input" style="display: none;" accept="application/pdf" />
      
      <div id="unlock-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">Select Locked PDF</p>
          <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin: 0;">Upload a password-protected PDF to unlock it locally</p>
        </div>
        <button onclick="document.getElementById('unlock-file-input').click()" class="btn-ghost" type="button" style="font-size: 0.75rem; z-index: 10;">Browse file</button>
      </div>

      <div id="unlock-preview-container" class="hidden" style="position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; background: var(--color-surface-2); border-radius: 14px; z-index: 5;">
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); text-align: center;">
          <strong id="unlock-filename" style="display: block; margin-bottom: 4px;"></strong>
          <span id="unlock-filesize" style="color: var(--color-ink-2);"></span>
        </div>
        <button id="unlock-change-btn" class="btn-ghost" type="button" style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem; z-index: 10;">Change</button>
      </div>
    </div>

    <!-- Password Input Field (Hidden Initially) -->
    <div id="unlock-password-container" class="hidden" style="margin-bottom: 24px;">
      <label for="unlock-password" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; color: var(--color-ink-3); margin-bottom: 8px;">Document Password</label>
      <input type="password" id="unlock-password" class="input-number" placeholder="Enter password to open the file..." style="width: 100%; height: 56px; font-size: 1rem; padding: 0 16px; background: var(--color-surface-1); border: 2px solid var(--color-border); border-radius: 12px; color: var(--color-ink); outline: none;">
      <p id="unlock-password-error" class="hidden" style="color: #f43f5e; font-size: 0.75rem; margin: 8px 0 0 0;">Incorrect password. Please try again.</p>
    </div>

    <button id="unlock-convert-btn" class="btn-primary" disabled style="width: 100%; height: 56px; font-size: 1rem;" type="button">
      Unlock PDF
    </button>
  </div>

  <div id="unlock-status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px;">
      <div id="unlock-processing" class="hidden" style="flex-direction: column; width: 100%; gap: 16px; padding: 16px 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); text-align: center;" id="unlock-status-text">Loading secure engine...</div>
        <div style="width: 100%; max-width: 500px; margin: 0 auto; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden;">
          <div id="unlock-progress-bar" style="width: 0%; height: 100%; background: currentColor; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div id="unlock-result-view" class="hidden flex-col gap-8 items-center w-full text-center">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">PDF Unlocked!</h2>
        <div style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink-2);" id="unlock-result-details">
          All passwords and restrictions have been securely removed.
        </div>
        
        <a id="unlock-download-link" href="#" class="btn-download" style="width: 100%; max-width: 400px; height: 56px; font-size: 1rem;">
          Download Unlocked PDF
        </a>

        <button id="unlock-reset-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">
          ← Unlock another file
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // We use dynamic import so it doesn't block the main page load
  let qpdfModule: any = null;
  let qpdfInstance: any = null;

  async function loadQPDF() {
    if (!qpdfModule) {
      // Import the ES module from jsDelivr
      const mod = await import('https://cdn.jsdelivr.net/npm/@neslinesli93/qpdf-wasm@0.3.0/dist/qpdf.js');
      qpdfModule = mod.default || mod;
    }
    if (!qpdfInstance) {
      // The default export is usually a factory function in Emscripten
      qpdfInstance = await qpdfModule();
    }
    return qpdfInstance;
  }

  const root = document.getElementById('unlock-root');
  if (root) {
    const dropZone = document.getElementById('unlock-drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('unlock-file-input') as HTMLInputElement;
    const placeholder = document.getElementById('unlock-upload-placeholder') as HTMLDivElement;
    const previewContainer = document.getElementById('unlock-preview-container') as HTMLDivElement;
    const fileNameText = document.getElementById('unlock-filename') as HTMLSpanElement;
    const fileSizeText = document.getElementById('unlock-filesize') as HTMLSpanElement;
    const changeBtn = document.getElementById('unlock-change-btn') as HTMLButtonElement;
    const convertBtn = document.getElementById('unlock-convert-btn') as HTMLButtonElement;
    
    const passwordContainer = document.getElementById('unlock-password-container') as HTMLDivElement;
    const passwordInput = document.getElementById('unlock-password') as HTMLInputElement;
    const passwordError = document.getElementById('unlock-password-error') as HTMLParagraphElement;

    const statusPanel = document.getElementById('unlock-status-panel') as HTMLDivElement;
    const processing = document.getElementById('unlock-processing') as HTMLDivElement;
    const progressBar = document.getElementById('unlock-progress-bar') as HTMLDivElement;
    const statusText = document.getElementById('unlock-status-text') as HTMLDivElement;
    const resultView = document.getElementById('unlock-result-view') as HTMLDivElement;
    const downloadLink = document.getElementById('unlock-download-link') as HTMLAnchorElement;
    const resetBtn = document.getElementById('unlock-reset-btn') as HTMLButtonElement;

    let currentFile: File | null = null;
    let fileBuffer: Uint8Array | null = null;

    dropZone.addEventListener('click', (e) => {
      if (e.target !== changeBtn && e.target !== document.querySelector('#unlock-upload-placeholder button')) {
        fileInput.click();
      }
    });
    
    changeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('active');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('active');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('active');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', (e: any) => {
      if (e.target.files && e.target.files.length > 0) {
        handleFile(e.target.files[0]);
      }
    });

    async function handleFile(file: File) {
      if (!file.name.toLowerCase().endsWith('.pdf')) {
        alert("Please select a PDF file.");
        return;
      }

      currentFile = file;
      fileNameText.textContent = file.name;
      fileSizeText.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB`;
      
      placeholder.classList.add('hidden');
      previewContainer.classList.remove('hidden');
      
      // Reset UI state
      passwordContainer.classList.add('hidden');
      passwordError.classList.add('hidden');
      passwordInput.value = '';
      convertBtn.disabled = false;
      statusPanel.classList.add('hidden');

      // Pre-read the file into memory
      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      statusText.textContent = 'Reading file...';
      progressBar.style.width = '20%';
      convertBtn.disabled = true;

      try {
        const arrayBuffer = await file.arrayBuffer();
        fileBuffer = new Uint8Array(arrayBuffer);
        
        statusText.textContent = 'Loading secure engine...';
        progressBar.style.width = '60%';

        const qpdf = await loadQPDF();
        
        progressBar.style.width = '100%';
        processing.classList.add('hidden');
        convertBtn.disabled = false;

      } catch (err) {
        console.error("Failed to load or read:", err);
        alert("Failed to read the file or load the secure engine.");
        processing.classList.add('hidden');
      }
    }

    async function attemptDecryption(password: string): Promise<{ success: boolean, data?: Uint8Array }> {
      if (!fileBuffer) throw new Error("No file loaded");
      
      const qpdf = await loadQPDF();
      
      const inputName = `input_${Date.now()}.pdf`;
      const outputName = `output_${Date.now()}.pdf`;
      
      try {
        // Write file to virtual FS
        qpdf.FS.writeFile(inputName, fileBuffer);
        
        // Prepare arguments
        const args = [];
        if (password) {
          args.push(`--password=${password}`);
        }
        args.push(inputName);
        args.push('--decrypt');
        args.push(outputName);
        
        // Execute qpdf
        const exitCode = qpdf.callMain(args);
        
        if (exitCode === 0) {
          // Success, read output
          const outputData = qpdf.FS.readFile(outputName);
          return { success: true, data: outputData };
        } else {
          return { success: false };
        }
      } catch (e) {
        // Emscripten might throw on exit(1)
        console.error("QPDF Error:", e);
        return { success: false };
      } finally {
        // Cleanup virtual FS
        try { qpdf.FS.unlink(inputName); } catch (e) {}
        try { qpdf.FS.unlink(outputName); } catch (e) {}
      }
    }

    convertBtn.addEventListener('click', async () => {
      if (!currentFile || !fileBuffer) return;
      
      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      resultView.classList.add('hidden');
      convertBtn.disabled = true;
      passwordError.classList.add('hidden');
      statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      statusText.textContent = 'Decrypting document...';
      progressBar.style.width = '50%';

      const userPass = passwordInput.value;

      try {
        // We first try with the provided password (or empty if not provided)
        const result = await attemptDecryption(userPass);

        if (result.success && result.data) {
          progressBar.style.width = '100%';
          statusText.textContent = 'Unlocked successfully!';

          const blob = new Blob([result.data], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);
          
          downloadLink.href = url;
          const cleanName = currentFile.name.replace('.pdf', '') + '_unlocked.pdf';
          downloadLink.download = cleanName;

          // Hide password field if it was shown
          passwordContainer.classList.add('hidden');

          processing.classList.add('hidden');
          resultView.classList.remove('hidden');
          resultView.style.display = 'flex';
        } else {
          // Decryption failed.
          progressBar.style.width = '100%';
          processing.classList.add('hidden');
          convertBtn.disabled = false;

          // If they didn't provide a password yet, we silently show the input.
          if (!userPass && passwordContainer.classList.contains('hidden')) {
            passwordContainer.classList.remove('hidden');
            passwordInput.focus();
            // Scroll back up to the password input
            passwordContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            // They provided a password and it was wrong, or we already showed the input
            passwordError.classList.remove('hidden');
            passwordContainer.classList.remove('hidden');
            passwordInput.focus();
          }
        }
      } catch (err) {
        console.error(err);
        alert('An unexpected error occurred during decryption.');
        processing.classList.add('hidden');
        convertBtn.disabled = false;
      }
    });

    // Enter key submits password
    passwordInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        convertBtn.click();
      }
    });

    resetBtn.addEventListener('click', () => {
      currentFile = null;
      fileBuffer = null;
      previewContainer.classList.add('hidden');
      placeholder.classList.remove('hidden');
      statusPanel.classList.add('hidden');
      passwordContainer.classList.add('hidden');
      passwordError.classList.add('hidden');
      passwordInput.value = '';
      convertBtn.disabled = true;
      fileInput.value = '';
    });
  }
</script>
