---
const tools = [
  { name: 'Photo to PDF', href: '/photo-pdf-converter', icon: 'zap', color: '#f43f5e' },
  { name: 'Compress Image to 50KB', href: '/compress-image-to-50kb', icon: 'zap', color: 'var(--color-lime)' },
  { name: 'Passport Size Photo', href: '/passport-size-photo', icon: 'zap', color: '#ff7e33' },
  { name: 'Crop Image Online', href: '/crop-image-online', icon: 'zap', color: '#a32cf5' },
];
---

<section style="margin-top: 64px; padding: 40px 0; border-top: 1px solid var(--color-border); background: var(--color-surface-1);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 24px; color: var(--color-ink);">Related Optimizer Tools</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px;">
      {tools.map(tool => (
        <a href={tool.href} class="related-card" style="text-decoration: none; display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 12px; transition: all 0.2s;">
          <div style={`width: 40px; height: 40px; border-radius: 8px; background: ${tool.color}15; display: flex; align-items: center; justify-content: center; color: ${tool.color};`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <span style="font-weight: 600; color: var(--color-ink); font-size: 0.95rem;">{tool.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related-card:hover {
    border-color: var(--color-lime) !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }
</style>
