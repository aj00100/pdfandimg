---
---

<div id="pdf-add-images-root" style="max-width: 860px; margin: 0 auto; padding: 0 24px;">
  <div class="panel p-5 md:p-8">
    <div id="pdf-ai-drop-zone" class="drop-zone" style="min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 24px; position: relative; border-radius: 16px;">
      <input type="file" id="pdf-ai-file-input" style="display: none;" accept="image/jpeg,image/png,image/webp" multiple />
      
      <div id="pdf-ai-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface-3); border: 1px solid var(--color-border-mid); display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-ink); margin: 0 0 4px;">Select Images</p>
          <p style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3); margin: 0;">JPG, PNG, WEBP allowed (Max 50)</p>
        </div>
        <button onclick="document.getElementById('pdf-ai-file-input').click()" class="btn-ghost" type="button" style="font-size: 0.75rem; z-index: 10;">Browse files</button>
      </div>

      <div id="pdf-ai-preview-container" class="hidden" style="position: absolute; inset: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; background: var(--color-surface-2); border-radius: 14px; z-index: 5;">
        <div id="pdf-ai-bulk-text" style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink); max-height: 200px; overflow-y: auto; width: 100%; text-align: left; padding: 16px;"></div>
        <button id="pdf-ai-change-btn" class="btn-ghost" type="button" style="position: absolute; top: 12px; right: 12px; font-size: 0.75rem; z-index: 10;">Change</button>
      </div>
    </div>

    <div style="display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 120px;">
        <label for="pdf-ai-orientation" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; color: var(--color-ink-3); margin-bottom: 8px; text-align: center;">Orientation</label>
        <select id="pdf-ai-orientation" class="input-number" style="width: 100%; height: 56px; font-size: 1rem; text-align: center; background: var(--color-surface-1); border: 2px solid var(--color-border); border-radius: 12px; color: var(--color-ink); outline: none;">
          <option value="portrait" selected>Portrait</option>
          <option value="landscape">Landscape</option>
        </select>
      </div>
      <div style="flex: 1; min-width: 120px;">
        <label for="pdf-ai-margin" style="display: block; font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; color: var(--color-ink-3); margin-bottom: 8px; text-align: center;">Margin</label>
        <select id="pdf-ai-margin" class="input-number" style="width: 100%; height: 56px; font-size: 1rem; text-align: center; background: var(--color-surface-1); border: 2px solid var(--color-border); border-radius: 12px; color: var(--color-ink); outline: none;">
          <option value="0" selected>No Margin</option>
          <option value="10">Small Margin</option>
          <option value="20">Large Margin</option>
        </select>
      </div>
    </div>

    <button id="pdf-ai-convert-btn" class="btn-primary" disabled style="width: 100%; height: 56px; font-size: 1rem;" type="button">
      Create PDF
    </button>
  </div>

  <div id="pdf-ai-status-panel" class="hidden animate-up" style="margin-top: 24px;">
    <div class="panel" style="padding: 24px;">
      <div id="pdf-ai-processing" class="hidden" style="flex-direction: column; width: 100%; gap: 16px; padding: 16px 0;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); text-align: center;" id="pdf-ai-status-text">Processing...</div>
        <div style="width: 100%; max-width: 500px; margin: 0 auto; height: 4px; background: var(--color-surface-3); border-radius: 10px; overflow: hidden;">
          <div id="pdf-ai-progress-bar" style="width: 0%; height: 100%; background: currentColor; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div id="pdf-ai-result-view" class="hidden flex-col gap-8 items-center w-full text-center">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0;">PDF Ready!</h2>
        <a id="pdf-ai-download-link" href="#" class="btn-download" style="width: 100%; max-width: 400px; height: 56px; font-size: 1rem;">
          Download PDF
        </a>
        <button id="pdf-ai-reset-btn" class="btn-ghost" type="button" style="font-size: 0.75rem;">
          ← Make another PDF
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { jsPDF } from 'jspdf';

  const root = document.getElementById('pdf-add-images-root') as HTMLDivElement;
  if (root) {
    const dropZone = document.getElementById('pdf-ai-drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('pdf-ai-file-input') as HTMLInputElement;
    const placeholder = document.getElementById('pdf-ai-upload-placeholder') as HTMLDivElement;
    const previewContainer = document.getElementById('pdf-ai-preview-container') as HTMLDivElement;
    const bulkText = document.getElementById('pdf-ai-bulk-text') as HTMLDivElement;
    const changeBtn = document.getElementById('pdf-ai-change-btn') as HTMLButtonElement;
    const convertBtn = document.getElementById('pdf-ai-convert-btn') as HTMLButtonElement;
    const orientationInput = document.getElementById('pdf-ai-orientation') as HTMLSelectElement;
    const marginInput = document.getElementById('pdf-ai-margin') as HTMLSelectElement;
    
    const statusPanel = document.getElementById('pdf-ai-status-panel') as HTMLDivElement;
    const processing = document.getElementById('pdf-ai-processing') as HTMLDivElement;
    const progressBar = document.getElementById('pdf-ai-progress-bar') as HTMLDivElement;
    const statusText = document.getElementById('pdf-ai-status-text') as HTMLDivElement;
    const resultView = document.getElementById('pdf-ai-result-view') as HTMLDivElement;
    const downloadLink = document.getElementById('pdf-ai-download-link') as HTMLAnchorElement;
    const resetBtn = document.getElementById('pdf-ai-reset-btn') as HTMLButtonElement;

    let selectedFiles: File[] = [];

    dropZone.addEventListener('click', (e) => {
      if (e.target !== changeBtn && e.target !== document.querySelector('#pdf-ai-upload-placeholder button')) {
        fileInput.value = ''; fileInput.click();
      }
    });
    
    changeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.value = ''; fileInput.click();
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('active');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('active');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('active');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) handleFiles(files);
    });

    fileInput.addEventListener('change', (e: any) => {
      const files = e.target.files;
      if (files && files.length > 0) handleFiles(files);
    });

    function handleFiles(filesList: FileList | File[]) {
      const arr = Array.from(filesList);
      selectedFiles = arr.filter(f => f.type.startsWith('image/')).slice(0, 50);
      if (selectedFiles.length === 0) return;

      placeholder.classList.add('hidden');
      previewContainer.classList.remove('hidden');
      convertBtn.disabled = false;

      bulkText.innerHTML = `<strong>${selectedFiles.length} image(s) selected:</strong><br/>` + 
                           selectedFiles.map((f, i) => `${i + 1}. ${f.name}`).join('<br/>');
      
      statusPanel.classList.add('hidden');
    }

    const fileToDataUrl = (file: File): Promise<string> => {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result as string);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    };

    const getImageDimensions = (dataUrl: string): Promise<{w: number, h: number}> => {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve({ w: img.width, h: img.height });
        img.onerror = reject;
        img.src = dataUrl;
      });
    };

    convertBtn.addEventListener('click', async () => {
      if (selectedFiles.length === 0) return;
      
      statusPanel.classList.remove('hidden');
      processing.classList.remove('hidden');
      processing.style.display = 'flex';
      resultView.classList.add('hidden');
      convertBtn.disabled = true;
      statusPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        const orientation = orientationInput.value as 'portrait' | 'landscape';
        const marginStr = marginInput.value;
        const marginPx = parseInt(marginStr); // Not exactly px in jsPDF but we map it
        
        // A4 size in mm
        const a4Width = orientation === 'portrait' ? 210 : 297;
        const a4Height = orientation === 'portrait' ? 297 : 210;
        
        const doc = new jsPDF({
          orientation: orientation === 'portrait' ? 'p' : 'l',
          unit: 'mm',
          format: 'a4'
        });

        for (let i = 0; i < selectedFiles.length; i++) {
          statusText.textContent = `Processing image ${i+1} of ${selectedFiles.length}...`;
          progressBar.style.width = `${Math.round(((i) / selectedFiles.length) * 100)}%`;
          
          const file = selectedFiles[i];
          const dataUrl = await fileToDataUrl(file);
          const dims = await getImageDimensions(dataUrl);
          
          if (i > 0) {
            doc.addPage();
          }

          // Calculate aspect ratio fit
          const targetWidth = a4Width - (marginPx * 2);
          const targetHeight = a4Height - (marginPx * 2);
          
          const imgRatio = dims.w / dims.h;
          const pageRatio = targetWidth / targetHeight;
          
          let renderW = targetWidth;
          let renderH = targetHeight;
          
          if (imgRatio > pageRatio) {
            renderH = targetWidth / imgRatio;
          } else {
            renderW = targetHeight * imgRatio;
          }
          
          const x = marginPx + (targetWidth - renderW) / 2;
          const y = marginPx + (targetHeight - renderH) / 2;
          
          // Basic format detection (jsPDF needs type sometimes)
          const ext = file.type === 'image/png' ? 'PNG' : file.type === 'image/webp' ? 'WEBP' : 'JPEG';
          doc.addImage(dataUrl, ext, x, y, renderW, renderH);
        }

        statusText.textContent = 'Generating PDF...';
        progressBar.style.width = '100%';
        
        const pdfBlob = doc.output('blob');
        const url = URL.createObjectURL(pdfBlob);
        
        downloadLink.href = url;
        downloadLink.download = `merged_images.pdf`;
        
        processing.classList.add('hidden');
        resultView.classList.remove('hidden');
        resultView.style.display = 'flex';
      } catch (err: any) {
        console.error(err);
        alert(err?.message || 'PDF Generation failed.');
        processing.classList.add('hidden');
      } finally {
        convertBtn.disabled = false;
      }
    });

    resetBtn.addEventListener('click', () => {
      selectedFiles = [];
      previewContainer.classList.add('hidden');
      placeholder.classList.remove('hidden');
      statusPanel.classList.add('hidden');
      convertBtn.disabled = true;
      fileInput.value = '';
    });
  }
</script>
